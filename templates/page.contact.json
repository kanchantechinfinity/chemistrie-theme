        "faq_2": {
          "type": "faq",
          "settings": {
            "question": "What does \"pharmacist-formulated\" mean?",
            "answer": "<p>Chemistrie was created by pharmacists who designed the collection around one goal: make a premium skincare ritual easier to understand without sacrificing quality. We evaluate each formula as a whole, including the ingredients, vehicle, compatibility, and how the product fits into the larger ritual.</p>"
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "question": "Are Chemistrie products custom-made for each customer?",
            "answer": "<p>No. Chemistrie products are thoughtfully developed cosmetic formulas, not individually customized prescriptions. The Ritual Finder helps identify which products fit your goals and routine preferences.</p>"
          }
