    "shipping-information": {
      "type": "policy-content",
      "settings": {
        "anchor": "shipping",
        "tone": "cream",
        "title": "Shipping Information",
        "intro": "<p>We carefully prepare every Chemistrie order to ensure your products arrive ready to become part of your ritual.</p>",
        "show_title": false,
        "only_on_handle": "shipping-information",
        "as_page_header": true
      },
      "blocks": {
        "part_1": {
          "type": "part",
          "settings": {
            "heading": "Where We Ship",
            "body": "<p>Chemistrie currently ships within the United States only.</p><p>International shipping is not available at this time.</p>"
          }
        },
        "part_2": {
          "type": "part",
          "settings": {
            "heading": "Processing Time",
            "body": "<p>Orders are typically processed and shipped within 1–2 business days after your order is placed.</p><p>Business days do not include weekends or holidays.</p><p>During periods of unusually high order volume, processing may take longer. If there is a significant delay affecting your order, our team will contact you.</p>"
          }
        },
        "part_3": {
          "type": "part",
          "settings": {
            "heading": "Shipping Rates",
            "body": "<p>All Chemistrie Rituals receive complimentary shipping.</p><p>Shipping charges for individual-product orders are calculated and displayed at checkout before your purchase is completed.</p>"
          }
        },
        "part_4": {
          "type": "part",
          "settings": {
            "heading": "Delivery Time",
            "body": "<p>Estimated delivery times shown at checkout begin after your order has been processed and transferred to the shipping carrier.</p><p>Carrier delivery estimates are provided for convenience but are not guaranteed by Chemistrie. Weather, carrier disruptions, holidays, and other circumstances outside our control may affect delivery.</p>"
          }
        },
        "part_5": {
          "type": "part",
          "settings": {
            "heading": "Order Tracking",
            "body": "<p>Once your order ships, you will receive a shipping confirmation with tracking information so you can follow your package's progress.</p><p>Please allow time for the carrier to update tracking information after your shipping confirmation is received.</p>"
          }
        },
        "part_6": {
          "type": "part",
          "settings": {
            "heading": "Shipping Address",
            "body": "<p>Please review your shipping address carefully before completing your order.</p><p>If you notice an error after placing your order, contact <a href=\"mailto:support@chemistrieco.com\">support@chemistrieco.com</a> as soon as possible.</p><p>Order changes and cancellations may be requested within 24 hours of placing your order. We will make reasonable efforts to accommodate your request, but once an order has entered fulfillment or shipped, we may no longer be able to change the shipping address.</p>"
          }
        },
        "part_7": {
          "type": "part",
          "settings": {
            "heading": "Damaged or Incorrect Orders",
            "body": "<p>If your order arrives damaged or you receive an incorrect item, contact <a href=\"mailto:support@chemistrieco.com\">support@chemistrieco.com</a> within 7 days of delivery.</p><p>Please include your order number, a description of the issue, and photos of the product and packaging when applicable.</p><p>Our team will review the issue and determine the appropriate resolution. If an error is ours, Chemistrie will cover the appropriate costs associated with correcting the order.</p>"
          }
        },
        "part_8": {
          "type": "part",
          "settings": {
            "heading": "Missing Packages",
            "body": "<p>If your tracking information shows that your package has not been delivered within the expected timeframe, contact us and we can help review the shipment.</p><p>If tracking shows your package as delivered but you cannot locate it, please first:</p><ul><li>Check around the delivery location.</li><li>Confirm the shipping address on your order.</li><li>Check with household members or neighbors when appropriate.</li><li>Review any delivery information or photographs provided by the carrier.</li></ul><p>If you still cannot locate your package, contact <a href=\"mailto:support@chemistrieco.com\">support@chemistrieco.com</a> and our team will help determine the appropriate next steps.</p>"
          }
        },
        "part_9": {
          "type": "part",
          "settings": {
            "heading": "Questions About Your Shipment?",
            "body": "<p>For questions about an order or shipment, contact:</p><p><a href=\"mailto:support@chemistrieco.com\">support@chemistrieco.com</a></p>"
          }
        }
      },
      "block_order": [
        "part_1",
