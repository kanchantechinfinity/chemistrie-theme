    "pharmacists-philosophy": {
      "type": "pharmacists-philosophy",
      "blocks": {
        "value_1": {
          "type": "value",
          "settings": {
            "title": "Efficacy before fashion",
            "body": "We choose the active that works at the concentration that works — not the one trending this season. Pharmacy asks a single question: will it do what the label says?"
          }
        },
        "value_2": {
          "type": "value",
          "settings": {
            "title": "Honest to the milligram",
            "body": "Every concentration is printed exactly as compounded. A pharmacist would never round a dose for a patient, so we never round one for you."
          }
        },
        "value_3": {
          "type": "value",
          "settings": {
            "title": "Small batches, always fresh",
            "body": "Actives degrade on a shelf. We compound in runs capped at 200 bottles so nothing you receive has sat waiting — the pharmacist's habit of dispensing fresh, kept intact."
          }
        },
        "value_4": {
          "type": "value",
          "settings": {
            "title": "Formulated for a real face",
            "body": "Each formula began as a request from someone the founders knew. Nothing ships until it earns a place in a ritual they would hand to the people they love."
          }
        }
      },
