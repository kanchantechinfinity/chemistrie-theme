<section class="page-hero" data-screen-label="{{ section.settings.eyebrow | strip }}">
  <div class="page-hero__inner">
    <div class="page-hero__copy">
      <span class="eyebrow eyebrow--light">{{ section.settings.eyebrow }}</span>
      <h1 class="display-h display-h--light page-hero__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.deck != blank -%}
        <p class="page-hero__deck">{{ section.settings.deck }}</p>
      {%- endif -%}
      {%- if section.settings.deck2 != blank -%}
        <p class="page-hero__deck">{{ section.settings.deck2 }}</p>
      {%- endif -%}
      {%- if section.settings.cta_label != blank or section.settings.cta2_label != blank -%}
        <div class="page-hero__cta-row">
          {%- if section.settings.cta_label != blank -%}
            <a href="{{ section.settings.cta_url | default: '#' }}" class="btn btn--primary btn--light">{{ section.settings.cta_label }}</a>
          {%- endif -%}
          {%- if section.settings.cta2_label != blank -%}
            <a href="{{ section.settings.cta2_url | default: '#' }}" class="page-hero__cta-secondary">{{ section.settings.cta2_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_visual -%}
      {%- if section.settings.hero_image != blank -%}
        {%- assign ph_photo_url = section.settings.hero_image | image_url: width: 1200 -%}
      {%- else -%}
        {%- assign ph_photo_url = section.settings.hero_fallback_asset | default: 'hero-visual.jpg' | asset_url -%}
      {%- endif -%}
      <div class="page-hero__visual"
        {%- comment -%} Optional per-page ratio so a wide lineup shot is not side-cropped by the default 16/9.5 frame {%- endcomment -%}
        style="--hero-photo:url('{{ ph_photo_url }}');{% if section.settings.visual_ratio != blank %}aspect-ratio: {{ section.settings.visual_ratio }};{% endif %}"
        aria-hidden="true">
        {%- if section.settings.hero_image != blank -%}
          {%- comment -%} The visual column is ~750 CSS px at the 1440 max-width, so 700 was serving a half-resolution image to every retina screen. {%- endcomment -%}
          {{ section.settings.hero_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '700,1000,1400,1600', alt: '' }}
        {%- else -%}
          {%- comment -%} Temporary Unsplash stock photo, page-specific — replace via this section's "Hero image" setting whenever a real shot is ready {%- endcomment -%}
          <img src="{{ section.settings.hero_fallback_asset | default: 'hero-visual.jpg' | asset_url }}" alt="" loading="lazy">
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.page-hero__inner { display: grid; grid-template-columns: 1fr 1.15fr; align-items: stretch; gap: clamp(32px, 5vw, 80px); }
/* align-self: center, because align-items: stretch above makes this column as
   tall as the photo and block content then starts at its top edge — the copy
   sat high with the leftover space pooled underneath it. */
.page-hero__copy { min-width: 0; align-self: center; }
/* Match the homepage hero's heading size (.hero__title in
   assets/chemistrie.css) instead of the larger base .display-h clamp
   this was inheriting (40-88px). Compound selector (two of the h1's own
   classes) for guaranteed specificity over the shared .display-h rule
   regardless of stylesheet load order — see the .page-section.mprod
   note in sections/main-product.liquid. */
.display-h.page-hero__title { font-size: clamp(36px, 4.6vw, 66px); }
/* Height follows the copy column (align-items: stretch) between a floor and a
   ceiling, instead of a fixed aspect-ratio box. The fixed 16/9.5 frame was
   shorter than the copy on every page, leaving a band of dead space above and
   below the photo, and it side-cropped the 2.07-ratio hero assets. */
.page-hero__visual {
  /* align-self: center matters once max-height caps the stretch — a capped
     grid item start-aligns by default, which would put the gap back, under
     the photo, on the long-copy pages. */
  height: 100%; min-height: var(--hero-visual-min); max-height: var(--hero-visual-max); align-self: center;
  position: relative;
  border-radius: 18px; overflow: hidden;
  border: 1px solid rgba(240,232,219,.22); box-shadow: 0 40px 80px -28px rgba(0,0,0,.55);
  background: var(--c-forest-2);
}
/* The hero shots are around 2.07 wide while this frame is nearer 1.6, so
   cover-fitting them cut roughly a fifth off each side. They're contained
   instead, and the band that leaves is filled with a heavily blurred copy of
   the same shot — the whole photo reads, without flat bars around it. */
.page-hero__visual::before {
  content: ""; position: absolute; inset: 0;
  background-image: var(--hero-photo);
  background-size: cover; background-position: center;
  filter: blur(30px) brightness(.5) saturate(.8);
  transform: scale(1.2);
}
.page-hero__visual img,
.page-hero__visual svg {
  display: block; position: relative; z-index: 1;
  width: 100%; height: 100%; object-fit: contain; object-position: center;
  transition: transform .6s var(--ease-out);
}
.page-hero__visual:hover img { transform: scale(1.03); }
@media (max-width: 760px) {
  .page-hero__inner { grid-template-columns: 1fr; gap: 32px; }
  .page-hero__visual {
    display: block; width: 100%; margin-top: 8px;
    height: auto; aspect-ratio: 16 / 9; min-height: 0; max-height: none;
  }
}
.page-hero__cta-row { display: flex; align-items: center; flex-wrap: wrap; gap: clamp(16px, 2.5vw, 32px); margin-top: clamp(28px, 3.5vw, 40px); }
.page-hero__cta-secondary { font-size: 12.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--c-cream); border-bottom: 1px solid rgba(240,232,219,.4); padding-bottom: 3px; transition: border-color .3s var(--ease-out); }
.page-hero__cta-secondary:hover { border-color: var(--c-cream); }
{% endstylesheet %}

{% schema %}
{
  "name": "Page Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "— The Collection —" },
    { "type": "html", "id": "heading", "label": "Heading (supports <em>/<br>)", "default": "Six formulas.<br/><em>Zero shortcuts.</em>" },
    { "type": "textarea", "id": "deck", "label": "Deck paragraph", "default": "Every Chemistrie formula is compounded by hand in Houston, hand-numbered in batches of 200, and built around a single pharmacist-selected active — never a marketing blend." },
    { "type": "textarea", "id": "deck2", "label": "Deck paragraph 2 (optional)" },
    { "type": "checkbox", "id": "show_visual", "label": "Show hero image", "default": true },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image", "info": "Optional. Shows a temporary stock photo until a real product image is uploaded. Hidden automatically on narrow screens so it never crowds the heading." },
    { "type": "text", "id": "visual_ratio", "label": "Hero image ratio (advanced)", "info": "Optional, narrow screens only. Leave blank — the hero image now matches the height of the text beside it on desktop, so every page's hero is the same size." },
    { "type": "text", "id": "hero_fallback_asset", "label": "Fallback image filename (advanced)", "info": "Internal use — the theme asset filename shown until a real Hero image is uploaded above. Leave as-is unless changing the temporary photo." },
    { "type": "header", "content": "Buttons (optional)" },
    { "type": "text", "id": "cta_label", "label": "Primary button label" },
    { "type": "url", "id": "cta_url", "label": "Primary button link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary link label" },
    { "type": "url", "id": "cta2_url", "label": "Secondary link" }
  ],
  "presets": [{ "name": "Page Hero" }]
}
{% endschema %}
