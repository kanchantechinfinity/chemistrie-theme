<section class="page-hero" data-screen-label="{{ section.settings.eyebrow | strip }}">
  <div class="page-hero__inner">
    <div class="page-hero__copy">
      <span class="eyebrow eyebrow--light">{{ section.settings.eyebrow }}</span>
      <h1 class="display-h display-h--light page-hero__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.deck != blank -%}
        <p class="page-hero__deck">{{ section.settings.deck }}</p>
      {%- endif -%}
      {%- if section.settings.deck2 != blank -%}
        <p class="page-hero__deck">{{ section.settings.deck2 }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.show_visual -%}
      <div class="page-hero__visual" aria-hidden="true">
        {%- if section.settings.hero_image != blank -%}
          {{ section.settings.hero_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350,700', alt: '' }}
        {%- else -%}
          {%- comment -%} Temporary Unsplash stock photo — replace via this section's "Hero image" setting whenever a real product shot is ready {%- endcomment -%}
          <img src="{{ 'hero-visual.jpg' | asset_url }}" alt="" loading="lazy">
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.page-hero__inner { display: grid; grid-template-columns: 1fr 1.15fr; align-items: center; gap: clamp(32px, 5vw, 80px); }
.page-hero__copy { min-width: 0; }
.page-hero__visual {
  aspect-ratio: 4 / 3; border-radius: 16px; overflow: hidden;
  border: 1px solid rgba(240,232,219,.18); box-shadow: 0 40px 80px -28px rgba(0,0,0,.55);
}
.page-hero__visual img,
.page-hero__visual svg { display: block; width: 100%; height: 100%; object-fit: cover; }
@media (max-width: 760px) {
  .page-hero__inner { grid-template-columns: 1fr; }
  .page-hero__visual { display: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Page Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "— The Collection —" },
    { "type": "html", "id": "heading", "label": "Heading (supports <em>/<br>)", "default": "Six formulas.<br/><em>Zero shortcuts.</em>" },
    { "type": "textarea", "id": "deck", "label": "Deck paragraph", "default": "Every Chemistrie formula is compounded by hand in Houston, hand-numbered in batches of 200, and built around a single clinical-grade active — never a marketing blend." },
    { "type": "textarea", "id": "deck2", "label": "Deck paragraph 2 (optional)" },
    { "type": "checkbox", "id": "show_visual", "label": "Show hero image", "default": true },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image", "info": "Optional. Shows a temporary stock photo until a real product image is uploaded. Hidden automatically on narrow screens so it never crowds the heading." }
  ],
  "presets": [{ "name": "Page Hero" }]
}
{% endschema %}
