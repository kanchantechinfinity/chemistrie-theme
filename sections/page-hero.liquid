<section class="page-hero" data-screen-label="{{ section.settings.eyebrow | strip }}">
  <div class="page-hero__inner">
    <div class="page-hero__copy">
      <span class="eyebrow eyebrow--light">{{ section.settings.eyebrow }}</span>
      <h1 class="display-h display-h--light page-hero__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.deck != blank -%}
        <p class="page-hero__deck">{{ section.settings.deck }}</p>
      {%- endif -%}
      {%- if section.settings.deck2 != blank -%}
        <p class="page-hero__deck">{{ section.settings.deck2 }}</p>
      {%- endif -%}
      {%- if section.settings.cta_label != blank or section.settings.cta2_label != blank -%}
        <div class="page-hero__cta-row">
          {%- if section.settings.cta_label != blank -%}
            <a href="{{ section.settings.cta_url | default: '#' }}" class="btn btn--primary btn--light">{{ section.settings.cta_label }}</a>
          {%- endif -%}
          {%- if section.settings.cta2_label != blank -%}
            <a href="{{ section.settings.cta2_url | default: '#' }}" class="page-hero__cta-secondary">{{ section.settings.cta2_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_visual -%}
      <div class="page-hero__visual" aria-hidden="true">
        {%- if section.settings.hero_image != blank -%}
          {{ section.settings.hero_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350,700', alt: '' }}
        {%- else -%}
          {%- comment -%} Temporary Unsplash stock photo, page-specific — replace via this section's "Hero image" setting whenever a real shot is ready {%- endcomment -%}
          <img src="{{ section.settings.hero_fallback_asset | default: 'hero-visual.jpg' | asset_url }}" alt="" loading="lazy">
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
/* Column split shifted toward the image (was 1fr/1.15fr ~46%/54%, now
   ~40%/60%) to make it wider, per request. Text keeps its own measure
   caps (.page-hero__title max-width: 15ch, .page-hero__deck: 56ch) so a
   narrower text column doesn't make lines any harder to read. */
.page-hero__inner { display: grid; grid-template-columns: 0.82fr 1.3fr; align-items: center; gap: clamp(32px, 5vw, 80px); }
.page-hero__copy { min-width: 0; }
.page-hero__visual {
  aspect-ratio: 4 / 3; border-radius: 18px; overflow: hidden;
  border: 1px solid rgba(240,232,219,.22); box-shadow: 0 40px 80px -28px rgba(0,0,0,.55);
  background: var(--c-forest-2);
  padding: clamp(10px, 1.4vw, 20px);
  box-sizing: border-box;
}
/* object-fit: contain rather than cover. This section's hero_fallback_asset
   varies wildly in native ratio across pages — from a 0.75 (portrait) letter
   photo to a 2.08 (very wide) product shot — and cover crops whatever
   doesn't match the box. On the portrait one that meant losing ~55% of the
   image off the sides. contain guarantees the full photo is always visible,
   on every page, regardless of its shape; the forest background (now with
   padding around the image) reads as an intentional frame rather than
   letterboxing. */
.page-hero__visual img,
.page-hero__visual svg { display: block; width: 100%; height: 100%; object-fit: contain; object-position: center; transition: transform .6s var(--ease-out); }
.page-hero__visual:hover img { transform: scale(1.03); }
@media (max-width: 760px) {
  .page-hero__inner { grid-template-columns: 1fr; gap: 32px; }
  .page-hero__visual { display: block; width: 100%; aspect-ratio: 4 / 3; margin-top: 8px; }
}
.page-hero__cta-row { display: flex; align-items: center; flex-wrap: wrap; gap: clamp(16px, 2.5vw, 32px); margin-top: clamp(28px, 3.5vw, 40px); }
.page-hero__cta-secondary { font-size: 12.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--c-cream); border-bottom: 1px solid rgba(240,232,219,.4); padding-bottom: 3px; transition: border-color .3s var(--ease-out); }
.page-hero__cta-secondary:hover { border-color: var(--c-cream); }
{% endstylesheet %}

{% schema %}
{
  "name": "Page Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "— The Collection —" },
    { "type": "html", "id": "heading", "label": "Heading (supports <em>/<br>)", "default": "Six formulas.<br/><em>Zero shortcuts.</em>" },
    { "type": "textarea", "id": "deck", "label": "Deck paragraph", "default": "Every Chemistrie formula is compounded by hand in Houston, hand-numbered in batches of 200, and built around a single pharmacist-selected active — never a marketing blend." },
    { "type": "textarea", "id": "deck2", "label": "Deck paragraph 2 (optional)" },
    { "type": "checkbox", "id": "show_visual", "label": "Show hero image", "default": true },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image", "info": "Optional. Shows a temporary stock photo until a real product image is uploaded. Hidden automatically on narrow screens so it never crowds the heading." },
    { "type": "text", "id": "hero_fallback_asset", "label": "Fallback image filename (advanced)", "info": "Internal use — the theme asset filename shown until a real Hero image is uploaded above. Leave as-is unless changing the temporary photo." },
    { "type": "header", "content": "Buttons (optional)" },
    { "type": "text", "id": "cta_label", "label": "Primary button label" },
    { "type": "url", "id": "cta_url", "label": "Primary button link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary link label" },
    { "type": "url", "id": "cta2_url", "label": "Secondary link" }
  ],
  "presets": [{ "name": "Page Hero" }]
}
{% endschema %}
