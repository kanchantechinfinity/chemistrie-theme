<section class="closing-band">
  <span class="closing-band__mark" aria-hidden="true">✦</span>
  <p class="closing-band__text">{{ section.settings.text }}</p>
</section>

{% stylesheet %}
.closing-band {
  background: var(--c-forest);
  padding: clamp(48px, 6vw, 84px) var(--pad-x);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18px;
}
.closing-band__mark {
  color: var(--c-tan);
  font-size: 15px;
}
.closing-band__text {
  max-width: 620px;
  margin: 0;
  text-align: center;
  color: var(--c-cream);
  font-family: var(--ff-display);
  font-style: italic;
  font-weight: 400;
  font-size: clamp(20px, 2.2vw, 28px);
  line-height: 1.5;
  letter-spacing: .01em;
}
@media (max-width: 640px) {
  .closing-band { padding: clamp(40px, 9vw, 56px) var(--pad-x); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Closing Statement Band",
  "settings": [
    { "type": "textarea", "id": "text", "label": "Statement", "default": "Every formula in this Collection answers to the same two people." }
  ],
  "presets": [{ "name": "Closing Statement Band" }]
}
{% endschema %}
