<!-- ───── Featured products ───── -->
<section class="shop" id="shop" data-screen-label="04 Shop">
  <div class="shop__head">
    <span class="eyebrow">— The Collection —</span>
    <h2 class="display-h">{{ section.settings.heading }}</h2>
    <p class="shop__lede">{{ section.settings.lede }}</p>
  </div>

  <div class="shop__rail-wrap">
    <div class="shop__rail">
      <div class="shop__grid">
      {%- comment -%} Launch products render in ritual order; anything else follows in collection order. {%- endcomment -%}
      {%- liquid
        assign launch_keys = 'velvet,veil,aura,silken,cashmere' | split: ','
        assign ordered = ','
        for key in launch_keys
          for p in section.settings.collection.products
            assign _h = p.handle | downcase
            assign _t = p.title | downcase
            if _h contains key or _t contains key
              assign _needle = p.handle | prepend: ',' | append: ','
              unless ordered contains _needle
                assign ordered = ordered | append: p.handle | append: ','
              endunless
            endif
          endfor
        endfor
        for p in section.settings.collection.products
          assign _needle = p.handle | prepend: ',' | append: ','
          unless ordered contains _needle
            assign ordered = ordered | append: p.handle | append: ','
          endunless
        endfor
        assign ordered = ordered | remove_first: ',' | split: ','
      -%}
      {% for handle in ordered limit: 12 %}
      {%- assign product = all_products[handle] -%}
      {%- if product == blank -%}{%- continue -%}{%- endif -%}
      {%- assign card_name = product.title | split: '—' | first | strip -%}
      {%- capture card_copy -%}{%- render 'product-descriptor', product: product -%}{%- endcapture -%}
      {%- assign card_copy = card_copy | strip -%}
      {%- capture card_asset -%}{%- render 'product-image-asset', product: product -%}{%- endcapture -%}
      {%- assign card_asset = card_asset | strip -%}
      <article class="pcard">
        <button class="wish-btn" type="button" data-wishlist-toggle data-handle="{{ product.handle }}" data-title="{{ product.title | escape }}" data-price="{{ product.price | money }}" data-image="{{ product.featured_image | image_url: width: 200 }}" data-url="{{ product.url }}" aria-label="Save to wishlist">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 20s-7-4.6-7-9.5A3.5 3.5 0 0 1 12 7a3.5 3.5 0 0 1 7 3.5C19 15.4 12 20 12 20Z"/></svg>
        </button>
        <a class="pcard__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
          {%- if card_asset != blank -%}
            <img class="pcard__img" src="{{ card_asset | asset_url }}" alt="{{ card_name | escape }}" loading="lazy">
          {%- elsif product.featured_image -%}
            {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350,700', class: 'pcard__img', alt: product.featured_image.alt | default: product.title }}
            {%- if product.images.size > 1 -%}
              {{ product.images[1] | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350,700', class: 'pcard__img pcard__img--alt', alt: '' }}
            {%- endif -%}
          {%- else -%}
            <img src="{{ 'stock-product.jpg' | asset_url }}" alt="{{ product.title | escape }}" loading="lazy" class="pcard__ph">
          {%- endif -%}
        </a>
        <div class="pcard__body">
          <div class="pcard__row">
            <a class="pcard__name" href="{{ product.url }}">{{ card_name }}</a>
            <span class="pcard__price">{{ product.price | money }}</span>
          </div>
          {%- if card_copy != blank -%}<p class="pcard__copy">{{ card_copy }}</p>{%- endif -%}
          {%- if product.available -%}
            <a class="pcard__btn" href="{{ product.url }}">View {{ card_name }} →</a>
          {%- else -%}
            <span class="pcard__btn pcard__btn--soldout">Sold Out</span>
          {%- endif -%}
        </div>
      </article>
      {% endfor %}
  </div>
    </div>
  </div>

  <div class="shop__foot">
    <a class="btn btn--ghost btn--dark" href="{{ routes.all_products_collection_url }}">
      <span>{{ section.settings.foot_link_label }}</span>
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>
  </div>
</section>

{% stylesheet %}
.shop__rail .pcard {
  flex: 0 0 300px;
  width: 300px;
  scroll-snap-align: start;
  align-self: stretch;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Shop",
  "settings": [
    { "type": "html", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "lede", "label": "Lede" },
    { "type": "text", "id": "foot_link_label", "label": "Footer link label", "default": "Explore the Collection" },
    { "type": "collection", "id": "collection", "label": "Collection" }
  ],
  "presets": [
    { "name": "Shop" }
  ]
}
{% endschema %}
