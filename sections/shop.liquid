<!-- ───── Featured products ───── -->
<section class="shop" id="shop" data-screen-label="04 Shop">
  <div class="shop__head">
    <span class="eyebrow">— The Collection —</span>
    <h2 class="display-h">{{ section.settings.heading }}</h2>
    <p class="shop__lede">{{ section.settings.lede }}</p>
  </div>

  <div class="shop__rail-wrap">
    <div class="shop__rail">
      <div class="shop__grid">
      {%- comment -%} Launch products render in ritual order; anything else follows in collection order. {%- endcomment -%}
      {%- liquid
        assign launch_keys = 'velvet,veil,aura,silken,cashmere' | split: ','
        assign ordered = ','
        for key in launch_keys
          for p in section.settings.collection.products
            assign _h = p.handle | downcase
            assign _t = p.title | downcase
            if _h contains key or _t contains key
              assign _needle = p.handle | prepend: ',' | append: ','
              unless ordered contains _needle
                assign ordered = ordered | append: p.handle | append: ','
              endunless
            endif
          endfor
        endfor
        for p in section.settings.collection.products
          assign _needle = p.handle | prepend: ',' | append: ','
          unless ordered contains _needle
            assign ordered = ordered | append: p.handle | append: ','
          endunless
        endfor
        assign ordered = ordered | remove_first: ',' | split: ','
      -%}
      {% for handle in ordered limit: 12 %}
      {%- assign product = all_products[handle] -%}
      {%- if product == blank -%}{%- continue -%}{%- endif -%}
      {%- assign card_name = product.title | split: '—' | first | strip -%}
      {%- capture card_copy -%}{%- render 'product-descriptor', product: product -%}{%- endcapture -%}
      {%- assign card_copy = card_copy | strip -%}
      {%- capture card_asset -%}{%- render 'product-image-asset', product: product -%}{%- endcapture -%}
      {%- assign card_asset = card_asset | strip -%}
      <article class="product" data-color="forest">
        <a class="product__link" href="{{ product.url }}" aria-label="{{ product.title | escape }}"></a>
        <button class="wish-btn" type="button" data-wishlist-toggle data-handle="{{ product.handle }}" data-title="{{ product.title | escape }}" data-price="{{ product.price | money }}" data-image="{{ product.featured_image | image_url: width: 200 }}" data-url="{{ product.url }}" aria-label="Save to wishlist"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 20s-7-4.6-7-9.5A3.5 3.5 0 0 1 12 7a3.5 3.5 0 0 1 7 3.5C19 15.4 12 20 12 20Z"/></svg></button>
        <div class="product__media">
          {%- if card_asset != blank -%}
            <img class="product__photo" src="{{ card_asset | asset_url }}" alt="{{ card_name | escape }}" loading="lazy">
          {%- elsif product.featured_image -%}
            <img class="product__photo" src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy">
            {%- if product.images.size > 1 -%}
              <img class="product__photo product__photo--alt" src="{{ product.images[1] | image_url: width: 500 }}" alt="" loading="lazy">
            {%- endif -%}
          {%- else -%}
          <svg class="product__bottle" viewBox="0 0 140 220" aria-hidden="true">
            <defs>
              <linearGradient id="g{{ forloop.index }}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2a5a44"/><stop offset="1" stop-color="#1a3a2d"/></linearGradient>
            </defs>
            <rect x="56" y="6" width="28" height="26" rx="2" fill="#c8aa7a"/>
            <rect x="40" y="32" width="60" height="180" rx="6" fill="url(#g{{ forloop.index }})"/>
            <rect x="50" y="100" width="40" height="68" fill="#f9f4ed"/>
            <text x="70" y="124" text-anchor="middle" font-family="Cormorant Garamond" font-style="italic" font-size="10" fill="#1a3a2d">No. 0{{ forloop.index }}</text>
            <line x1="58" y1="130" x2="82" y2="130" stroke="#c8aa7a" stroke-width="0.5"/>
            <text x="70" y="146" text-anchor="middle" font-family="Cormorant Garamond" font-size="8" letter-spacing="2" fill="#1a3a2d">{{ product.title | truncate: 14, '' | upcase }}</text>
          </svg>
          {%- endif -%}
        </div>
        <div class="product__meta">
          <h3>{{ card_name }}</h3>
          {%- if card_copy != blank -%}<p>{{ card_copy }}</p>{%- endif -%}
          <span class="product__price">{{ product.price | money }}</span>
          <a class="product__cta" href="{{ product.url }}">Shop {{ card_name }}</a>
        </div>
      </article>
      {% endfor %}
  </div>
    </div>
  </div>

  <div class="shop__foot">
    <a class="btn btn--ghost btn--dark" href="{{ routes.all_products_collection_url }}">
      <span>{{ section.settings.foot_link_label }}</span>
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>
  </div>
</section>

{% stylesheet %}
.product__link { position: absolute; inset: 0; z-index: 1; }
.product .wish-btn, .product .product__cta { position: relative; z-index: 2; }
.product__photo { width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; border-radius: 12px; transition: transform .6s var(--ease-out), opacity .4s var(--ease-out); }
.product:hover .product__photo { transform: scale(1.04); }
.product__photo--alt { opacity: 0; }
.product:hover .product__photo--alt { opacity: 1; }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop",
  "settings": [
    { "type": "html", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "lede", "label": "Lede" },
    { "type": "text", "id": "foot_link_label", "label": "Footer link label", "default": "Explore the Collection" },
    { "type": "collection", "id": "collection", "label": "Collection" }
  ],
  "presets": [
    { "name": "Shop" }
  ]
}
{% endschema %}
