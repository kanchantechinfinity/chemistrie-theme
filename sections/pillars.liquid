<!-- ───── Pillars — Tabs card ───── -->
<section class="pillars" data-screen-label="03 Pillars">
  <div class="pillars__intro">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 class="display-h">{{ section.settings.intro_heading }}</h2>
    {%- if section.settings.cta_label != blank -%}
      <a class="btn btn--ghost pillars__cta" href="{{ section.settings.cta_link }}">
        <span>{{ section.settings.cta_label }}</span>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    {%- endif -%}
  </div>

  <div class="pillars__tabcard" id="pillarsTabCard">

    <div class="pillars__tablist" role="tablist">
      {%- for block in section.blocks -%}
        <button type="button" class="pillars__tab{% if forloop.first %} is-active{% endif %}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-tab-index="{{ forloop.index0 }}" id="pillarsTab{{ forloop.index0 }}" aria-controls="pillarsPanel{{ forloop.index0 }}">
          <span class="pillars__tab-num">0{{ forloop.index }}</span>
          <span class="pillars__tab-title">{{ block.settings.title }}</span>
        </button>
      {%- endfor -%}
    </div>

    <div class="pillars__panels">
      {% for block in section.blocks %}
      {%- case forloop.index -%}
      {%- when 1 -%}{%- assign pillar_mod = 'pillar--trust' -%}{%- assign crest_mod = '' -%}{%- assign mono_mod = '' -%}
      {%- when 2 -%}{%- assign pillar_mod = 'pillar--luxury' -%}{%- assign crest_mod = ' pillar__crest--alt' -%}{%- assign mono_mod = ' pillar__mono--serif' -%}
      {%- else -%}{%- assign pillar_mod = 'pillar--warmth' -%}{%- assign crest_mod = ' pillar__crest--warm' -%}{%- assign mono_mod = ' pillar__mono--script' -%}
      {%- endcase -%}
      <article class="pillars__panel {{ pillar_mod }}{% if forloop.first %} is-active{% endif %}" data-panel-index="{{ forloop.index0 }}" id="pillarsPanel{{ forloop.index0 }}" role="tabpanel" aria-labelledby="pillarsTab{{ forloop.index0 }}"{{ block.shopify_attributes }}>
        <div class="pillar__body">
          <h3 class="pillar__title">{{ block.settings.title }}</h3>
          <p class="pillar__lede">{{ block.settings.lede }}</p>
          {%- if block.settings.item1 != blank or block.settings.item2 != blank or block.settings.item3 != blank -%}
          <ul class="pillar__list">
            {%- if block.settings.item1 != blank -%}<li>{{ block.settings.item1 }}</li>{%- endif -%}
            {%- if block.settings.item2 != blank -%}<li>{{ block.settings.item2 }}</li>{%- endif -%}
            {%- if block.settings.item3 != blank -%}<li>{{ block.settings.item3 }}</li>{%- endif -%}
          </ul>
          {%- endif -%}
        </div>
        <div class="pillar__visual pillar__visual--full">
          {%- comment -%}
            A photo always uses the full-bleed treatment. The old markup also
            keyed this off the section's "Crest image style" setting, which left
            the photo rendering as a small circle badge whenever that setting
            didn't say "full".
          {%- endcomment -%}
          {%- if block.settings.image != blank or block.settings.image_asset != blank -%}
          <div class="pillar__crest pillar__crest--fullimage{{ crest_mod }}">
            {%- if block.settings.image != blank -%}
              <img class="pillar__crest-img" src="{{ block.settings.image | image_url: width: 1400 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
            {%- else -%}
              <img class="pillar__crest-img" src="{{ block.settings.image_asset | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
            {%- endif -%}
            {%- if block.settings.crest_sub != blank -%}
              <span class="pillar__crest-sub pillar__crest-sub--onimg">{{ block.settings.crest_sub }}</span>
            {%- endif -%}
          </div>
          {%- else -%}
          <div class="pillar__crest{{ crest_mod }}">
            <span class="pillar__mono{{ mono_mod }}">{{ block.settings.crest_mono }}</span>
            <span class="pillar__crest-sub">{{ block.settings.crest_sub }}</span>
          </div>
          {%- endif -%}
        </div>
      </article>
      {% endfor %}
    </div>

  </div>
</section>

{% stylesheet %}
/* Pillar photo sizing lives here, not in chemistrie.css, because that file
   re-declares `.pillar__crest` at the circle badge's fixed 120-140px inside
   several later breakpoints. !important is deliberate — it is the only way to
   win against those without depending on file order. */
.pillar__crest--fullimage { border-radius: 20px !important; }
.pillar__crest--fullimage::before { display: none !important; }

/* ───── Tabs card shell ───── */
.pillars__tabcard {
  max-width: 1320px;
  margin: clamp(32px, 4vw, 56px) auto 0;
  display: flex;
  align-items: stretch;
  border-radius: 28px;
  overflow: hidden;
  border: 1px solid var(--c-line);
  box-shadow: 0 30px 60px -30px rgba(26,58,45,.18);
}

.pillars__tablist {
  flex: 0 0 280px;
  display: flex;
  flex-direction: column;
  background: var(--c-forest);
}
.pillars__tab {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 24px 28px;
  background: none;
  border: 0;
  border-bottom: 1px solid rgba(249,244,237,.1);
  cursor: pointer;
  text-align: left;
  color: rgba(249,244,237,.5);
  transition: background .3s var(--ease-out), color .3s var(--ease-out);
}
.pillars__tab:last-child { border-bottom: 0; }
.pillars__tab:hover { color: var(--c-cream); }
.pillars__tab.is-active { background: rgba(249,244,237,.07); color: var(--c-cream); }
.pillars__tab-num {
  font-family: var(--ff-display);
  font-style: italic;
  font-size: 20px;
  color: var(--c-tan);
  flex: 0 0 auto;
}
.pillars__tab-title {
  font-family: var(--ff-display);
  font-size: 17px;
  line-height: 1.3;
}

.pillars__panels { position: relative; flex: 1; min-width: 0; }
.pillars__panel {
  display: none;
  grid-template-columns: 1fr 320px;
  gap: clamp(28px, 4vw, 60px);
  align-items: stretch;
  padding: clamp(40px, 5vw, 72px);
  min-height: 480px;
}
.pillars__panel.is-active { display: grid; }

@media (max-width: 1024px) {
  .pillars__tabcard { flex-direction: column; }
  .pillars__tablist { flex-direction: row; overflow-x: auto; }
  .pillars__tab { border-bottom: 0; border-right: 1px solid rgba(249,244,237,.1); flex: 1 0 auto; }
  .pillars__tab:last-child { border-right: 0; }
  .pillars__panel { grid-template-columns: 1fr; min-height: 0; }
  .pillar__visual { display: block !important; }
  .pillar__crest--fullimage {
    width: 100% !important;
    max-width: 460px !important;
    height: auto !important;
    aspect-ratio: 4 / 3 !important;
    transform: none !important;
    opacity: 1 !important;
  }
}

@media (max-width: 700px) {
  .pillars__tab { padding: 16px 18px; gap: 10px; }
  .pillars__tab-title { font-size: 14px; }
  .pillars__panel { padding: 28px 22px; }
  .pillar__crest--fullimage { max-width: none !important; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Pillars",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "— Trust Signals —" },
    { "type": "html", "id": "intro_heading", "label": "Intro heading", "default": "Nothing here was<br/><em>rounded up.</em>" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Read the Ingredient Philosophy" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "select", "id": "crest_style", "label": "Crest image style", "options": [ { "value": "circle", "label": "Circle badge" }, { "value": "full", "label": "Full-bleed (no circle)" } ], "default": "circle" }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Pharmacist-Formulated" },
        { "type": "text", "id": "lede", "label": "Lede", "default": "Every formula answers to two pharmacists, by name, not a lab Chemistrie doesn't own." },
        { "type": "text", "id": "item1", "label": "List item 1" },
        { "type": "text", "id": "item2", "label": "List item 2" },
        { "type": "text", "id": "item3", "label": "List item 3" },
        { "type": "text", "id": "crest_mono", "label": "Crest mono", "default": "Rx" },
        { "type": "text", "id": "crest_sub", "label": "Crest sub" },
        { "type": "image_picker", "id": "image", "label": "Crest image (optional — replaces the Rx/mono badge with a photo)" },
        { "type": "text", "id": "image_asset", "label": "Crest image filename (/assets)", "info": "Fallback used only if Crest image above is blank." }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Pillars",
      "blocks": [
        { "type": "pillar", "settings": { "title": "Pharmacist-Formulated", "lede": "Every formula answers to two pharmacists, by name, not a lab Chemistrie doesn't own.", "crest_mono": "Rx" } },
        { "type": "pillar", "settings": { "title": "Pharmacist-Selected Sourcing", "lede": "Ingredients sourced through PCCA's ExoBlue platform, chosen deliberately, never developed in-house and never claimed as Chemistrie's own technology.", "crest_mono": "C." } },
        { "type": "pillar", "settings": { "title": "Appearance-Language, Always", "lede": "Every claim on this site is written to be checked, not simply believed.", "crest_mono": "for her" } }
      ]
    }
  ]
}
{% endschema %}
