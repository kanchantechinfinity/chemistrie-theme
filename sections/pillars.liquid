<!-- ───── Pillars — scroll rail ───── -->
<section class="pillars pillars--rail" data-screen-label="03 Pillars">
  <div class="pillars__intro">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 class="display-h">{{ section.settings.intro_heading }}</h2>
    {%- if section.settings.cta_label != blank -%}
      <a class="btn btn--ghost pillars__cta" href="{{ section.settings.cta_link }}">
        <span>{{ section.settings.cta_label }}</span>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    {%- endif -%}
  </div>

  {%- comment -%}
    Horizontal scroll rail, mirroring the homepage Collection rail
    (.shop__rail): native overflow-x scrolling with snap points, no JS.
    Scroll, trackpad swipe or touch moves the cards continuously.
  {%- endcomment -%}
  <div class="pillars-rail-wrap">
    <div class="pillars-rail" id="pillarsRail" data-autoplay-speed="{{ section.settings.autoplay_speed | default: 5 | times: 1000 }}">
      {%- for block in section.blocks -%}
        <article class="pchain-card" {{ block.shopify_attributes }}>
          <div class="pchain-card__body">
            <div class="pchain-card__content">
              <span class="pillar__num">0{{ forloop.index }}</span>
              <h3 class="pillar__title">{{ block.settings.title }}</h3>
              <p class="pillar__lede">{{ block.settings.lede }}</p>

              {%- if block.settings.item1 != blank or block.settings.item2 != blank or block.settings.item3 != blank -%}
                <ul class="pillar__list">
                  {%- if block.settings.item1 != blank -%}<li>{{ block.settings.item1 }}</li>{%- endif -%}
                  {%- if block.settings.item2 != blank -%}<li>{{ block.settings.item2 }}</li>{%- endif -%}
                  {%- if block.settings.item3 != blank -%}<li>{{ block.settings.item3 }}</li>{%- endif -%}
                </ul>
              {%- endif -%}
            </div>

            <div class="pchain-card__media">
              {%- if block.settings.image != blank -%}
                <img class="pchain-card__img" src="{{ block.settings.image | image_url: width: 1400 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
              {%- elsif block.settings.image_asset != blank -%}
                <img class="pchain-card__img" src="{{ block.settings.image_asset | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
              {%- else -%}
                <div class="pchain-card__placeholder">
                  <span>{{ block.settings.crest_mono | default: "Rx" }}</span>
                </div>
              {%- endif -%}
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
/* ───── Scroll rail shell ─────
   Same mechanics as the homepage Collection rail (.shop__rail): native
   horizontal overflow with snap points and a hidden scrollbar. No JS —
   scroll, trackpad swipe and touch all move it directly. */
.pillars--rail {
  overflow: hidden;
  position: relative;
  padding-top: clamp(36px, 4vw, 56px);
  padding-bottom: clamp(56px, 7vw, 88px) !important;
}
.pillars--rail .pillars__intro {
  margin: 0 0 clamp(20px, 3vw, 32px) !important;
}

.pillars-rail-wrap {
  margin: 0 calc(var(--pad-x) * -1);
  position: relative;
  /* Softens the cards as they run off each edge, same as the Collection rail. */
  mask-image: linear-gradient(90deg, transparent 0, black 2%, black 98%, transparent 100%);
  -webkit-mask-image: linear-gradient(90deg, transparent 0, black 2%, black 98%, transparent 100%);
}
.pillars-rail {
  display: flex;
  gap: clamp(18px, 2vw, 28px);
  padding: 8px var(--pad-x) 28px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-padding-left: var(--pad-x);
  scroll-behavior: smooth;
  scrollbar-width: none;
  -ms-overflow-style: none;
  align-items: stretch;
}
.pillars-rail::-webkit-scrollbar { display: none; }

/* ───── Card ───── */
.pchain-card {
  flex: 0 0 clamp(300px, 78vw, 620px);
  scroll-snap-align: start;
  height: clamp(340px, 42vh, 420px);
  background: var(--c-cream);
  border: 1px solid var(--c-line);
  border-radius: 24px;
  overflow: hidden;
  box-sizing: border-box;
  box-shadow: 0 20px 45px -20px rgba(26,58,45,.10);
  transition: transform .4s var(--ease-out), box-shadow .4s var(--ease-out);
}
.pchain-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 26px 54px -18px rgba(26,58,45,.16);
}
.pchain-card__body {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 100%;
  padding: 24px 24px 24px 32px;
  gap: clamp(20px, 2.4vw, 32px);
  box-sizing: border-box;
}

/* ───── Card content ───── */
.pchain-card__content {
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 8px 0;
  min-width: 0;
}
.pchain-card__content .pillar__num {
  font-family: var(--ff-display);
  font-style: italic;
  font-size: clamp(19px, 1.8vw, 22px);
  color: var(--c-tan);
  letter-spacing: .06em;
  margin-bottom: 8px;
  display: block;
}
.pchain-card__content .pillar__title {
  font-size: clamp(24px, 2.3vw, 34px);
  line-height: 1.1;
  letter-spacing: -.01em;
  margin: 0 0 14px;
}
.pchain-card__content .pillar__lede {
  font-size: clamp(15.5px, 1.3vw, 17.5px);
  line-height: 1.5;
  margin: 0;
  max-width: 42ch;
}
.pchain-card__content .pillar__list { margin-top: 14px; }

/* ───── Card media (exact 2:3, uncropped) ─────
   No dark fill behind the image: the photos are exactly 2:3 like this
   box, but object-fit: contain still letterboxes by a sub-pixel sliver
   on fractional heights, and a dark fill makes that read as a black edge. */
.pchain-card__media {
  flex: 0 0 auto;
  position: relative;
  height: 100%;
  aspect-ratio: 2 / 3;
  border-radius: 18px;
  overflow: hidden;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pchain-card__img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
  border-radius: 18px;
}
.pchain-card__placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, var(--c-forest) 0%, #1e4534 100%);
  color: var(--c-cream);
  font-family: var(--ff-display);
  font-size: 56px;
  border-radius: 18px;
}

/* ───── Responsive ───── */
@media (max-width: 768px) {
  .pchain-card {
    flex-basis: 84vw;
    height: auto;
  }
  .pchain-card__body {
    flex-direction: column;
    align-items: flex-start;
    padding: 22px 20px 26px;
    gap: 20px;
  }
  .pchain-card__media {
    order: -1;
    width: 100%;
    max-width: 240px;
    height: auto;
    align-self: center;
  }
  .pchain-card__content { padding: 0; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Pillars",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "— Trust Signals —" },
    { "type": "html", "id": "intro_heading", "label": "Intro heading", "default": "Nothing here was<br/><em>rounded up.</em>" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Read the Ingredient Philosophy" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "range", "id": "autoplay_speed", "label": "Auto-scroll interval", "min": 0, "max": 10, "step": 1, "unit": "s", "default": 5, "info": "Seconds between automatic slides. Set to 0 to turn auto-scroll off and leave the rail manual-only." }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Pharmacist-Formulated" },
        { "type": "text", "id": "lede", "label": "Lede", "default": "Every formula answers to two pharmacists, by name, not a lab Chemistrie doesn't own." },
        { "type": "text", "id": "item1", "label": "List item 1" },
        { "type": "text", "id": "item2", "label": "List item 2" },
        { "type": "text", "id": "item3", "label": "List item 3" },
        { "type": "text", "id": "crest_mono", "label": "Crest mono", "default": "Rx" },
        { "type": "text", "id": "crest_sub", "label": "Crest sub" },
        { "type": "image_picker", "id": "image", "label": "Story image" },
        { "type": "text", "id": "image_asset", "label": "Story image filename (/assets)", "info": "Fallback used only if Story image above is blank." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Pillars",
      "blocks": [
        { "type": "pillar", "settings": { "title": "Pharmacist-Formulated", "lede": "Every formula answers to two pharmacists, by name, not a lab Chemistrie doesn't own.", "crest_mono": "Rx", "image_asset": "pillar-pharmacist-formulated.png" } },
        { "type": "pillar", "settings": { "title": "Purposefully Formulated", "lede": "Every ingredient earns its place, selected not for the label, but for what it contributes to the formula as a whole.", "crest_mono": "C.", "image_asset": "pillar-purposefully-formulated.png" } },
        { "type": "pillar", "settings": { "title": "Designed to Work Together", "lede": "A focused collection made to layer with intention, so your ritual includes what your skin needs and leaves out what it doesn't.", "crest_mono": "for her", "image_asset": "pillar-designed-together.png" } }
      ]
    }
  ]
}
{% endschema %}
