<!-- ───── Pillars — Testimonial Chain ───── -->
<section class="pillars pillars--chain" data-screen-label="03 Pillars">
  <div class="pillars__intro">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 class="display-h">{{ section.settings.intro_heading }}</h2>
    {%- if section.settings.cta_label != blank -%}
      <a class="btn btn--ghost pillars__cta" href="{{ section.settings.cta_link }}">
        <span>{{ section.settings.cta_label }}</span>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    {%- endif -%}
  </div>

  <div class="pillars-chain" id="pillarsChain" data-autoplay-speed="5000">
    <div class="pillars-chain__stage" id="pillarsChainStage">
      {%- for block in section.blocks -%}
        {%- liquid
          assign img_src = ''
          if block.settings.image != blank
            assign img_src = block.settings.image | image_url: width: 1400
          elsif block.settings.image_asset != blank
            assign img_src = block.settings.image_asset | asset_url
          endif
        -%}
        <article class="pchain-card{% if forloop.first %} is-active{% elsif forloop.index == 2 %} is-next-1{% elsif forloop.last %} is-prev-1{% else %} is-hidden{% endif %}" data-chain-index="{{ forloop.index0 }}"{{ block.shopify_attributes }}>

          <div class="pchain-card__body">
            <div class="pchain-card__content">
              <span class="pchain-card__num">0{{ forloop.index }}</span>
              <h3 class="pchain-card__title">{{ block.settings.title }}</h3>
              {%- if block.settings.lede != blank -%}
                <blockquote class="pchain-card__quote">&ldquo;{{ block.settings.lede }}&rdquo;</blockquote>
              {%- endif -%}

              {%- if block.settings.meta_name != blank and block.settings.meta_role != blank -%}
                <div class="pchain-card__meta">
                  <div class="pchain-card__meta-bar"></div>
                  <div class="pchain-card__meta-text">
                    <span class="pchain-card__meta-name">{{ block.settings.meta_name }}</span>
                    <span class="pchain-card__meta-role">{{ block.settings.meta_role }}</span>
                  </div>
                </div>
              {%- endif -%}
            </div>

            <div class="pchain-card__media">
              {%- if img_src != blank -%}
                <img class="pchain-card__img" src="{{ img_src }}" alt="{{ block.settings.title | escape }}" loading="lazy">
              {%- else -%}
                <div class="pchain-card__placeholder">
                  <span>{{ block.settings.crest_mono | default: "Rx" }}</span>
                </div>
              {%- endif -%}
              {%- if block.settings.crest_mono != blank -%}
                <div class="pchain-card__badge-overlay">
                  <span class="pchain-card__badge-mono">{{ block.settings.crest_mono }}</span>
                </div>
              {%- endif -%}
            </div>
          </div>

          <!-- Flanking pill: cropped image preview only -->
          <div class="pchain-card__pill">
            {%- if img_src != blank -%}
              <img class="pchain-card__pill-img" src="{{ img_src }}" alt="{{ block.settings.title | escape }}" loading="lazy">
            {%- else -%}
              <div class="pchain-card__pill-fallback">
                <span>{{ block.settings.crest_mono | default: "Rx" }}</span>
              </div>
            {%- endif -%}
            <span class="pchain-card__pill-num">0{{ forloop.index }}</span>
          </div>

        </article>
      {%- endfor -%}
    </div>

    <!-- Automated progress indicators -->
    <div class="pillars-chain__controls" aria-label="Trust signal progress">
      <div class="pillars-chain__dots" id="pillarsChainDots" role="tablist">
        {%- for block in section.blocks -%}
          <button type="button" class="pillars-chain__dot{% if forloop.first %} is-active{% endif %}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="Slide {{ forloop.index }}" data-dot-index="{{ forloop.index0 }}">
            <span class="pillars-chain__dot-fill"></span>
          </button>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
/* ───── Testimonial Chain Shell ───── */
.pillars--chain {
  overflow: hidden;
  position: relative;
  padding-top: clamp(36px, 4vw, 56px);
  padding-bottom: clamp(80px, 9vw, 120px) !important;
}
.pillars--chain .pillars__intro {
  margin: 0 0 clamp(20px, 3vw, 32px) !important;
}

.pillars-chain {
  max-width: 1360px;
  margin: 40px auto 0;
  position: relative;
}

.pillars-chain__stage {
  position: relative;
  height: clamp(480px, 58vh, 540px);
  display: flex;
  align-items: center;
  justify-content: center;
  perspective: 1200px;
}

/* ───── Base card ───── */
.pchain-card {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  transition: transform .65s cubic-bezier(.2,.8,.2,1), opacity .55s ease, width .65s cubic-bezier(.2,.8,.2,1), height .65s cubic-bezier(.2,.8,.2,1), box-shadow .55s ease;
  border-radius: 32px;
  overflow: hidden;
  box-sizing: border-box;
}

/* ───── Active center card ───── */
.pchain-card.is-active {
  width: clamp(340px, 66vw, 840px);
  height: 100%;
  transform: translate(-50%, -50%) scale(1);
  opacity: 1;
  z-index: 10;
  background: var(--c-cream);
  border: 1px solid var(--c-line);
  box-shadow: 0 30px 70px -25px rgba(26,58,45,.22), 0 10px 30px -15px rgba(26,58,45,.1);
  pointer-events: auto;
}
.pchain-card.is-active .pchain-card__body {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  width: 100%;
  height: 100%;
  padding: 24px 24px 24px 44px;
  gap: 36px;
  opacity: 1;
  transition: opacity .4s ease .15s;
}
.pchain-card.is-active .pchain-card__pill {
  display: none;
}

/* ───── Flanking cards ("the chain") ───── */
.pchain-card:not(.is-active) {
  cursor: pointer;
  z-index: 4;
  border-radius: 28px;
  border: 2px solid rgba(249,244,237,.9);
  box-shadow: 0 16px 36px -12px rgba(26,58,45,.18);
  background: var(--c-forest);
}
.pchain-card:not(.is-active):hover {
  filter: brightness(1.05);
  box-shadow: 0 20px 42px -10px rgba(26,58,45,.28);
}
.pchain-card:not(.is-active) .pchain-card__body {
  display: none;
}
.pchain-card:not(.is-active) .pchain-card__pill {
  display: block;
  width: 100%;
  height: 100%;
  position: relative;
  overflow: hidden;
}

/* Immediate left/right flank */
.pchain-card.is-prev-1 {
  width: clamp(90px, 10vw, 130px);
  height: clamp(320px, 42vh, 410px);
  transform: translate(calc(-50% - clamp(230px, 38vw, 490px)), -50%) scale(1);
  opacity: 0.95;
  z-index: 6;
}
.pchain-card.is-next-1 {
  width: clamp(90px, 10vw, 130px);
  height: clamp(320px, 42vh, 410px);
  transform: translate(calc(-50% + clamp(230px, 38vw, 490px)), -50%) scale(1);
  opacity: 0.95;
  z-index: 6;
}

/* Far left/right flank (4+ items) */
.pchain-card.is-prev-2 {
  width: clamp(70px, 7vw, 100px);
  height: clamp(260px, 34vh, 330px);
  transform: translate(calc(-50% - clamp(310px, 47vw, 610px)), -50%) scale(0.95);
  opacity: 0.65;
  z-index: 3;
}
.pchain-card.is-next-2 {
  width: clamp(70px, 7vw, 100px);
  height: clamp(260px, 34vh, 330px);
  transform: translate(calc(-50% + clamp(310px, 47vw, 610px)), -50%) scale(0.95);
  opacity: 0.65;
  z-index: 3;
}

.pchain-card.is-hidden {
  transform: translate(-50%, -50%) scale(0.7);
  opacity: 0;
  pointer-events: none;
  z-index: 1;
}

/* ───── Active card content ───── */
.pchain-card__content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 12px 0;
  min-width: 0;
}
.pchain-card__num {
  font-family: var(--ff-display);
  font-style: italic;
  font-size: 18px;
  color: var(--c-tan);
  margin-bottom: 8px;
  letter-spacing: .06em;
  display: block;
}
.pchain-card__title {
  font-family: var(--ff-display);
  font-weight: 400;
  font-size: clamp(24px, 2.4vw, 36px);
  line-height: 1.1;
  letter-spacing: -.01em;
  color: var(--c-forest);
  margin: 0 0 16px;
}
.pchain-card__quote {
  font-family: var(--ff-display);
  font-style: italic;
  font-size: clamp(16px, 1.4vw, 19px);
  line-height: 1.45;
  color: var(--c-ink);
  margin: 0 0 24px;
  padding: 0;
  border: 0;
}

.pchain-card__meta {
  display: flex;
  align-items: stretch;
  gap: 14px;
  margin-top: auto;
}
.pchain-card__meta-bar {
  width: 2px;
  background: var(--c-forest);
  border-radius: 1px;
}
.pchain-card__meta-text {
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.pchain-card__meta-name {
  font-family: var(--ff-display);
  font-size: 15px;
  font-weight: 500;
  color: var(--c-forest);
  letter-spacing: .02em;
}
.pchain-card__meta-role {
  font-size: 12.5px;
  color: var(--c-ink-mute);
  letter-spacing: .02em;
}

/* ───── Active card media ───── */
.pchain-card__media {
  position: relative;
  height: 100%;
  border-radius: 22px;
  overflow: hidden;
  background: var(--c-forest);
}
.pchain-card__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.pchain-card__placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, var(--c-forest) 0%, #1e4534 100%);
  color: var(--c-cream);
  font-family: var(--ff-display);
  font-size: 56px;
}
.pchain-card__badge-overlay {
  position: absolute;
  bottom: 16px;
  right: 16px;
  background: rgba(26,58,45,.82);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  color: var(--c-cream);
  padding: 6px 14px;
  border-radius: 100px;
  border: 1px solid rgba(249,244,237,.25);
}
.pchain-card__badge-mono {
  font-family: var(--ff-display);
  font-size: 13px;
  letter-spacing: .08em;
  text-transform: uppercase;
}

/* ───── Flanking pill image ───── */
.pchain-card__pill-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.pchain-card__pill-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--c-forest);
  color: var(--c-cream);
  font-family: var(--ff-display);
  font-size: 24px;
}
.pchain-card__pill-num {
  position: absolute;
  top: 14px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(26,58,45,.75);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  color: var(--c-cream);
  font-family: var(--ff-display);
  font-size: 11px;
  padding: 2px 8px;
  border-radius: 10px;
  letter-spacing: .05em;
  pointer-events: none;
}

/* ───── Automated progress indicators ───── */
.pillars-chain__controls {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 36px;
}
.pillars-chain__dots {
  display: flex;
  align-items: center;
  gap: 10px;
}
.pillars-chain__dot {
  padding: 0;
  border: 0;
  background: rgba(26,58,45,.2);
  width: 8px;
  height: 8px;
  border-radius: 4px;
  cursor: pointer;
  position: relative;
  overflow: hidden;
  transition: width .35s cubic-bezier(.2,.8,.2,1), background .3s ease;
}
.pillars-chain__dot:hover {
  background: rgba(26,58,45,.4);
}
.pillars-chain__dot.is-active {
  width: 38px;
  background: rgba(26,58,45,.15);
}
.pillars-chain__dot-fill {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  width: 0%;
  background: var(--c-forest);
  border-radius: 4px;
}

/* ───── Responsive ───── */
@media (max-width: 1024px) {
  .pillars-chain__stage { height: 520px; }
  .pchain-card.is-active { width: 84vw; }
  .pchain-card.is-active .pchain-card__body { padding: 20px 20px 20px 28px; gap: 20px; }
  .pchain-card.is-prev-1,
  .pchain-card.is-next-1 { display: none; }
}

@media (max-width: 768px) {
  .pillars-chain__stage { height: auto; min-height: 480px; }
  .pchain-card.is-active {
    width: 100%;
    position: relative;
    top: auto;
    left: auto;
    transform: none;
    height: auto;
    border-radius: 24px;
  }
  .pchain-card.is-active .pchain-card__body {
    grid-template-columns: 1fr;
    padding: 24px 20px;
    gap: 24px;
  }
  .pchain-card__media { height: 280px; order: -1; }
  .pchain-card__title { font-size: 24px; }
  .pchain-card__quote { font-size: 15.5px; margin-bottom: 20px; }
  .pchain-card:not(.is-active) { display: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Pillars",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "— Trust Signals —" },
    { "type": "html", "id": "intro_heading", "label": "Intro heading", "default": "Nothing here was<br/><em>rounded up.</em>" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Read the Ingredient Philosophy" },
    { "type": "url", "id": "cta_link", "label": "CTA link" }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Pharmacist-Formulated" },
        { "type": "text", "id": "lede", "label": "Quote", "default": "Every formula answers to two pharmacists, by name, not a lab Chemistrie doesn't own." },
        { "type": "header", "content": "Byline (optional)" },
        { "type": "paragraph", "content": "Shown as a small credit line under the quote. Leave both fields blank to hide it — not filled in with placeholder text since this copy needs approval." },
        { "type": "text", "id": "meta_name", "label": "Name" },
        { "type": "text", "id": "meta_role", "label": "Role / description" },
        { "type": "text", "id": "crest_mono", "label": "Badge text", "default": "Rx" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_asset", "label": "Image filename (/assets)", "info": "Fallback used only if Image above is blank." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Pillars",
      "blocks": [
        { "type": "pillar", "settings": { "title": "Pharmacist-Formulated", "lede": "Every formula answers to two pharmacists, by name, not a lab Chemistrie doesn't own.", "crest_mono": "Rx", "image_asset": "pillar-pharmacist-formulated.png" } },
        { "type": "pillar", "settings": { "title": "Purposefully Formulated", "lede": "Every ingredient earns its place, selected not for the label, but for what it contributes to the formula as a whole.", "crest_mono": "C.", "image_asset": "pillar-purposefully-formulated.png" } },
        { "type": "pillar", "settings": { "title": "Designed to Work Together", "lede": "A focused collection made to layer with intention, so your ritual includes what your skin needs and leaves out what it doesn't.", "crest_mono": "for her", "image_asset": "pillar-designed-together.png" } }
      ]
    }
  ]
}
{% endschema %}
