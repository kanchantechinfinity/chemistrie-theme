<section class="page-section ritual-steps rsteps rsteps--morning" data-screen-label="The Ritual">
  <div class="page-section__inner">
    <div class="rsteps__head-row">
      <div class="page-section__head rsteps__head">
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 class="display-h">{{ section.settings.heading }}</h2>
        <p class="rsteps__sub">{{ section.settings.sub }}</p>
      </div>
      <div class="rsteps__circle">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 600 | image_tag: width: 240, height: 240, widths: '300,600', alt: section.settings.heading | escape }}
        {%- else -%}
          <img src="{{ 'ritual-cream.jpg' | asset_url }}" alt="{{ section.settings.heading | escape }}" width="240" height="240">
          {%- comment -%} Temporary Unsplash stock photo — replace via Shopify admin {%- endcomment -%}
        {%- endif -%}
      </div>
    </div>

    <div class="rsteps__toggle" role="tablist" aria-label="Ritual time of day">
      <button class="rsteps__pill is-active" type="button" data-ritual-set="morning" aria-pressed="true">Morning</button>
      <button class="rsteps__pill" type="button" data-ritual-set="evening" aria-pressed="false">Evening</button>
    </div>

    {%- assign am_blocks = section.blocks | where: 'type', 'step_am' -%}
    {%- assign pm_blocks = section.blocks | where: 'type', 'step_pm' -%}

    <div class="rsteps__grid" data-period="am">
      {%- for block in am_blocks -%}
        <article class="rstep" {{ block.shopify_attributes }}>
          <span class="rstep__num">{{ block.settings.roman }}</span>
          <h3 class="rstep__title">
            {{ block.settings.step_name }} <span class="rstep__arrow">→</span>
            <span class="rstep__product">{{ block.settings.product_name }}</span>
          </h3>
          <p class="rstep__desc">{{ block.settings.description }}</p>
          {%- if block.settings.product_url != blank -%}
            <a class="rstep__shop" href="{{ block.settings.product_url }}">Shop {{ block.settings.product_name }} →</a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>

    <div class="rsteps__grid" data-period="pm" hidden>
      {%- for block in pm_blocks -%}
        <article class="rstep" {{ block.shopify_attributes }}>
          <span class="rstep__num">{{ block.settings.roman }}</span>
          <h3 class="rstep__title">
            {{ block.settings.step_name }} <span class="rstep__arrow">→</span>
            <span class="rstep__product">{{ block.settings.product_name }}</span>
          </h3>
          <p class="rstep__desc">{{ block.settings.description }}</p>
          {%- if block.settings.product_url != blank -%}
            <a class="rstep__shop" href="{{ block.settings.product_url }}">Shop {{ block.settings.product_name }} →</a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
.ritual-steps { background: var(--c-tan); }
.rsteps__head-row { display: flex; align-items: center; justify-content: space-between; gap: clamp(24px, 4vw, 56px); }
.rsteps__head { flex: 1 1 auto; min-width: 0; margin-bottom: 0; }
.rsteps__circle {
  flex: 0 0 auto;
  width: clamp(160px, 16vw, 240px);
  height: clamp(160px, 16vw, 240px);
  border-radius: 50%;
  overflow: hidden;
  border: 4px solid var(--c-cream);
  box-shadow: 0 20px 44px -18px rgba(26,58,45,.4);
}
.rsteps__circle img { width: 100%; height: 100%; object-fit: cover; display: block; }
.rsteps__sub { margin: 20px 0 0; max-width: 62ch; font-size: 17px; line-height: 1.7; color: rgba(26,58,45,.78); }
.rsteps__toggle {
  display: inline-flex; gap: 4px; padding: 4px; margin: 0 0 clamp(40px, 5vw, 64px);
  background: var(--c-paper, #fff); border: 1px solid var(--c-line-soft, rgba(26,58,45,.18));
  border-radius: 999px;
}
.rsteps__pill {
  padding: 10px 26px; border: 0; border-radius: 999px; cursor: pointer;
  font-size: 12px; letter-spacing: .16em; text-transform: uppercase;
  background: none; color: var(--c-forest); transition: background .3s var(--ease-out), color .3s var(--ease-out);
}
.rsteps__pill.is-active { background: var(--c-forest); color: var(--c-cream); }

/* Step cards — bordered, in a grid */
.rsteps__grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: clamp(14px, 1.6vw, 22px); }
.rsteps__grid[hidden] { display: none; }
.rstep {
  display: flex; flex-direction: column; gap: 10px; padding: clamp(22px, 2.4vw, 28px);
  background: var(--c-cream); border: 1px solid var(--c-line-soft, rgba(26,58,45,.16)); border-radius: 16px;
}
.rstep__num { font-family: var(--ff-display); font-style: italic; font-size: 20px; color: var(--c-tan); }
.rstep__title { font-family: var(--ff-display); font-size: clamp(19px, 1.8vw, 22px); font-weight: 500; color: var(--c-forest); }
.rstep__arrow { color: var(--c-tan); }
.rstep__product { color: var(--c-tan); font-style: italic; }
.rstep__desc { font-size: 16px; line-height: 1.7; color: rgba(26,58,45,.82); }
.rstep__shop { align-self: flex-start; margin-top: 4px; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--c-forest); border-bottom: 1px solid var(--c-tan); padding-bottom: 3px; transition: color .3s; }
.rstep__shop:hover { color: var(--c-tan); }

@media (max-width: 1100px) {
  .rsteps__grid { grid-template-columns: repeat(3, 1fr); }
}
@media (max-width: 900px) {
  .rsteps__grid { grid-template-columns: 1fr 1fr; }
  .rsteps__head-row { flex-direction: column; text-align: center; }
  .rsteps__circle { order: -1; }
}
@media (max-width: 600px) {
  .rsteps__head { margin-bottom: 28px; }
  .rsteps__grid { grid-template-columns: 1fr; }
}
{% endstylesheet %}

{% javascript %}
document.querySelectorAll('.rsteps').forEach(function (section) {
  var pills = section.querySelectorAll('.rsteps__pill');
  var grids = section.querySelectorAll('.rsteps__grid');
  pills.forEach(function (pill) {
    pill.addEventListener('click', function () {
      var set = pill.getAttribute('data-ritual-set');
      section.classList.toggle('rsteps--morning', set === 'morning');
      section.classList.toggle('rsteps--evening', set === 'evening');
      grids.forEach(function (grid) {
        var period = grid.getAttribute('data-period');
        var show = (set === 'morning' && period === 'am') || (set === 'evening' && period === 'pm');
        grid.hidden = !show;
      });
      pills.forEach(function (p) {
        var active = p === pill;
        p.classList.toggle('is-active', active);
        p.setAttribute('aria-pressed', String(active));
      });
    });
  });
});
{% endjavascript %}

{% schema %}
{
  "name": "Ritual Steps",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "— The ritual, step by step —" },
    { "type": "html", "id": "heading", "label": "Heading (supports <em>/<br>)", "default": "Cleanse. Treat.<br/><em>Moisturize. Protect.</em>" },
    { "type": "textarea", "id": "sub", "label": "Subtext", "default": "In that order, every time. Switch between morning and evening to see how each step changes." },
    { "type": "image_picker", "id": "image", "label": "Circle image (optional)" }
  ],
  "blocks": [
    {
      "type": "step_am",
      "name": "Morning step",
