        { "type": "text", "id": "roman", "label": "Number", "default": "1" },
        { "type": "text", "id": "step_name", "label": "Role", "default": "Cleanse" },
        { "type": "text", "id": "product_name", "label": "Product name", "default": "Velvet" },
        { "type": "url", "id": "product_url", "label": "Product URL" },
        { "type": "textarea", "id": "description", "label": "Note", "default": "Step description." }
      ]
    },
    {
      "type": "step_pm",
      "name": "Evening step",
      "settings": [
        { "type": "text", "id": "roman", "label": "Number", "default": "1" },
        { "type": "text", "id": "step_name", "label": "Role", "default": "Cleanse" },
        { "type": "text", "id": "product_name", "label": "Product name", "default": "Velvet" },
        { "type": "url", "id": "product_url", "label": "Product URL" },
        { "type": "textarea", "id": "description", "label": "Note", "default": "Step description." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ritual Steps",
      "blocks": [
        { "type": "step_am", "settings": { "roman": "1", "step_name": "Cleanse", "product_name": "Velvet", "description": "The rich foam that lifts away the night before, so everything that follows can actually absorb." } },
        { "type": "step_am", "settings": { "roman": "2", "step_name": "Treat", "product_name": "Veil", "description": "A featherlight hydrating solution, pressed in right after cleansing and before anything heavier." } },
        { "type": "step_am", "settings": { "roman": "3", "step_name": "Refine", "product_name": "Silken (optional, targeted)", "description": "For anyone using it: apply to targeted areas after Veil, before the moisturizing step." } },
        { "type": "step_am", "settings": { "roman": "4", "step_name": "Moisturize", "product_name": "Cashmere", "description": "Lightweight hydration that disappears before it has the chance to feel like a step at all." } },
        { "type": "step_am", "settings": { "roman": "5", "step_name": "Protect", "product_name": "Your Own SPF", "description": "Any sunscreen, applied last, every single morning without exception. Chemistrie doesn't make this one." } },
        { "type": "step_pm", "settings": { "roman": "1", "step_name": "Cleanse", "product_name": "Velvet", "description": "The same cleanse, undoing a different day." } },
        { "type": "step_pm", "settings": { "roman": "2", "step_name": "Treat", "product_name": "Veil", "description": "The same weightless hydration, pressed in right after cleansing." } },
        { "type": "step_pm", "settings": { "roman": "3", "step_name": "Refine", "product_name": "Silken (optional, targeted)", "description": "Apply to targeted areas after Veil, before the moisturizing step — same placement as morning." } },
        { "type": "step_pm", "settings": { "roman": "4", "step_name": "Moisturize", "product_name": "Cashmere (optional)", "description": "Layered before Aura for anyone who wants additional hydration. Not required, and never a missing step if skipped." } },
        { "type": "step_pm", "settings": { "roman": "5", "step_name": "Renew", "product_name": "Aura", "description": "The one step in the ritual built to ask for two considered minutes, not disappear into thirty seconds." } }
