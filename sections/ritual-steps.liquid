<section class="page-section ritual-steps rsteps rsteps--morning" data-screen-label="The Ritual">
  <div class="page-section__inner">
    <div class="page-section__head rsteps__head">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="display-h">{{ section.settings.heading }}</h2>
      <p class="rsteps__sub">{{ section.settings.sub }}</p>
    </div>

    <div class="rsteps__toggle" role="tablist" aria-label="Ritual time of day">
      <button class="rsteps__pill is-active" type="button" data-ritual-set="morning" aria-pressed="true">Morning</button>
      <button class="rsteps__pill" type="button" data-ritual-set="evening" aria-pressed="false">Evening</button>
    </div>

    {%- assign step_blocks = section.blocks | where: 'type', 'step' -%}

    {%- comment -%} ───── Timeline — step icon, connected by a dashed line ───── {%- endcomment -%}
    <div class="rsteps__timeline" aria-hidden="true">
      {%- for block in step_blocks -%}
        {%- assign icon_idx = forloop.index0 | modulo: 4 -%}
        {%- case icon_idx -%}
          {%- when 0 -%}{%- assign step_icon = 'ingredient-droplet.jpg' -%}
          {%- when 1 -%}{%- assign step_icon = 'ingredient-gold.jpg' -%}
          {%- when 2 -%}{%- assign step_icon = 'ritual-cream.jpg' -%}
          {%- else -%}{%- assign step_icon = 'ingredient-aloe.jpg' -%}
        {%- endcase -%}
        <div class="rsteps__tl-item">
          <span class="rsteps__tl-icon"><img src="{{ step_icon | asset_url }}" alt="" loading="lazy"></span>
          <span class="rsteps__tl-pill">{{ block.settings.step_name }}</span>
        </div>
        {%- unless forloop.last -%}<span class="rsteps__tl-arrow">›</span>{%- endunless -%}
      {%- endfor -%}
    </div>

    <div class="rsteps__grid">
      {%- for block in step_blocks -%}
        <article class="rstep" {{ block.shopify_attributes }}>
          <span class="rstep__num">{{ block.settings.roman }}</span>
          <h3 class="rstep__title">
            {{ block.settings.step_name }} <span class="rstep__arrow">→</span>
            <span class="rstep__product" data-ritual="morning">{{ block.settings.product_name }}</span>
            {%- if block.settings.product_name_pm != blank -%}
              <span class="rstep__product" data-ritual="evening">{{ block.settings.product_name_pm }}</span>
            {%- else -%}
              <span class="rstep__product" data-ritual="evening">{{ block.settings.product_name }}</span>
            {%- endif -%}
          </h3>
          <p class="rstep__desc" data-ritual="morning">{{ block.settings.description }}</p>
          {%- if block.settings.description_pm != blank -%}
            <p class="rstep__desc" data-ritual="evening">{{ block.settings.description_pm }}</p>
          {%- else -%}
            <p class="rstep__desc" data-ritual="evening">{{ block.settings.description }}</p>
          {%- endif -%}
          {%- if block.settings.product_url != blank -%}
            <a class="rstep__shop" href="{{ block.settings.product_url }}">Shop {{ block.settings.product_name }} →</a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
.ritual-steps { background: var(--c-cream); }
.rsteps__sub { margin: 20px 0 0; max-width: 62ch; font-size: 17px; line-height: 1.7; color: rgba(26,58,45,.78); }
.rsteps__toggle {
  display: inline-flex; gap: 4px; padding: 4px; margin: 0 0 clamp(40px, 5vw, 64px);
  background: var(--c-paper, #fff); border: 1px solid var(--c-line-soft, rgba(26,58,45,.18));
  border-radius: 999px;
}
.rsteps__pill {
  padding: 10px 26px; border: 0; border-radius: 999px; cursor: pointer;
  font-size: 12px; letter-spacing: .16em; text-transform: uppercase;
  background: none; color: var(--c-forest); transition: background .3s var(--ease-out), color .3s var(--ease-out);
}
.rsteps__pill.is-active { background: var(--c-forest); color: var(--c-cream); }

/* Timeline — icon + pill per step, connected by a dashed arrowed line */
.rsteps__timeline { display: flex; align-items: flex-start; margin: 0 0 clamp(32px, 4vw, 48px); }
.rsteps__tl-item { display: flex; flex-direction: column; align-items: center; gap: 10px; flex: 0 0 auto; }
.rsteps__tl-icon {
  width: 56px; height: 56px; border-radius: 50%; overflow: hidden;
  border: 3px solid var(--c-cream); box-shadow: 0 8px 20px -8px rgba(26,58,45,.4);
}
.rsteps__tl-icon img { width: 100%; height: 100%; object-fit: cover; display: block; }
.rsteps__tl-pill {
  padding: 6px 16px; border-radius: 999px; background: var(--c-paper);
  font-size: 11.5px; font-weight: 600; color: var(--c-forest); white-space: nowrap;
}
.rsteps__tl-arrow {
  flex: 1 1 auto; align-self: flex-start; margin-top: 26px;
  min-width: 24px; text-align: center; color: var(--c-tan-2); font-size: 18px;
  border-top: 2px dashed var(--c-tan); line-height: 0; padding-top: 2px;
}

/* Step cards — bordered, in a grid instead of a divided list */
.rsteps__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(16px, 2vw, 24px); }
.rstep {
  display: flex; flex-direction: column; gap: 10px; padding: clamp(22px, 2.4vw, 28px);
  background: var(--c-cream); border: 1px solid var(--c-line-soft, rgba(26,58,45,.16)); border-radius: 16px;
}
.rstep__num { font-family: var(--ff-display); font-style: italic; font-size: 20px; color: var(--c-tan); }
.rstep__title { font-family: var(--ff-display); font-size: clamp(19px, 1.8vw, 22px); font-weight: 500; color: var(--c-forest); }
.rstep__arrow { color: var(--c-tan); }
.rstep__product { color: var(--c-tan); font-style: italic; }
.rstep__desc { font-size: 16px; line-height: 1.7; color: rgba(26,58,45,.82); }
.rstep__shop { align-self: flex-start; margin-top: 4px; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--c-forest); border-bottom: 1px solid var(--c-tan); padding-bottom: 3px; transition: color .3s; }
.rstep__shop:hover { color: var(--c-tan); }

/* toggle variants */
.rstep__product[data-ritual="evening"],
.rstep__desc[data-ritual="evening"] { display: none; }
.rsteps--evening .rstep__product[data-ritual="morning"],
.rsteps--evening .rstep__desc[data-ritual="morning"] { display: none; }
.rsteps--evening .rstep__product[data-ritual="evening"] { display: inline; }
.rsteps--evening .rstep__desc[data-ritual="evening"] { display: block; }

@media (max-width: 900px) {
  .rsteps__grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 600px) {
  .rsteps__head { margin-bottom: 28px; }
  .rsteps__grid { grid-template-columns: 1fr; }
  .rsteps__timeline { overflow-x: auto; padding-bottom: 6px; }
  .rsteps__tl-pill { font-size: 10.5px; padding: 5px 12px; }
}
{% endstylesheet %}

{% javascript %}
document.querySelectorAll('.rsteps').forEach(function (section) {
  var pills = section.querySelectorAll('.rsteps__pill');
  pills.forEach(function (pill) {
    pill.addEventListener('click', function () {
      var set = pill.getAttribute('data-ritual-set');
      section.classList.toggle('rsteps--morning', set === 'morning');
      section.classList.toggle('rsteps--evening', set === 'evening');
      pills.forEach(function (p) {
        var active = p === pill;
        p.classList.toggle('is-active', active);
        p.setAttribute('aria-pressed', String(active));
      });
    });
  });
});
{% endjavascript %}

{% schema %}
{
  "name": "Ritual Steps",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "— The ritual, step by step —" },
    { "type": "html", "id": "heading", "label": "Heading (supports <em>/<br>)", "default": "Four steps,<br/><em>morning and night.</em>" },
    { "type": "textarea", "id": "sub", "label": "Subtext", "default": "The Chemistrie ritual was written on a prescription pad, then engraved on a brass card. Slow it down, layer thin, and let the skin ask for the next. Switch between morning and evening to see how each step changes." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "roman", "label": "Roman numeral", "default": "i." },
        { "type": "text", "id": "step_name", "label": "Step name", "default": "Cleanse" },
        { "type": "text", "id": "product_name", "label": "Product name", "default": "Velvet" },
        { "type": "url", "id": "product_url", "label": "Product URL" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Step description." },
        { "type": "text", "id": "product_name_pm", "label": "Evening product name (optional)" },
        { "type": "textarea", "id": "description_pm", "label": "Evening description (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ritual Steps",
      "blocks": [
        { "type": "step", "settings": { "roman": "i.", "step_name": "Cleanse", "product_name": "Velvet", "product_name_pm": "Velvet", "description": "A splash of Velvet on waking — worked into damp skin for thirty seconds, just enough to reset. The face wakes, it does not flinch.", "description_pm": "At night, the same Velvet works longer — ninety seconds, to lift away sunscreen and the day's residue before anything else is applied." } },
        { "type": "step", "settings": { "roman": "ii.", "step_name": "Treat", "product_name": "Lumina", "product_name_pm": "Renewal", "description": "Two drops of Lumina, our vitamin C serum, pressed — never rubbed — over the face. Brightness and antioxidant defence for the hours of daylight ahead.", "description_pm": "Two drops of Renewal, our retinaldehyde serum, pressed in at night. Resurfacing and repair for the hours the skin rebuilds itself." } },
        { "type": "step", "settings": { "roman": "iii.", "step_name": "Hydrate", "product_name": "Cashmere", "product_name_pm": "Cashmere", "description": "One pearl of Cashmere, warmed between the palms and pressed upward along the jaw, cheekbones and brow — sealing hydration before the day.", "description_pm": "A second, slower pass of Cashmere at night, layered a touch heavier to hold moisture through sleep." } },
        { "type": "step", "settings": { "roman": "iv.", "step_name": "Restore", "product_name": "Golden Oil", "product_name_pm": "Peptide Cream", "description": "A single drop of Golden Oil pressed over the cheeks — a soft finish and glow for the morning.", "description_pm": "Reserved for the evening: the Peptide Cream, where the ritual does its quietest, most important work while you sleep." } }
      ]
    }
  ]
}
{% endschema %}
