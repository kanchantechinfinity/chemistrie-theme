<!-- ───── Brand Story — chapters ───── -->
<section class="story" id="our-story" data-screen-label="10 Brand Story">
  {%- comment -%}
    Render the intro only when there's something in it. On the homepage all
    three fields are blank, and an empty .display-h still reserves a full
    line box (plus margins), which left a large dead gap above the first
    chapter.
  {%- endcomment -%}
  {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.lede != blank -%}
    <div class="story__intro">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="display-h">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.lede != blank -%}
        <p class="story__lede">{{ section.settings.lede }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <ol class="story__chapters">

    <li class="story__chapter">
      <div class="story__chapter-meta">
        <span class="story__year">{{ section.settings.chapter_1_year }}</span>
        <span class="story__roman">— I —</span>
      </div>
      <div class="story__chapter-body">
        <h3>{{ section.settings.chapter_1_heading }}</h3>
        <p>{{ section.settings.chapter_1_body }}</p>
      </div>
      {%- if section.settings.chapter_1_image != blank or section.settings.chapter_1_image_asset != blank -%}
      <div class="story__chapter-photo">
        {%- if section.settings.chapter_1_image != blank -%}
          {{ section.settings.chapter_1_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450,900', alt: section.settings.chapter_1_heading | escape }}
        {%- else -%}
          <img src="{{ section.settings.chapter_1_image_asset | asset_url }}" alt="{{ section.settings.chapter_1_heading | escape }}" loading="lazy">
        {%- endif -%}
      </div>
      {%- endif -%}
    </li>

    <li class="story__chapter story__chapter--reverse">
      <div class="story__chapter-meta">
        <span class="story__year">{{ section.settings.chapter_2_year }}</span>
        <span class="story__roman">— II —</span>
      </div>
      <div class="story__chapter-body">
        <h3>{{ section.settings.chapter_2_heading }}</h3>
        <p>{{ section.settings.chapter_2_body }}</p>
      </div>
      {%- if section.settings.chapter_2_image != blank or section.settings.chapter_2_image_asset != blank -%}
      <div class="story__chapter-photo">
        {%- if section.settings.chapter_2_image != blank -%}
          {{ section.settings.chapter_2_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450,900', alt: section.settings.chapter_2_heading | escape }}
        {%- else -%}
          <img src="{{ section.settings.chapter_2_image_asset | asset_url }}" alt="{{ section.settings.chapter_2_heading | escape }}" loading="lazy">
        {%- endif -%}
      </div>
      {%- else -%}
      {%- comment -%} No approved photo supplied yet — a neutral placeholder keeps the timeline's alternating rhythm intact rather than leaving a gap. Replace by setting Chapter II's photo once Chemistrie supplies one. {%- endcomment -%}
      <div class="story__chapter-photo story__chapter-photo--placeholder" aria-hidden="true">
        <span class="story__chapter-photo-mark">II</span>
      </div>
      {%- endif -%}
    </li>

    <li class="story__chapter">
      <div class="story__chapter-meta">
        <span class="story__year">{{ section.settings.chapter_3_year }}</span>
        <span class="story__roman">— III —</span>
      </div>
      <div class="story__chapter-body">
        <h3>{{ section.settings.chapter_3_heading }}</h3>
        <p>{{ section.settings.chapter_3_body }}</p>
      </div>
      {%- if section.settings.chapter_3_image != blank or section.settings.chapter_3_image_asset != blank -%}
      <div class="story__chapter-photo">
        {%- if section.settings.chapter_3_image != blank -%}
          {{ section.settings.chapter_3_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450,900', alt: section.settings.chapter_3_heading | escape }}
        {%- else -%}
          <img src="{{ section.settings.chapter_3_image_asset | asset_url }}" alt="{{ section.settings.chapter_3_heading | escape }}" loading="lazy">
        {%- endif -%}
      </div>
      {%- endif -%}
    </li>

  </ol>
</section>

{% stylesheet %}
/* .story's base padding-top comes from the shared --section-pad-y
   (clamp(80px,12vw,160px)), used site-wide — scoped down here instead.
   Compound id+class selector for guaranteed specificity over the base
   rule regardless of stylesheet load order (same reasoning as the
   .page-section.mprod note in sections/main-product.liquid). */
#our-story.story { padding-top: clamp(36px, 5vw, 72px); padding-bottom: clamp(36px, 5vw, 72px); }

/* Center the brand-story intro header as a single column */
.story .story__intro {
  text-align: center;
  max-width: 72ch;
  margin-left: auto;
  margin-right: auto;
}
.story .story__intro .display-h {
  margin-left: auto;
  margin-right: auto;
}
.story .story__lede {
  max-width: 60ch;
  margin-left: auto;
  margin-right: auto;
  text-align: center;
}

/* Neutral placeholder for a chapter with no approved photo yet — keeps
   the same footprint/shadow as a real .story__chapter-photo so the
   alternating rhythm doesn't break, without faking an image. */
.story__chapter-photo--placeholder {
  background: linear-gradient(155deg, var(--c-tan-3) 0%, var(--c-cream-2) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}
.story__chapter-photo-mark {
  font-family: var(--ff-display);
  font-style: italic;
  font-size: clamp(30px, 3.6vw, 44px);
  color: rgba(26, 58, 45, .18);
  line-height: 1;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Brand Story",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "html", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "lede", "label": "Lede" },

    { "type": "header", "content": "Chapter I — The Meeting" },
    { "type": "text", "id": "chapter_1_year", "label": "Year", "default": "2011" },
    { "type": "text", "id": "chapter_1_heading", "label": "Heading", "default": "The Meeting" },
    { "type": "textarea", "id": "chapter_1_body", "label": "Body", "default": "Zach and Harin met in pharmacy school in 2011. What began as a friendship grew into years spent working in pharmacy, learning to think carefully about formulation, ingredients, and the details that matter." },
    { "type": "image_picker", "id": "chapter_1_image", "label": "Photo (optional)" },
    { "type": "text", "id": "chapter_1_image_asset", "label": "Photo filename (/assets)", "info": "Fallback used only if the photo above is blank.", "default": "founder-1.jpg" },

    { "type": "header", "content": "Chapter II — The Idea" },
    { "type": "text", "id": "chapter_2_year", "label": "Year" },
    { "type": "text", "id": "chapter_2_heading", "label": "Heading", "default": "The Idea" },
    { "type": "textarea", "id": "chapter_2_body", "label": "Body", "default": "Years later, skincare kept finding its way into the conversation. Zach's wife was exploring products while they traveled through Japan. Harin watched his wife piece together a routine from products she found online. The question became simple: why couldn't we make something ourselves?" },
    { "type": "image_picker", "id": "chapter_2_image", "label": "Photo (optional)", "info": "Pending an authentic Japan/travel photo. Left blank until Chemistrie supplies one — do not substitute a stock or AI-generated image." },
    { "type": "text", "id": "chapter_2_image_asset", "label": "Photo filename (/assets)", "info": "Fallback used only if the photo above is blank." },

    { "type": "header", "content": "Chapter III — Chemistrie" },
    { "type": "text", "id": "chapter_3_year", "label": "Year" },
    { "type": "text", "id": "chapter_3_heading", "label": "Heading", "default": "Chemistrie" },
    { "type": "textarea", "id": "chapter_3_body", "label": "Body", "default": "Skincare felt like a natural extension of what they already understood as pharmacists: ingredients, formulation, precision, and the importance of getting the details right. They weren't trying to reinvent skincare. They simply believed they could do it better, creating skincare with the thoughtful formulation and elevated experience they wanted to give the people closest to them." },
    { "type": "image_picker", "id": "chapter_3_image", "label": "Photo (optional)" },
    { "type": "text", "id": "chapter_3_image_asset", "label": "Photo filename (/assets)", "info": "Fallback used only if the photo above is blank.", "default": "pillar-designed-together.png" }
  ],
  "presets": [
    { "name": "Brand Story" }
  ]
}
{% endschema %}
