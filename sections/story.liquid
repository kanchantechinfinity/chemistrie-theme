<!-- ───── Brand Story — chapters ───── -->
<section class="story" id="our-story" data-screen-label="10 Brand Story">
  <div class="story__intro">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 class="display-h">{{ section.settings.heading }}</h2>
    <p class="story__lede">{{ section.settings.lede }}</p>
  </div>

  <ol class="story__chapters">

    <li class="story__chapter">
      <div class="story__chapter-meta">
        <span class="story__year">{{ section.settings.chapter_1_year }}</span>
        <span class="story__roman">— I —</span>
      </div>
      <div class="story__chapter-body">
        <h3>{{ section.settings.chapter_1_heading }}</h3>
        <p>{{ section.settings.chapter_1_body }}</p>
      </div>
      <div class="story__chapter-photo">
        <img src="{{ 'stock-lab.jpg' | asset_url }}" alt="{{ section.settings.chapter_1_heading | escape }}" loading="lazy">
        {%- comment -%} Temporary Unsplash stock photo — replace via Shopify admin {%- endcomment -%}
      </div>
    </li>

    <li class="story__chapter story__chapter--reverse">
      <div class="story__chapter-meta">
        <span class="story__year">{{ section.settings.chapter_2_year }}</span>
        <span class="story__roman">— II —</span>
      </div>
      <div class="story__chapter-body">
        <h3>{{ section.settings.chapter_2_heading }}</h3>
        <p>{{ section.settings.chapter_2_body }}</p>
      </div>
      <div class="story__chapter-photo">
        <img src="{{ 'stock-product.jpg' | asset_url }}" alt="{{ section.settings.chapter_2_heading | escape }}" loading="lazy">
        {%- comment -%} Temporary Unsplash stock photo — replace via Shopify admin {%- endcomment -%}
      </div>
    </li>

  </ol>
</section>

{% stylesheet %}
/* Center the brand-story intro header as a single column */
.story .story__intro {
  text-align: center;
  max-width: 72ch;
  margin-left: auto;
  margin-right: auto;
}
.story .story__intro .display-h {
  margin-left: auto;
  margin-right: auto;
}
.story .story__lede {
  max-width: 60ch;
  margin-left: auto;
  margin-right: auto;
  text-align: center;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Brand Story",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "" },
    { "type": "html", "id": "heading", "label": "Heading", "default": "" },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "" },

    { "type": "header", "content": "Chapter I" },
    { "type": "text", "id": "chapter_1_year", "label": "Year", "default": "2011" },
    { "type": "text", "id": "chapter_1_heading", "label": "Heading", "default": "The Meeting" },
    { "type": "textarea", "id": "chapter_1_body", "label": "Body", "default": "Harin and Zach met in 2011, at the University of Houston College of Pharmacy — not as business partners, and not yet as anything resembling founders, but as two students in the same pharmacy fraternity, Phi Delta Chi." },

    { "type": "header", "content": "Chapter II" },
    { "type": "text", "id": "chapter_2_year", "label": "Year", "default": "" },
    { "type": "text", "id": "chapter_2_heading", "label": "Heading", "default": "The Conversation" },
    { "type": "textarea", "id": "chapter_2_body", "label": "Body", "default": "The two careers came back together when Zach took a position at The Chemist Pharmacy — Harin's pharmacy. Working alongside each other again, they did what old fraternity brothers tend to do: started comparing the decade they'd just spent apart." }
  ],
  "presets": [
    { "name": "Brand Story" }
  ]
}
{% endschema %}
