<section class="page-section ritual-why" data-screen-label="Why This Order">
  <div class="page-section__inner ritual-why__grid">
    <div class="ritual-why__copy">
      <div class="page-section__head">
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 class="display-h">{{ section.settings.heading }}</h2>
      </div>
      <div class="ritual-why__body">{{ section.settings.body }}</div>
    </div>
    <div class="ritual-why__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450,900', alt: section.settings.heading | escape }}
      {%- else -%}
        <img src="{{ 'stock-lab.jpg' | asset_url }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
        {%- comment -%} Temporary Unsplash stock photo — replace via Shopify admin {%- endcomment -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.ritual-why { background: var(--c-cream); padding-bottom: clamp(40px, 5vw, 64px); }
.ritual-why__grid {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: clamp(32px, 5vw, 72px);
  align-items: center;
}
.ritual-why__body {
  max-width: 60ch;
  font-size: 17px;
  line-height: 1.8;
  color: var(--c-ink-soft);
}
.ritual-why__body p { margin: 0 0 16px; }
.ritual-why__body p:last-child { margin-bottom: 0; }
.ritual-why__media { border-radius: 18px; overflow: hidden; aspect-ratio: 4 / 5; box-shadow: 0 30px 60px -28px rgba(26,58,45,.35); }
.ritual-why__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
@media (max-width: 800px) {
  .ritual-why__grid { grid-template-columns: 1fr; }
  .ritual-why__media { order: -1; max-width: 100%; height: 260px; aspect-ratio: auto; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Ritual — Why This Order",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "— Why This Order —" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why This Order" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "image_picker", "id": "image", "label": "Image (optional)" }
  ],
  "presets": [
    { "name": "Ritual — Why This Order" }
  ]
}
{% endschema %}
