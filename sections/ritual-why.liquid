<section class="page-section ritual-why" data-screen-label="Why This Order">
  <div class="page-section__inner">
    <div class="ritual-why__card">
      <div class="ritual-why__copy">
        <div class="page-section__head ritual-why__head">
          <span class="eyebrow eyebrow--light">{{ section.settings.eyebrow }}</span>
          <h2 class="display-h display-h--light">{{ section.settings.heading }}</h2>
        </div>
        <div class="ritual-why__body">{{ section.settings.body }}</div>
      </div>
      <div class="ritual-why__circle">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,600', alt: section.settings.heading | escape }}
        {%- else -%}
          <img src="{{ 'ritual-cream.jpg' | asset_url }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
          {%- comment -%} Temporary Unsplash stock photo — replace via Shopify admin {%- endcomment -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.ritual-why { background: var(--c-cream); padding-bottom: clamp(40px, 5vw, 64px); }
.ritual-why__card {
  width: 100%;
  background: #1A3A2D;
  border-radius: 20px;
  padding: clamp(40px, 5vw, 72px);
  box-shadow: 0 30px 60px -28px rgba(26,58,45,.4);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: clamp(24px, 4vw, 56px);
}
.ritual-why__copy { flex: 1 1 auto; min-width: 0; }
.ritual-why__head { margin-bottom: 24px; max-width: none; }
.ritual-why__body {
  max-width: 74ch;
  font-size: 17px;
  line-height: 1.8;
  color: rgba(249,244,237,.82);
}
.ritual-why__body p { margin: 0 0 16px; }
.ritual-why__body p:last-child { margin-bottom: 0; }
.ritual-why__circle {
  flex: 0 0 auto;
  width: clamp(160px, 18vw, 240px);
  height: clamp(160px, 18vw, 240px);
  border-radius: 50%;
  overflow: hidden;
  border: 4px solid var(--c-cream);
  box-shadow: 0 20px 44px -18px rgba(0,0,0,.5);
}
.ritual-why__circle img { width: 100%; height: 100%; object-fit: cover; display: block; }
@media (max-width: 760px) {
  .ritual-why__card { flex-direction: column; text-align: center; }
  .ritual-why__head { text-align: center; }
  .ritual-why__body { margin-left: auto; margin-right: auto; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Ritual — Why This Order",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "— Why This Order —" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why This Order" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "image_picker", "id": "image", "label": "Circle image (optional)" }
  ],
  "presets": [
    { "name": "Ritual — Why This Order" }
  ]
}
{% endschema %}
