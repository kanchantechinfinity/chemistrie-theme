<section class="page-section ritual-philosophy" data-screen-label="The Philosophy">
  <div class="page-section__inner ritual-philosophy__inner">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <p class="ritual-philosophy__statement">{{ section.settings.statement }}</p>
    <p class="ritual-philosophy__body">{{ section.settings.body }}</p>
  </div>
</section>

{% stylesheet %}
.ritual-philosophy { background: var(--c-cream); text-align: center; }
.ritual-philosophy__inner { max-width: 780px; display: flex; flex-direction: column; align-items: center; }
.ritual-philosophy__statement {
  font-family: var(--ff-display);
  font-style: italic;
  font-weight: 400;
  font-size: clamp(28px, 4vw, 44px);
  line-height: 1.25;
  color: var(--c-forest);
  margin: 16px 0 0;
}
.ritual-philosophy__body {
  font-size: 17px;
  line-height: 1.8;
  color: var(--c-ink-soft);
  margin: 20px 0 0;
  max-width: 64ch;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Ritual — The Philosophy",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "— The Philosophy —" },
    { "type": "text", "id": "statement", "label": "Statement", "default": "Built to layer, not to compete with itself." },
    { "type": "textarea", "id": "body", "label": "Body" }
  ],
  "presets": [
    { "name": "Ritual — The Philosophy" }
  ]
}
{% endschema %}
