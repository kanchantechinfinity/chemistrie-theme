<section class="page-section ritual-faq" data-screen-label="Ritual FAQ">
  <div class="page-section__inner">
    <div class="page-section__head ritual-faq__head">
      <h2 class="display-h">{{ section.settings.heading }}</h2>
    </div>

    <div class="faq-list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq' -%}
        <div class="faq-item" {{ block.shopify_attributes }}>
          <button class="faq-item__q" type="button" aria-expanded="false">
            <span>{{ block.settings.question }}</span>
            <span class="faq-item__plus" aria-hidden="true">+</span>
          </button>
          <div class="faq-item__a">
            <div class="faq-item__a-inner">{{ block.settings.answer }}</div>
          </div>
        </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
.ritual-faq { background: var(--c-sage-3); padding: clamp(28px, 3.5vw, 44px) var(--pad-x); }
.ritual-faq .faq-item { background: var(--c-cream); }
.ritual-faq__head { text-align: center; max-width: none; margin-left: auto; margin-right: auto; }
.ritual-faq__head .display-h { margin-left: auto; margin-right: auto; }
.ritual-faq .faq-list { max-width: 760px; margin: 0 auto; }
{% endstylesheet %}

{% javascript %}
document.querySelectorAll('.faq-item__q').forEach(function (btn) {
  btn.addEventListener('click', function () {
    var expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    var panel = btn.nextElementSibling;
    if (panel && panel.classList.contains('faq-item__a')) {
      panel.classList.toggle('is-open', !expanded);
    }
  });
});
{% endjavascript %}

{% schema %}
{
  "name": "Ritual FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "FAQ" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ritual FAQ"
    }
  ]
}
{% endschema %}
