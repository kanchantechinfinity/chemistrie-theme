<!-- ───── Founders' Circle — email capture CTA ───── -->
{%- liquid
  assign privacy_url = shop.privacy_policy.url
-%}
<section class="cta cta--circle" data-screen-label="12 Founders' Circle">
  <div class="cta__card circle__card">
    <span class="cta__corner cta__corner--tl"></span>
    <span class="cta__corner cta__corner--tr"></span>
    <span class="cta__corner cta__corner--bl"></span>
    <span class="cta__corner cta__corner--br"></span>

    <div class="circle__grid">
      <div class="circle__copy">
        <span class="eyebrow eyebrow--light">{{ section.settings.eyebrow }}</span>
        <h2 class="display-h display-h--light">{{ section.settings.heading }}</h2>
        <p class="cta__sub">{{ section.settings.sub }}</p>
      </div>

      <div class="circle__panel">
        {% form 'customer', id: 'founders-circle-form', class: 'circle__form' %}
          <input type="hidden" name="contact[tags]" value="founders-circle">

          {% if form.errors and form.errors.size > 0 %}
            <p class="cta__error" role="alert">{{ form.errors.messages['email'] | default: 'Please enter a valid email address.' }}</p>
          {% endif %}

          <label class="circle__field" for="founders-circle-email">
            <span class="visually-hidden">Your email</span>
            <input id="founders-circle-email" type="email" name="contact[email]" placeholder="Your email address" required maxlength="100" title="Please enter a valid email address." />
          </label>
          <button class="btn btn--primary btn--light circle__submit" type="submit">
            <span>{{ section.settings.cta_label }}</span>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
          <p class="cta__sent"{% if form.posted_successfully? %} style="opacity:1;"{% endif %}>{{ section.settings.success_message }}</p>

          {%- if section.settings.consent_text != blank -%}
            <p class="cta__consent">
              {{ section.settings.consent_text }}
              {%- if privacy_url != blank -%} <a href="{{ privacy_url }}">Privacy Policy</a>.{%- endif -%}
            </p>
          {%- endif -%}
        {% endform %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
/* Split layout: copy on the left, a compact stacked form panel on the
   right, replacing the old everything-centered-and-stacked card. The
   base .cta__card is text-align:center for the single-column CTAs
   (page-cta etc.) that still use it elsewhere, so alignment is reset
   inside .circle__card rather than touched on the shared class. */
.circle__card { text-align: left; }
.circle__grid {
  position: relative;
  display: grid;
  grid-template-columns: 1.15fr 1fr;
  align-items: center;
  gap: clamp(40px, 6vw, 88px);
}

.circle__copy { min-width: 0; }
.circle__copy .cta__sub { margin-left: 0; margin-right: 0; }

.circle__panel { min-width: 0; }

.circle__form {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 14px;
  width: 100%;
  max-width: 360px;
}

.circle__field {
  display: block;
  padding: 0 18px;
  border: 1px solid rgba(249,244,237,.22);
  border-radius: 12px;
  background: rgba(249,244,237,.05);
  transition: border-color .3s var(--ease-out), background .3s var(--ease-out);
}
.circle__field:focus-within {
  border-color: var(--c-tan);
  background: rgba(249,244,237,.08);
}
.circle__field input {
  width: 100%;
  background: none;
  border: 0;
  outline: none;
  padding: 15px 0;
  color: var(--c-cream);
  font-family: var(--ff-body);
  font-size: 16px;
}
.circle__field input::placeholder { color: rgba(249,244,237,.45); }

.circle__submit { width: 100%; justify-content: center; }

.cta--circle .cta__sent {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  margin: 0;
  padding: 0 20px;
  border-radius: 14px;
  background: var(--c-forest);
  font-family: var(--ff-display);
  font-style: italic;
  font-size: clamp(15px, 1.6vw, 18px);
  color: var(--c-tan);
  text-align: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity .35s ease;
}

.cta--circle .cta__error {
  margin: 0;
  font-size: 14px;
  color: #f0b4ac;
}

.cta--circle .cta__consent {
  margin: 0;
  max-width: none;
  text-align: left;
  font-size: 12.5px;
  line-height: 1.65;
  color: rgba(249,244,237,.55);
}
.cta--circle .cta__consent a { color: rgba(249,244,237,.8); text-decoration: underline; text-underline-offset: 2px; }
.cta--circle .cta__consent a:hover { color: var(--c-cream); }

@media (max-width: 860px) {
  .circle__card { text-align: center; }
  .circle__grid { grid-template-columns: 1fr; gap: 36px; }
  .circle__copy .cta__sub { margin: 28px auto 0; }
  .circle__panel { display: flex; justify-content: center; }
  .circle__form { max-width: 420px; }
  .cta--circle .cta__consent { text-align: center; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Founders' Circle CTA",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE FOUNDERS' CIRCLE" },
    { "type": "html", "id": "heading", "label": "Heading", "default": "Come closer." },
    { "type": "textarea", "id": "sub", "label": "Body", "default": "Join the Founders' Circle for early access to new formulas, first looks behind the brand, and the occasional note from the pharmacists behind Chemistrie." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "JOIN THE CIRCLE" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Welcome to the Circle. Watch your inbox for what's next." },
    { "type": "textarea", "id": "consent_text", "label": "Consent / privacy line", "info": "The store's Privacy Policy link is appended automatically when one is set in Settings > Policies.", "default": "By joining, you agree to receive marketing emails from Chemistrie. Unsubscribe anytime. See our" }
  ],
  "presets": [
    { "name": "Founders' Circle CTA" }
  ]
}
{% endschema %}
