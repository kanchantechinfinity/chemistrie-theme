{%- comment -%}
  A policy / information block: intro on the left, titled parts on the right.
  Used on /pages/shipping-information and /pages/refund-and-exchange-policy,
  one document each; the page hero carries the title, so show_title is off
  there. Self-contained for the same reason as faq-groups.
{%- endcomment -%}
{%- comment -%}
  only_on_handle: when set, the section renders only on the page with that
  handle. That lets it live in the default page template and show the right
  document on /pages/<handle> without anyone having to pick a theme template
  for the page in admin.
{%- endcomment -%}
{%- assign only_on = section.settings.only_on_handle | strip -%}
{%- if only_on == blank or only_on == page.handle -%}
{%- assign meta = section.settings.meta | strip -%}
{%- comment -%}
  as_page_header: the block draws the page's own hero - title on the left,
  the "last updated" line and the introduction on the right - and the parts
  below run the full width of the page from the left edge. The default page
  hero is switched off for these handles (main-page's hide_header_on).
{%- endcomment -%}
{%- if section.settings.as_page_header -%}
<section class="page-hero pol-hero" data-screen-label="{{ page.title | default: section.settings.title | strip }}">
  <div class="page-hero__inner pol-hero__inner">
    <div class="pol-hero__main">
      <span class="eyebrow eyebrow--light">&mdash; Chemistrie &mdash;</span>
      <h1 class="display-h display-h--light page-hero__title">{{ page.title | default: section.settings.title }}</h1>
    </div>
    <div class="pol-hero__aside">
      {%- if meta != blank -%}<p class="pol__meta">{{ meta }}</p>{%- endif -%}
      <div class="pol__intro">{{ section.settings.intro }}</div>
    </div>
  </div>
</section>
{%- endif -%}
<section class="pol pol--{{ section.settings.tone }}{% if section.settings.as_page_header %} pol--wide{% endif %}" id="{{ section.settings.anchor | default: 'policy' }}" data-screen-label="{{ section.settings.title | escape }}">
  <div class="pol__inner">
    {%- unless section.settings.as_page_header -%}
    <header class="pol__head">
      {%- if section.settings.show_title -%}<h2 class="pol__title">{{ section.settings.title }}</h2>{%- endif -%}
      {%- if meta != blank -%}<p class="pol__meta">{{ meta }}</p>{%- endif -%}
      <div class="pol__intro">{{ section.settings.intro }}</div>
    </header>
    {%- endunless -%}
    <div class="pol__body">
      {%- for block in section.blocks -%}
        <div class="pol__part" {{ block.shopify_attributes }}>
          <h3 class="pol__h">{{ block.settings.heading }}</h3>
          <div class="pol__text">{{ block.settings.body }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% stylesheet %}
.pol { padding: clamp(36px, 5vw, 72px) var(--pad-x); scroll-margin-top: clamp(84px, 11vh, 120px); }
.pol--cream { background: var(--c-cream); }
.pol--paper { background: var(--c-paper); }
.pol__inner { max-width: var(--maxw); margin: 0 auto; display: grid; grid-template-columns: minmax(220px, 340px) 1fr; gap: clamp(28px, 6vw, 96px); align-items: start; }
.pol__head { position: sticky; top: clamp(90px, 12vh, 130px); }
.pol__title { font-family: var(--ff-display); font-weight: 400; font-size: clamp(30px, 3.6vw, 48px); line-height: 1.05; color: var(--c-forest); margin: 0 0 10px; }
.pol__meta { font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--c-tan-2); margin: 0 0 16px; }
.pol__intro { font-family: var(--ff-display); font-style: italic; font-size: clamp(17px, 1.6vw, 20px); line-height: 1.5; color: var(--c-ink-soft); }
.pol__intro p { margin: 0 0 12px; }
.pol__part { padding: clamp(18px, 2.4vw, 28px) 0; border-top: 1px solid var(--c-line); }
.pol__part:first-child { border-top: 0; padding-top: 0; }
.pol__h { font-family: var(--ff-display); font-weight: 500; font-size: clamp(20px, 2vw, 25px); line-height: 1.2; color: var(--c-forest); margin: 0 0 10px; }
.pol__text { font-size: 15.5px; line-height: 1.75; color: var(--c-ink-soft); }
.pol__text p { margin: 0 0 12px; }
.pol__text p:last-child, .pol__text ul:last-child { margin-bottom: 0; }
.pol__text ul { margin: 0 0 12px; padding-left: 20px; }
.pol__text li { margin: 0 0 6px; }
.pol__text a { color: var(--c-forest); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--c-tan); }
/* page-header mode: hero with the introduction on the right, parts full width */
.page-hero__inner.pol-hero__inner {
  display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 500px);
  gap: clamp(24px, 5vw, 80px); align-items: end;
}
.pol-hero__aside { text-align: right; }
.pol-hero__aside .pol__meta { color: var(--c-tan); margin-bottom: 12px; }
.pol-hero__aside .pol__intro { color: rgba(240, 232, 219, .78); }
.pol-hero__aside .pol__intro p:last-child { margin-bottom: 0; }
.pol--wide .pol__inner { display: block; }
@media (max-width: 760px) {
  .page-hero__inner.pol-hero__inner { grid-template-columns: 1fr; }
  .pol-hero__aside { text-align: left; }
}
@media (max-width: 860px) {
  .pol__inner { grid-template-columns: 1fr; }
  .pol__head { position: static; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Policy block",
  "settings": [
    { "type": "text", "id": "only_on_handle", "label": "Only show on page (handle)", "info": "Leave blank to always show. Set to a page handle, e.g. shipping-information, to show this only on that page." },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "policy", "info": "Used for #links into this block." },
    { "type": "select", "id": "tone", "label": "Background", "default": "cream", "options": [
      { "value": "cream", "label": "Cream" },
      { "value": "paper", "label": "Paper" }
    ] },
    { "type": "text", "id": "title", "label": "Title", "default": "Policy" },
    { "type": "checkbox", "id": "as_page_header", "label": "Use as the page header", "default": false, "info": "Draws the page hero itself, with the introduction on the right, and runs the parts full width below it. Hide the default page hero for this page in the Page section settings." },
    { "type": "checkbox", "id": "show_title", "label": "Show title", "default": true, "info": "Turn off when the page heading above already says it." },
    { "type": "text", "id": "meta", "label": "Small line under the title", "info": "For example: Last Updated: October 2026. Leave blank for none." },
    { "type": "richtext", "id": "intro", "label": "Introduction", "default": "<p>Introduction.</p>" }
  ],
  "blocks": [
    {
      "type": "part",
      "name": "Part",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Heading" },
        { "type": "richtext", "id": "body", "label": "Text", "default": "<p>Text.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "Policy block" }]
}
{% endschema %}
