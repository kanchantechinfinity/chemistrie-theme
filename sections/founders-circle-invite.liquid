<section class="page-section finvite" id="request-invitation">
  <div class="page-section__inner finvite__inner">
    <div class="finvite__copy">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="finvite__heading">{{ section.settings.heading }}</h2>
      <p class="finvite__sub">{{ section.settings.sub }}</p>
    </div>

    <div class="finvite__form-wrap">
      {%- form 'contact', id: 'FoundersCircleForm' -%}
        {%- if form.posted_successfully? -%}
          <p class="finvite__success">{{ section.settings.success_message }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <p class="finvite__error">{{ form.errors | default_errors }}</p>
          {%- endif -%}
          <input type="hidden" name="contact[subject]" value="Founder's Circle — Request an Invitation">
          <div class="finvite__field">
            <label class="finvite__label" for="finvite-name">Name</label>
            <input class="finvite__input" id="finvite-name" type="text" name="contact[name]" value="{{ form.name }}" placeholder="Jane Doe" required minlength="2" maxlength="60" pattern="[A-Za-zÀ-ÖØ-öø-ÿ' .-]+" title="Please enter a name using letters only (no numbers or symbols).">
          </div>
          <div class="finvite__field">
            <label class="finvite__label" for="finvite-email">Email</label>
            <input class="finvite__input" id="finvite-email" type="email" name="contact[email]" value="{{ form.email }}" placeholder="you@elsewhere.com" required maxlength="100" title="Please enter a valid email address.">
          </div>
          <div class="finvite__field">
            <label class="finvite__label" for="finvite-body">Your relationship with Chemistrie so far</label>
            <textarea class="finvite__input finvite__textarea" id="finvite-body" name="contact[body]" rows="4" maxlength="1000" required placeholder="How long you've been a customer, what you've loved, anything worth knowing." oninput="this.value = this.value.replace(/[<>]/g, '')">{{ form.body }}</textarea>
            <span class="finvite__hint">No &lt; or &gt; characters. 1000 characters max.</span>
          </div>
          <button class="btn btn--primary" type="submit">Request an Invitation</button>
          <p class="finvite__note">{{ section.settings.form_note }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% stylesheet %}
.finvite { background: var(--c-cream); }
.finvite__inner { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 96px); align-items: start; }
.finvite__copy .eyebrow { display: inline-block; margin-bottom: 18px; }
.finvite__heading { font-family: var(--ff-display); font-size: clamp(28px, 3.4vw, 40px); font-weight: 500; color: var(--c-forest); margin: 0 0 20px; max-width: 14ch; }
.finvite__sub { color: var(--c-ink-soft); line-height: 1.75; max-width: 46ch; margin: 0; }

.finvite__field { display: flex; flex-direction: column; gap: 8px; margin-bottom: 20px; }
.finvite__label { font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--c-forest); }
.finvite__input {
  width: 100%; font-family: var(--ff-body); font-size: 15px;
  padding: 13px 15px; border: 1px solid var(--c-line-soft); border-radius: 8px;
  background: var(--c-paper); color: var(--c-forest);
  transition: border-color .3s var(--ease-out);
}
.finvite__input:focus { outline: none; border-color: var(--c-forest); }
.finvite__textarea { resize: vertical; min-height: 110px; }
.finvite__hint { font-size: 12px; color: var(--c-ink-mute, rgba(26,58,45,.55)); }
.finvite__note { margin: 16px 0 0; font-size: 12.5px; color: var(--c-ink-mute); }
.finvite__success {
  padding: 22px 26px; border-radius: 12px; background: var(--c-forest); color: var(--c-cream);
  font-size: 15px; line-height: 1.7; margin: 0;
}
.finvite__error { padding: 16px 20px; border-radius: 10px; background: rgba(180,60,50,.12); color: #8a2e26; font-size: 14px; margin: 0 0 20px; }

@media (max-width: 820px) {
  .finvite__inner { grid-template-columns: 1fr; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Founder's Circle Invite",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "— Request an Invitation —" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Membership isn't applied for." },
    { "type": "textarea", "id": "sub", "label": "Subtext", "default": "It's extended, when a relationship has reached the kind of depth a founder would recognize by name. Tell us a little about yours, and a founder will read it personally." },
    { "type": "textarea", "id": "form_note", "label": "Note below the form", "default": "Every request is read by a founder, not an automated approval — replies take a few days, not a few minutes." },
    { "type": "textarea", "id": "success_message", "label": "Success message", "default": "Thank you — this reached the founders directly, not an inbox that sorts by discount code. If it's a fit, you'll hear back from Harin or Zach personally." }
  ],
  "presets": [{ "name": "Founder's Circle Invite" }]
}
{% endschema %}
