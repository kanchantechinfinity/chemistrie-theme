<!--
  Pinned scroll effect: the photo fills the frame first; as the visitor
  scrolls, the 3 blocks (that make up the photo) rotate open like cards to
  reveal the story text on their back face. Desktop/motion-enabled only —
  mobile and prefers-reduced-motion get the plain photo + stacked cards.
-->
<section class="page-section pcreds" id="pcreds-flip">
  <div class="page-section__inner">
    <div class="page-section__head">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="display-h">{{ section.settings.heading }}</h2>
    </div>

    {%- assign pcreds_photo = section.settings.photo -%}
    {%- assign pcreds_photo_asset = section.settings.photo_asset -%}
    {%- assign pcreds_n = section.blocks.size -%}
    {%- assign pcreds_denom = pcreds_n | minus: 1 -%}
    {%- if pcreds_denom < 1 -%}{%- assign pcreds_denom = 1 -%}{%- endif -%}
    {%- assign pcreds_bg_size = pcreds_n | times: 100 -%}

    {%- if pcreds_photo != blank -%}
      {%- assign pcreds_photo_url = pcreds_photo | image_url: width: 1600 -%}
    {%- elsif pcreds_photo_asset != blank -%}
      {%- assign pcreds_photo_url = pcreds_photo_asset | asset_url -%}
    {%- endif -%}

    {%- if pcreds_photo_url != blank -%}
    <img class="pcreds__mobile-photo" src="{{ pcreds_photo_url }}" alt="" loading="lazy">
    {%- endif -%}

    <div class="pflip" data-pflip>
      <div class="pflip__stage">
        <div class="pflip__cards">
          {%- for block in section.blocks -%}
            {%- assign pcreds_pos_x = forloop.index0 | times: 100.0 | divided_by: pcreds_denom -%}
            <div class="pflip__card" data-pflip-card {{ block.shopify_attributes }}>
              <div class="pflip__card-inner">
                <div
                  class="pflip__face pflip__face--front"
                  aria-hidden="true"
                  {%- if pcreds_photo_url != blank %}
                  style="background-image:url('{{ pcreds_photo_url }}'); background-size:{{ pcreds_bg_size }}% 100%; background-position:{{ pcreds_pos_x }}% 50%;"
                  {%- endif %}
                ></div>
                <div class="pflip__face pflip__face--back">
                  <span class="pcred__num">{{ block.settings.number }}</span>
                  <h3 class="pcred__title">{{ block.settings.title }}</h3>
                  <p class="pcred__body">{{ block.settings.body }}</p>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.pcreds { background: var(--c-cream); }

/* Plain photo shown on mobile/reduced-motion only — the pinned desktop
   version renders the same photo sliced across the 3 card fronts instead. */
.pcreds__mobile-photo {
  display: none;
  width: 100%;
  border-radius: 22px;
  margin-bottom: clamp(24px, 3vw, 40px);
}

.pflip { position: relative; height: 320vh; }
.pflip__stage {
  position: sticky;
  top: 0;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pflip__cards {
  display: flex;
  width: min(1100px, 92vw);
  height: min(560px, 72vh);
  border-radius: 22px;
  overflow: hidden;
  box-shadow: 0 40px 80px -30px rgba(26, 58, 45, .35);
}
/* Once the pieces start separating they have to be able to travel outside the
   frame, and the frame's own rounding/shadow would otherwise cut across the
   gaps between them. Each piece carries its own from that point on. */
.pflip__cards.is-split {
  overflow: visible;
  border-radius: 0;
  box-shadow: none;
}
/* perspective per card, not on the shared frame: one shared perspective puts
   the vanishing point at the frame's centre, so the outer cards sheared off
   axis instead of each turning in place. */
.pflip__card { position: relative; flex: 1 1 0; perspective: 1400px; }
.pflip__card-inner {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transform: rotateY(0deg);
}
/* Rounding and shadow ride on the faces, not the piece that holds them: the
   faces are what actually turns, and clipping a 3D child to a rounded parent
   flattens the transform in some browsers. The piece sets the two values. */
.pflip__face {
  position: absolute;
  inset: 0;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  overflow: hidden;
  border-radius: var(--piece-radius, 0px);
  box-shadow: var(--piece-shadow, none);
}
.pflip__face--front { background-repeat: no-repeat; }
.pflip__face--back {
  background: var(--c-tan-3);
  justify-content: flex-start;
  transform: rotateY(180deg);
  padding: clamp(22px, 2.6vw, 34px);
}

.pcred__num { font-family: var(--ff-display); font-style: italic; font-size: 22px; color: var(--c-tan-2); }
.pcred__title { margin: 14px 0 0; font-family: var(--ff-display); font-size: clamp(20px, 1.9vw, 25px); font-weight: 500; color: var(--c-forest); line-height: 1.2; }
.pcred__body { margin: 14px 0 0; color: var(--c-ink-soft); line-height: 1.75; font-size: 14.5px; }

@media (max-width: 860px), (prefers-reduced-motion: reduce) {
  .pcreds__mobile-photo { display: block; }
  .pflip { height: auto; }
  .pflip__stage { position: static; height: auto; }
  .pflip__cards {
    flex-direction: column;
    width: 100%;
    height: auto;
    box-shadow: none;
    border-radius: 0;
    gap: clamp(16px, 2vw, 22px);
  }
  /* the split-and-turn script sets these inline on desktop; clear them so the
     stacked fallback isn't offset or double-shadowed. */
  .pflip__card {
    flex: none; perspective: none; transform: none !important;
    --piece-radius: 0px; --piece-shadow: none;
  }
  .pflip__card-inner { height: auto; transform: none !important; }
  .pflip__face { position: static; }
  .pflip__face--front { display: none; }
  .pflip__face--back {
    transform: none;
    background: var(--c-tan-3);
    border-radius: 18px;
    padding: clamp(28px, 2.8vw, 36px);
  }
}
{% endstylesheet %}

{% javascript %}
(function () {
  var wrap = document.querySelector('[data-pflip]');
  if (!wrap) return;
  var frame = wrap.querySelector('.pflip__cards');
  var pieces = Array.prototype.slice.call(wrap.querySelectorAll('[data-pflip-card]'));
  var cards = pieces.map(function (p) { return p.querySelector('.pflip__card-inner'); });
  if (!pieces.length) return;

  var mqDisable = window.matchMedia('(max-width: 860px)');
  var mqReduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  var ticking = false;

  // Scroll is spent on two moves: the photo breaks apart, then each piece
  // turns in turn. SPLIT_END is where the first turn begins.
  var SPLIT_END = 0.18;
  var TURN_SPAN = 0.22;
  var GAP = 30;     // px each outer piece travels away from centre
  var RADIUS = 18;  // px, once the pieces are standing on their own

  function isDisabled() {
    return mqDisable.matches || mqReduced.matches;
  }

  function reset() {
    if (frame) frame.classList.remove('is-split');
    pieces.forEach(function (piece, i) {
      piece.style.transform = '';
      piece.style.removeProperty('--piece-radius');
      piece.style.removeProperty('--piece-shadow');
      cards[i].style.transform = '';
    });
  }

  function update() {
    ticking = false;
    // Inline values outrank the stacked fallback's rules, so clear them rather
    // than leaving them behind when the viewport crosses into mobile.
    if (isDisabled()) { reset(); return; }

    var rect = wrap.getBoundingClientRect();
    var total = wrap.offsetHeight - window.innerHeight;
    if (total <= 0) return;

    var progress = -rect.top / total;
    if (progress < 0) progress = 0;
    if (progress > 1) progress = 1;

    var split = clamp01(progress / SPLIT_END);
    var centre = (pieces.length - 1) / 2;
    if (frame) frame.classList.toggle('is-split', split > 0);

    pieces.forEach(function (piece, i) {
      // Outer pieces travel away from the middle one, so the seams open into
      // the page behind rather than onto anything laid under the frame.
      piece.style.transform = 'translateX(' + ((i - centre) * split * GAP) + 'px)';
      piece.style.setProperty('--piece-radius', (split * RADIUS) + 'px');
      piece.style.setProperty('--piece-shadow', split > 0
        ? '0 30px 60px -28px rgba(26, 58, 45, ' + (split * 0.45) + ')'
        : 'none');

      // Sequential windows with a beat between them — overlapping turns read
      // as one movement rather than three separate cards.
      var start = SPLIT_END + i * (TURN_SPAN + 0.06);
      var local = clamp01((progress - start) / TURN_SPAN);
      cards[i].style.transform = 'rotateY(' + (local * 180) + 'deg)';
    });
  }

  function clamp01(v) {
    if (v < 0) return 0;
    if (v > 1) return 1;
    return v;
  }

  function onScroll() {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  update();
})();
{% endjavascript %}

{% schema %}
{
  "name": "Pharmacists Credentials",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "— The credentials —" },
    { "type": "html", "id": "heading", "label": "Heading (supports <em>/<br>)", "default": "What a<br/>compounding<br/><em>pharmacist does.</em>" },
    { "type": "header", "content": "Pinned scroll photo" },
    { "type": "image_picker", "id": "photo", "label": "Photo" },
    { "type": "text", "id": "photo_asset", "label": "Photo filename (/assets)", "info": "Fallback used only if the photo above is blank.", "default": "pcreds-collection-photo.jpg" }
  ],
  "blocks": [
    {
      "type": "cred",
      "name": "Credential",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "01" },
        { "type": "text", "id": "title", "label": "Title", "default": "They weigh the actives themselves" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "A compounding pharmacist mixes each formula by hand, to the milligram — the same discipline used to prepare a prescription, brought to a bottle you keep on your shelf." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pharmacists Credentials",
      "blocks": [
        { "type": "cred", "settings": { "number": "01", "title": "They weigh the actives themselves", "body": "A compounding pharmacist mixes each formula by hand, to the milligram — the same discipline used to prepare a prescription, brought to a bottle you keep on your shelf." } },
        { "type": "cred", "settings": { "number": "02", "title": "They know how molecules behave", "body": "Which actives can share a bottle, which must be kept apart, what oil keeps vitamin C alive — this is pharmacy, not marketing, and it decides whether a formula actually works." } },
        { "type": "cred", "settings": { "number": "03", "title": "They answer for every batch", "body": "Each run is numbered and traceable to the pharmacist who compounded it. If a question comes in, a real person who mixed it is the one who answers." } }
      ]
    }
  ]
}
{% endschema %}
