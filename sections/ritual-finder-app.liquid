{%- comment -%}
  Chemistrie Ritual Finder — Native Interactive Questionnaire & Personalized Consultation
  Replaces static educational content with a guided, quiet-luxury consultation experience.
{%- endcomment -%}

{%- liquid
  assign handles = 'velvet,veil,cashmere,aura,silken' | split: ','
-%}

<section class="ritual-finder-app" id="ritual-finder-app" data-screen-label="Ritual Finder Consultation">
  <div class="ritual-finder-app__inner">

    <!-- ───── Consultation View (Form Card) ───── -->
    <div class="rf-form-card" id="rfCard">

      <!-- Card Header: Eyebrow + Progress -->
      <div class="rf-form-card__header">
        <div class="rf-form-card__meta">
          <span class="ritual-finder-app__eyebrow" id="rfEyebrow">— {{ section.settings.eyebrow | default: 'Personalized Consultation' }} —</span>
          <span class="ritual-finder-app__step-text" id="rfStepText">Question <strong id="rfCurrentStep">1</strong> of <span id="rfTotalSteps">4</span></span>
        </div>
        <div class="ritual-finder-app__progress-track" aria-hidden="true">
          <div class="ritual-finder-app__progress-bar" id="rfProgressBar" style="width: 25%;"></div>
        </div>
      </div>

      <!-- Slides Container (Questions Only) -->
      <div class="ritual-finder-app__slides" id="rfSlides">

        <!-- Slide 1: Skin Baseline -->
        <article class="rf-slide is-active" data-step="1" data-question="skin_feel" data-is-question="true">
          <div class="rf-slide__head">
            <span class="rf-slide__tag">01 / Baseline</span>
            <h2 class="rf-slide__title">How does your skin typically feel by midday?</h2>
            <p class="rf-slide__sub">Select the description that most closely mirrors your skin's natural baseline.</p>
          </div>
          <div class="rf-options rf-options--stacked">
            <button type="button" class="rf-card" data-val="dry">
              <div class="rf-card__content">
                <div class="rf-card__row-top">
                  <h3 class="rf-card__title">Dry or Tight</h3>
                  <span class="rf-card__cue">Needs barrier lipids &amp; deep hydration</span>
                </div>
                <p class="rf-card__desc">Feels parched, tight after cleansing, or craving rich, lasting moisture.</p>
              </div>
              <div class="rf-card__radio" aria-hidden="true"><span class="rf-card__radio-dot"></span></div>
            </button>

            <button type="button" class="rf-card" data-val="balanced">
              <div class="rf-card__content">
                <div class="rf-card__row-top">
                  <h3 class="rf-card__title">Balanced &amp; Comfortable</h3>
                  <span class="rf-card__cue">Needs daily barrier maintenance</span>
                </div>
                <p class="rf-card__desc">Generally even throughout the day, neither excessively shiny nor dry.</p>
              </div>
              <div class="rf-card__radio" aria-hidden="true"><span class="rf-card__radio-dot"></span></div>
            </button>

            <button type="button" class="rf-card" data-val="combination">
              <div class="rf-card__content">
                <div class="rf-card__row-top">
                  <h3 class="rf-card__title">Combination</h3>
                  <span class="rf-card__cue">Needs layered, weightless hydration</span>
                </div>
                <p class="rf-card__desc">Oil across the T-zone while the perimeter or cheeks remain normal or dry.</p>
              </div>
              <div class="rf-card__radio" aria-hidden="true"><span class="rf-card__radio-dot"></span></div>
            </button>

            <button type="button" class="rf-card" data-val="oily">
              <div class="rf-card__content">
                <div class="rf-card__row-top">
                  <h3 class="rf-card__title">Oil-Prone or Congested</h3>
                  <span class="rf-card__cue">Needs weightless hydration &amp; targeted clarifying</span>
                </div>
                <p class="rf-card__desc">Prone to midday shine, visible pores, or texture that needs refinement.</p>
              </div>
              <div class="rf-card__radio" aria-hidden="true"><span class="rf-card__radio-dot"></span></div>
            </button>
          </div>
        </article>

        <!-- Slide 2: Primary Goal -->
        <article class="rf-slide" data-step="2" data-question="primary_goal" style="display: none;">
          <div class="rf-slide__head">
            <span class="rf-slide__tag">02 / Primary Focus</span>
            <h2 class="rf-slide__title">What is your primary skincare priority right now?</h2>
            <p class="rf-slide__sub">Your ritual will be formulated to support and emphasize this goal.</p>
          </div>
          <div class="rf-options rf-options--stacked">
            <button type="button" class="rf-card" data-val="hydration">
              <div class="rf-card__content">
                <div class="rf-card__row-top">
                  <h3 class="rf-card__title">Deep Hydration &amp; Suppleness</h3>
                  <span class="rf-card__cue">Multi-molecular hydration focus</span>
                </div>
                <p class="rf-card__desc">Plumping moisture that cushions the skin without a single ounce of heaviness.</p>
              </div>
              <div class="rf-card__radio" aria-hidden="true"><span class="rf-card__radio-dot"></span></div>
            </button>

            <button type="button" class="rf-card" data-val="renewal">
              <div class="rf-card__content">
                <div class="rf-card__row-top">
                  <h3 class="rf-card__title">Cellular Renewal &amp; Firming</h3>
                  <span class="rf-card__cue">Peptide-led renewal focus</span>
                </div>
                <p class="rf-card__desc">Smoothing fine lines, improving elasticity, and supporting overnight rejuvenation.</p>
              </div>
              <div class="rf-card__radio" aria-hidden="true"><span class="rf-card__radio-dot"></span></div>
            </button>

            <button type="button" class="rf-card" data-val="barrier">
              <div class="rf-card__content">
                <div class="rf-card__row-top">
                  <h3 class="rf-card__title">Barrier Calm &amp; Resilience</h3>
                  <span class="rf-card__cue">Conditioning &amp; protective focus</span>
                </div>
                <p class="rf-card__desc">Soothing irritation, reducing flushing, and rebuilding delicate skin barriers.</p>
              </div>
              <div class="rf-card__radio" aria-hidden="true"><span class="rf-card__radio-dot"></span></div>
            </button>

            <button type="button" class="rf-card" data-val="refine">
              <div class="rf-card__content">
                <div class="rf-card__row-top">
                  <h3 class="rf-card__title">Targeted Refinement &amp; Smoothing</h3>
                  <span class="rf-card__cue">Botanical lipid focus</span>
                </div>
                <p class="rf-card__desc">Refining rough texture, dullness, and targeted areas needing extra focus.</p>
              </div>
              <div class="rf-card__radio" aria-hidden="true"><span class="rf-card__radio-dot"></span></div>
            </button>
          </div>
        </article>

        <!-- Slide 3: Routine Philosophy -->
        <article class="rf-slide" data-step="3" data-question="routine_pace" style="display: none;">
          <div class="rf-slide__head">
            <span class="rf-slide__tag">03 / Routine Style</span>
            <h2 class="rf-slide__title">Which routine structure fits your daily lifestyle best?</h2>
            <p class="rf-slide__sub">Chemistrie formulas are designed to work harmoniously as a complete system or as standalone steps.</p>
          </div>
          <div class="rf-options rf-options--stacked">
            <button type="button" class="rf-card" data-val="essential">
              <div class="rf-card__content">
                <div class="rf-card__row-top">
                  <h3 class="rf-card__title">Essential Foundation (3 Steps)</h3>
                  <span class="rf-card__cue">Quick 2-minute daily rhythm</span>
                </div>
                <p class="rf-card__desc">Cleanse, Treat, Hydrate. High-efficiency daily simplicity done well.</p>
              </div>
              <div class="rf-card__radio" aria-hidden="true"><span class="rf-card__radio-dot"></span></div>
            </button>

            <button type="button" class="rf-card" data-val="complete">
              <div class="rf-card__content">
                <div class="rf-card__row-top">
                  <h3 class="rf-card__title">Complete Pharmacist System (4–5 Steps)</h3>
                  <span class="rf-card__cue">Maximum clinical efficacy</span>
                </div>
                <p class="rf-card__desc">The full restorative protocol: daytime hydration defense plus evening peptide renewal.</p>
              </div>
              <div class="rf-card__radio" aria-hidden="true"><span class="rf-card__radio-dot"></span></div>
            </button>

            <button type="button" class="rf-card" data-val="targeted">
              <div class="rf-card__content">
                <div class="rf-card__row-top">
                  <h3 class="rf-card__title">Targeted &amp; Modular</h3>
                  <span class="rf-card__cue">Customizable focus zones</span>
                </div>
                <p class="rf-card__desc">Core hydration layered with targeted botanical treatment where needed most.</p>
              </div>
              <div class="rf-card__radio" aria-hidden="true"><span class="rf-card__radio-dot"></span></div>
            </button>
          </div>
        </article>

        <!-- Slide 4: Sensitivity Level -->
        <article class="rf-slide" data-step="4" data-question="sensitivity" style="display: none;">
          <div class="rf-slide__head">
            <span class="rf-slide__tag">04 / Tolerance</span>
            <h2 class="rf-slide__title">How does your skin typically respond to active ingredients?</h2>
            <p class="rf-slide__sub">Formulated by compounding pharmacists, all Chemistrie products are sensitive-skin respectful.</p>
          </div>
          <div class="rf-options rf-options--stacked">
            <button type="button" class="rf-card" data-val="resilient">
              <div class="rf-card__content">
                <div class="rf-card__row-top">
                  <h3 class="rf-card__title">Resilient &amp; Adaptable</h3>
                </div>
                <p class="rf-card__desc">Rarely experiences sensitivity, flaking, or redness when introducing new formulas.</p>
              </div>
              <div class="rf-card__radio" aria-hidden="true"><span class="rf-card__radio-dot"></span></div>
            </button>

            <button type="button" class="rf-card" data-val="mild">
              <div class="rf-card__content">
                <div class="rf-card__row-top">
                  <h3 class="rf-card__title">Mildly Sensitive</h3>
                </div>
                <p class="rf-card__desc">Can feel sensitized by seasonal changes, heavy fragrances, or over-exfoliation.</p>
              </div>
              <div class="rf-card__radio" aria-hidden="true"><span class="rf-card__radio-dot"></span></div>
            </button>

            <button type="button" class="rf-card" data-val="reactive">
              <div class="rf-card__content">
                <div class="rf-card__row-top">
                  <h3 class="rf-card__title">Highly Sensitive or Reactive</h3>
                </div>
                <p class="rf-card__desc">Prone to flushing, tightness, or stinging; benefits from gentle barrier-reinforcing ingredients.</p>
              </div>
              <div class="rf-card__radio" aria-hidden="true"><span class="rf-card__radio-dot"></span></div>
            </button>
          </div>
        </article>

        <!-- Slide 5: Dynamic Recommendation View -->
        <article class="rf-slide rf-slide--results" id="rfResult" data-step="5" style="display: none;">
          <div class="rf-result__header">
            <span class="eyebrow eyebrow--accent">— Your Personalized Routine —</span>
            <h2 class="display-h rf-result__title" id="rfResultTitle">The Pure Hydration &amp; Renewal Ritual</h2>
            <p class="rf-result__rationale" id="rfResultRationale">
              Based on your consultation, your ritual pairs gentle cleansing with multi-depth hydration and nighttime cellular peptide renewal.
            </p>
          </div>

          <!-- AM / PM Routine Regimen -->
          <div class="rf-result__regimen">
            <!-- Morning Sequence -->
            <div class="rf-result__routine">
              <div class="rf-result__routine-label">AM</div>
              <div class="rf-result__product-list" id="rfListAM"></div>
              <div class="rf-result__routine-price" id="rfPriceAM"></div>
            </div>

            <!-- Evening Sequence -->
            <div class="rf-result__routine">
              <div class="rf-result__routine-label">PM</div>
              <div class="rf-result__product-list" id="rfListPM"></div>
              <div class="rf-result__routine-price" id="rfPricePM"></div>
            </div>
          </div>

          <!-- Actions Strip -->
          <div class="rf-result__actions">
            <div class="rf-result__pricing">
              <span class="rf-result__price-label">Recommended Ritual Total:</span>
              <span class="rf-result__price-val" id="rfTotalPrice">$228</span>
            </div>
            <div class="rf-result__cta-group">
              <button type="button" class="btn btn--primary btn--dark rf-result__btn-add" id="rfBtnAddRitual">
                <span>Add Complete Ritual to Bag</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </button>
              <a href="/collections/all" class="btn btn--outline rf-result__btn-shop">
                Explore All Formulas
              </a>
            </div>
            <button type="button" class="rf-result__retake-link" id="rfBtnRetake">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="14" height="14" aria-hidden="true"><path d="M14 4h6v6M10 20H4v-6"/><path d="M20 10l-4.5-4.5A9 9 0 0 0 4 12m0 0a9 9 0 0 0 15.5 4.5L20 16"/></svg>
              <span>Retake Consultation</span>
            </button>
          </div>
        </article>

      </div>

      <!-- Form Card Footer: Navigation Buttons for questions 1-4 -->
      <div class="rf-form-card__footer" id="rfCardFooter">
        <button type="button" class="btn btn--outline ritual-finder-app__btn-back" id="rfBtnBack" style="visibility: hidden;">
          <span aria-hidden="true">←</span> Previous
        </button>
        <button type="button" class="rf-form-card__instant-btn" id="rfBtnInstant" style="display: none;">
          <span>See Recommended Ritual</span> <span aria-hidden="true">→</span>
        </button>
        <button type="button" class="btn btn--primary btn--dark ritual-finder-app__btn-next" id="rfBtnNext" disabled>
          Continue <span aria-hidden="true">→</span>
        </button>
      </div>

    </div>

    <!-- ───── Recommendations View (Main Page) ───── -->
    <div class="rf-results-page" id="rfResultsPage" style="display: none;">
        <div class="rf-result__header">
          <span class="eyebrow eyebrow--accent">— Your Personalized Routine —</span>
          <h2 class="display-h rf-result__title" id="rfResultTitle">The Pure Hydration &amp; Renewal Ritual</h2>
          <p class="rf-result__rationale" id="rfResultRationale">
            Based on your consultation, your ritual pairs gentle cleansing with multi-depth hydration and nighttime cellular peptide renewal.
          </p>
        </div>

        <!-- AM / PM Routine Regimen -->
        <div class="rf-result__regimen">
          <!-- Morning Sequence -->
          <div class="rf-result__routine">
            <div class="rf-result__routine-label">AM</div>
            <div class="rf-result__product-list" id="rfListAM"></div>
            <div class="rf-result__routine-price" id="rfPriceAM"></div>
          </div>

          <!-- Evening Sequence -->
          <div class="rf-result__routine">
            <div class="rf-result__routine-label">PM</div>
            <div class="rf-result__product-list" id="rfListPM"></div>
            <div class="rf-result__routine-price" id="rfPricePM"></div>
          </div>
        </div>

        <!-- Actions Strip -->
        <div class="rf-result__actions">
          <div class="rf-result__pricing">
            <span class="rf-result__price-label">Recommended Ritual Total:</span>
            <span class="rf-result__price-val" id="rfTotalPrice">$228</span>
          </div>
          <div class="rf-result__cta-group">
            <button type="button" class="btn btn--primary btn--dark rf-result__btn-add" id="rfBtnAddRitual">
              <span>Add Complete Ritual to Bag</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
            <a href="/collections/all" class="btn btn--outline rf-result__btn-shop">
              Explore All Formulas
            </a>
          </div>
          <button type="button" class="rf-result__retake-link" id="rfBtnRetake">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="14" height="14" aria-hidden="true"><path d="M14 4h6v6M10 20H4v-6"/><path d="M20 10l-4.5-4.5A9 9 0 0 0 4 12m0 0a9 9 0 0 0 15.5 4.5L20 16"/></svg>
            <span>Retake Consultation</span>
          </button>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
(function() {
  function initRitualFinderCard() {
    var card = document.getElementById("rfCard");
    if (!card) return;

    var slides = Array.prototype.slice.call(card.querySelectorAll(".rf-slide"));
    var btnNext = document.getElementById("rfBtnNext");
    var btnBack = document.getElementById("rfBtnBack");
    var btnInstant = document.getElementById("rfBtnInstant");
    var currentStepEl = document.getElementById("rfCurrentStep");
    var totalStepsEl = document.getElementById("rfTotalSteps");
    var progressBar = document.getElementById("rfProgressBar");
    var cardFooter = document.getElementById("rfCardFooter");
    var eyebrowEl = document.getElementById("rfEyebrow");
    var stepTextEl = document.getElementById("rfStepText");
    var resultsPage = document.getElementById("rfResultsPage");

    var products = {
      velvet: {
        handle: "velvet",
        title: "Velvet",
        stepSubtitle: "Conditioning Cleanser",
        role: "Cleanse",
        price: "$48",
        cents: 4800,
        url: "/products/velvet",
        image: "{{ 'product-velvet.png' | asset_url }}",
        why: "Gentle morning and evening cleansing that purifies without disturbing the acid mantle."
      },
      veil: {
        handle: "veil",
        title: "Veil",
        stepSubtitle: "Weightless Hydrating Serum",
        role: "Treat",
        price: "$88",
        cents: 8800,
        url: "/products/veil",
        image: "{{ 'product-veil.png' | asset_url }}",
        why: "Plumping hydration delivered deep into epidermal layers with weightless precision."
      },
      cashmere: {
        handle: "cashmere",
        title: "Cashmere",
        stepSubtitle: "Essential Barrier Cream",
        role: "Hydrate",
        price: "$92",
        cents: 9200,
        url: "/products/cashmere",
        image: "{{ 'product-cashmere.png' | asset_url }}",
        why: "Essential lipid support to seal in hydration and defend against daily moisture evaporation."
      },
      aura: {
        handle: "aura",
        title: "Aura",
        stepSubtitle: "Peptide Renewal Treatment",
        role: "Renew",
        price: "$195",
        cents: 19500,
        url: "/products/aura",
        image: "{{ 'product-aura.png' | asset_url }}",
        why: "Overnight multi-peptide matrix to visibly refine texture, soften lines, and restore elasticity."
      },
      silken: {
        handle: "silken",
        title: "Silken",
        stepSubtitle: "Botanical Conditioning Elixir",
        role: "Refine",
        price: "$135",
        cents: 13500,
        url: "/products/silken",
        image: "{{ 'product-silken.png' | asset_url }}",
        why: "Targeted botanical conditioning selected for focused refinement and delicate zones."
      }
    };

    var questionSlides = slides.filter(function(s) {
      return s.getAttribute("data-step") !== "5";
    });

    var currentStep = 0;
    var answers = {
      skin_feel: null,
      primary_goal: null,
      routine_pace: null,
      sensitivity: null
    };
    var advanceTimer = null;

    if (totalStepsEl) totalStepsEl.textContent = questionSlides.length;

    function renderStep() {
      if (currentStep < questionSlides.length) {
        // Question View
        card.style.display = "block";
        if (resultsPage) {
          resultsPage.style.display = "none";
        }
        slides.forEach(function(s, idx) {
          if (idx === currentStep) {
            s.classList.add("is-active");
            s.style.display = "block";
          } else {
            s.classList.remove("is-active");
            s.style.display = "none";
          }
        });

        if (cardFooter) cardFooter.style.display = "flex";
        if (eyebrowEl) eyebrowEl.textContent = "— {{ section.settings.eyebrow | default: 'Personalized Consultation' }} —";
        if (stepTextEl) {
          stepTextEl.innerHTML = 'Question <strong id="rfCurrentStep">' + (currentStep + 1) + '</strong> of <span id="rfTotalSteps">' + questionSlides.length + '</span>';
        }
        if (progressBar) {
          progressBar.style.width = (((currentStep + 1) / questionSlides.length) * 100) + "%";
        }
        if (btnBack) {
          btnBack.style.visibility = currentStep > 0 ? "visible" : "hidden";
        }

        var activeSlide = questionSlides[currentStep];
        var qKey = activeSlide.getAttribute("data-question");
        var hasAns = !!answers[qKey];
        var hasAnyAns = !!(answers.skin_feel || answers.primary_goal || answers.routine_pace || answers.sensitivity);

        if (btnInstant) {
          btnInstant.style.display = (hasAnyAns && currentStep < questionSlides.length - 1) ? "inline-flex" : "none";
        }

        if (btnNext) {
          btnNext.disabled = !hasAns;
          if (currentStep === questionSlides.length - 1) {
            btnNext.innerHTML = 'Reveal My Custom Ritual <span aria-hidden="true">→</span>';
          } else {
            btnNext.innerHTML = 'Continue <span aria-hidden="true">→</span>';
          }
        }
      } else {
        // Recommendation View
        showResults();
      }
    }

    function showResults() {
      card.style.display = "none";
      if (resultsPage) {
        resultsPage.style.display = "block";
      }

      // Compute recommendation
      var ritualTitle = "The Pure Hydration & Renewal Ritual";
      var rationale = "A high-efficacy foundation designed to balance baseline hydration, defend against moisture evaporation, and restore healthy skin radiance.";
      var amHandles = ["velvet", "veil", "cashmere"];
      var pmHandles = ["velvet", "veil", "aura"];
      var allHandles = ["velvet", "veil", "cashmere", "aura"];

      if (answers.sensitivity === "reactive" || answers.primary_goal === "barrier") {
        ritualTitle = "The Restorative Barrier Ritual";
        rationale = "Formulated to calm reactivity, replenish lost lipid ceramides, and reinforce your skin's protective barrier without causing irritation.";
        amHandles = ["velvet", "veil", "cashmere"];
        pmHandles = ["velvet", "veil", "cashmere", "aura"];
        allHandles = ["velvet", "veil", "cashmere", "aura"];
      } else if (answers.skin_feel === "oily" || answers.primary_goal === "refine") {
        ritualTitle = "The Clarifying & Refining Ritual";
        rationale = "Designed to refine skin texture and balance midday shine through weightless hydration and nutrient-dense Amazonian botanicals.";
        amHandles = ["velvet", "veil", "silken"];
        pmHandles = ["velvet", "veil", "silken", "cashmere"];
        allHandles = ["velvet", "veil", "silken", "cashmere"];
      } else if (answers.primary_goal === "renewal" || answers.routine_pace === "complete") {
        ritualTitle = "The Complete Pharmacist System";
        rationale = "The comprehensive 5-step clinical protocol designed for maximum cellular renewal, peptide firming, and multi-molecular hydration.";
        amHandles = ["velvet", "veil", "cashmere"];
        pmHandles = ["velvet", "veil", "aura", "silken"];
        allHandles = ["velvet", "veil", "cashmere", "aura", "silken"];
      } else if (answers.routine_pace === "essential") {
        ritualTitle = "The Essential Daily Ritual";
        rationale = "A streamlined three-step regimen delivering clean, intentional nourishment morning and night.";
        amHandles = ["velvet", "veil", "cashmere"];
        pmHandles = ["velvet", "veil", "cashmere"];
        allHandles = ["velvet", "veil", "cashmere"];
      }

      var titleEl = document.getElementById("rfResultTitle");
      var rationaleEl = document.getElementById("rfResultRationale");
      var listAM = document.getElementById("rfListAM");
      var listPM = document.getElementById("rfListPM");
      var priceAMEl = document.getElementById("rfPriceAM");
      var pricePMEl = document.getElementById("rfPricePM");
      var totalPriceEl = document.getElementById("rfTotalPrice");

      if (titleEl) titleEl.textContent = ritualTitle;
      if (rationaleEl) rationaleEl.textContent = rationale;

      function buildList(handles, container, priceEl) {
        if (!container) return;
        var html = "";
        var subtotal = 0;
        handles.forEach(function(h, i) {
          var p = products[h] || {};
          html += '<div class="rf-item">' +
            '<div class="rf-item__thumb"><img src="' + p.image + '" alt="' + p.title + '" loading="lazy"></div>' +
            '<div class="rf-item__info">' +
              '<span class="rf-item__step-tag">' + p.role + '</span>' +
              '<h4 class="rf-item__name"><a href="' + p.url + '">' + p.title + '</a></h4>' +
            '</div>' +
            '<div class="rf-item__right">' +
              '<span class="rf-item__price">' + p.price + '</span>' +
              '<a class="rf-item__link" href="' + p.url + '">View</a>' +
            '</div>' +
          '</div>';
          subtotal += (p.cents || 0);
        });
        container.innerHTML = html;
        if (priceEl) priceEl.textContent = "$" + Math.round(subtotal / 100);
      }

      buildList(amHandles, listAM, priceAMEl);
      buildList(pmHandles, listPM, pricePMEl);

      var total = 0;
      var added = [];
      allHandles.forEach(function(h) {
        if (added.indexOf(h) === -1) {
          added.push(h);
          var p = products[h];
          if (p) total += (p.cents || 0);
        }
      });
      if (totalPriceEl) totalPriceEl.textContent = "$" + Math.round(total / 100);

      // Safe scroll to top of card if user was scrolled past
      var cardBox = card.getBoundingClientRect();
      if (cardBox.top < 0) {
        card.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    }

    // Option selection listener
    card.addEventListener("click", function(e) {
      var opt = e.target.closest(".rf-card");
      if (!opt) return;

      var slide = opt.closest(".rf-slide");
      if (!slide) return;

      var q = slide.getAttribute("data-question");
      var val = opt.getAttribute("data-val");

      slide.querySelectorAll(".rf-card").forEach(function(c) {
        c.classList.remove("is-selected");
      });
      opt.classList.add("is-selected");
      answers[q] = val;

      if (btnNext) btnNext.disabled = false;
      if (btnInstant && currentStep < questionSlides.length - 1) {
        btnInstant.style.display = "inline-flex";
      }

      if (advanceTimer) clearTimeout(advanceTimer);
      advanceTimer = setTimeout(function() {
        if (currentStep < questionSlides.length - 1) {
          currentStep++;
          renderStep();
        } else {
          currentStep = questionSlides.length;
          showResults();
        }
      }, 350);
    });

    // Next button
    if (btnNext) {
      btnNext.addEventListener("click", function() {
        if (btnNext.disabled) return;
        if (advanceTimer) clearTimeout(advanceTimer);
        if (currentStep < questionSlides.length - 1) {
          currentStep++;
          renderStep();
        } else {
          currentStep = questionSlides.length;
          showResults();
        }
      });
    }

    // Instant recommendation button
    if (btnInstant) {
      btnInstant.addEventListener("click", function() {
        if (advanceTimer) clearTimeout(advanceTimer);
        currentStep = questionSlides.length;
        showResults();
      });
    }

    // Previous button
    if (btnBack) {
      btnBack.addEventListener("click", function() {
        if (advanceTimer) clearTimeout(advanceTimer);
        if (currentStep > 0) {
          currentStep--;
          renderStep();
        }
      });
    }

    // Retake button
    var btnRetake = document.getElementById("rfBtnRetake");
    if (btnRetake) {
      btnRetake.addEventListener("click", function() {
        answers = { skin_feel: null, primary_goal: null, routine_pace: null, sensitivity: null };
        card.querySelectorAll(".rf-card").forEach(function(c) {
          c.classList.remove("is-selected");
        });
        currentStep = 0;
        renderStep();
        card.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    }

    // Add Complete Ritual button
    var btnAdd = document.getElementById("rfBtnAddRitual");
    if (btnAdd) {
      btnAdd.addEventListener("click", function() {
        window.location.href = "/collections/all";
      });
    }

    renderStep();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initRitualFinderCard);
  } else {
    initRitualFinderCard();
  }
})();
</script>

