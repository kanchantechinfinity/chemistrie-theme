<!-- ───── Instagram — curated social grid ───── -->
<section class="insta" id="instagram" data-screen-label="11 Instagram">
  <div class="insta__intro">
    <div>
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="display-h">{{ section.settings.heading }}</h2>
      {%- if section.settings.sub != blank -%}
        <p class="insta__sub">{{ section.settings.sub }}</p>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <p class="insta__body">{{ section.settings.body }}</p>
      {%- endif -%}
    </div>
    <div class="insta__intro-right">
      <a class="insta__handle" href="{{ section.settings.instagram_url | default: '#' }}" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".7" fill="currentColor"/></svg>
        <span>{{ section.settings.handle }}</span>
      </a>
      <div class="insta__nav" aria-label="Slider navigation">
        <button class="insta__arrow" data-dir="-1" aria-label="Previous">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M15 6l-6 6 6 6"/></svg>
        </button>
        <button class="insta__arrow" data-dir="1" aria-label="Next">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 6l6 6-6 6"/></svg>
        </button>
      </div>
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
  <div class="insta__slider-wrap">
    <div class="insta__slider" id="instaSlider">
      {%- for block in section.blocks -%}
        {%- assign tile_alt = block.settings.caption | default: section.settings.handle -%}
        <article class="reel"{{ block.shopify_attributes }}>
          <div class="reel__media">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 700 }}" alt="{{ tile_alt | escape }}" loading="lazy">
            {%- elsif block.settings.image_asset != blank -%}
              <img src="{{ block.settings.image_asset | asset_url }}" alt="{{ tile_alt | escape }}" loading="lazy">
            {%- endif -%}
            {%- if block.settings.link != blank -%}
              <a class="reel__link" href="{{ block.settings.link }}" target="_blank" rel="noopener" aria-label="{{ tile_alt | escape }}"></a>
            {%- endif -%}
          </div>
          {%- if block.settings.caption != blank -%}
            <div class="reel__meta">
              <p>{{ block.settings.caption }}</p>
            </div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>

    <div class="insta__dots" id="instaDots"></div>
  </div>
  {%- endif -%}

  <a class="insta__cta" href="{{ section.settings.instagram_url | default: '#' }}" target="_blank" rel="noopener">
    <span>{{ section.settings.cta_label }}</span>
  </a>
</section>

{% stylesheet %}
.reel__link { position: absolute; inset: 0; z-index: 3; }
{% endstylesheet %}

{% schema %}
{
  "name": "Instagram",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "— Follow Chemistrie —" },
    { "type": "html", "id": "heading", "label": "Heading", "default": "Behind the formulas. Inside the ritual." },
    { "type": "text", "id": "sub", "label": "Subheadline" },
    { "type": "textarea", "id": "body", "label": "Body copy" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Follow on Instagram" },
    { "type": "url", "id": "instagram_url", "label": "Instagram profile URL" },
    { "type": "text", "id": "handle", "label": "Handle", "default": "@chemistrie.co" }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Social post",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Post image" },
        { "type": "text", "id": "image_asset", "label": "Temporary image filename (/assets)", "info": "Placeholder only — used until the real post image is uploaded above." },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "url", "id": "link", "label": "Link to this post" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    { "name": "Instagram" }
  ]
}
{% endschema %}
