<!-- ───── Instagram — horizontal reel slider ───── -->
<section class="insta" id="instagram" data-screen-label="11 Instagram">
  <div class="insta__intro">
    <div>
      <h2 class="display-h">{{ section.settings.heading }}</h2>
      <p class="insta__sub">{{ section.settings.sub }}</p>
    </div>
  </div>

  {%- if section.settings.feed_embed != blank -%}
  <div class="insta__feed-embed">
    {{ section.settings.feed_embed }}
  </div>
  {%- else -%}
  <p class="insta__empty">{{ section.settings.empty_copy }}</p>
  {%- endif -%}

  <a class="insta__cta" href="{{ section.settings.instagram_url | default: '#' }}" target="_blank" rel="noopener">
    <span>{{ section.settings.cta_label }}</span>
  </a>
</section>

{% schema %}
{
  "name": "Instagram",
  "settings": [
    { "type": "html", "id": "heading", "label": "Heading", "default": "Follow the Formulary." },
    { "type": "textarea", "id": "sub", "label": "Subheadline", "default": "Behind-the-scenes formulation notes, the founders' letters, and the earliest look at what's next." },
    { "type": "text", "id": "empty_copy", "label": "Empty-state copy", "default": "Customer moments will appear here once there are real ones to share. Not before." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Follow on Instagram" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "header", "content": "Live Instagram feed (optional)" },
    { "type": "paragraph", "content": "Paste an embed/widget code from an Instagram feed app (Instafeed, Elfsight, Behold, etc.). When filled, the live feed replaces the empty-state copy." },
    { "type": "html", "id": "feed_embed", "label": "Instagram feed embed code" }
  ],
  "presets": [
    { "name": "Instagram" }
  ]
}
{% endschema %}
