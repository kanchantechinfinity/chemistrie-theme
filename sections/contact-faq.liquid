<section class="page-section contact-faq" data-screen-label="FAQ">
  <div class="page-section__inner">
    <div class="page-section__head contact-faq__head">
      <h2 class="contact-faq__heading">{{ section.settings.heading }}</h2>
    </div>

    <div class="cfaq-list">
      {%- assign faq_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq' -%}
          {%- assign faq_index = faq_index | plus: 1 -%}
          <div class="cfaq-item" {{ block.shopify_attributes }}>
            <button class="cfaq-item__q" type="button" aria-expanded="false" aria-controls="cfaq-a-{{ faq_index }}">
              <span class="cfaq-item__num" aria-hidden="true">{%- if faq_index < 10 -%}0{{ faq_index }}{%- else -%}{{ faq_index }}{%- endif -%}</span>
              <span class="cfaq-item__question">{{ block.settings.question }}</span>
              <span class="cfaq-item__icon" aria-hidden="true">
                <span class="cfaq-item__icon-line cfaq-item__icon-line--h"></span>
                <span class="cfaq-item__icon-line cfaq-item__icon-line--v"></span>
              </span>
            </button>
            <div class="cfaq-item__a" id="cfaq-a-{{ faq_index }}">
              <div class="cfaq-item__a-inner">{{ block.settings.answer }}</div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.footer_heading != blank or section.settings.footer_body != blank -%}
      <div class="contact-faq__footer">
        {%- if section.settings.footer_heading != blank -%}
          <p class="contact-faq__footer-heading">{{ section.settings.footer_heading }}</p>
        {%- endif -%}
        {%- if section.settings.footer_body != blank -%}
          <p class="contact-faq__footer-body">{{ section.settings.footer_body }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.contact-faq { background: var(--c-cream); }

/* Heading is capped well below .display-h's normal size and scales on
   viewport width (not just container width) so "Frequently asked
   questions" always fits a single line, down to the narrowest phones. */
.contact-faq__head { max-width: none; }
.contact-faq__heading {
  margin: 14px 0 0;
  font-family: var(--ff-display);
  font-weight: 400;
  white-space: nowrap;
  font-size: clamp(15px, 5vw, 36px);
  line-height: 1.1;
  letter-spacing: -.01em;
  color: var(--c-forest);
}

.contact-faq__footer { text-align: center; margin-top: clamp(32px, 5vw, 52px); }
.contact-faq__footer-heading { margin: 0 0 6px; font-family: var(--ff-display); font-size: clamp(19px, 2vw, 23px); color: var(--c-forest); }
.contact-faq__footer-body { margin: 0; color: var(--c-ink-soft); font-size: 15.5px; }
.contact-faq__footer-body a { color: var(--c-forest); text-decoration: underline; text-underline-offset: 3px; }
@media (max-width: 700px) {
  .page-section.contact-faq { padding-bottom: clamp(28px, 6vw, 44px); }
}

/* Editorial numbered rows, divided by hairlines, in place of the old
   boxed/bordered accordion cards. */
.cfaq-list { width: 100%; max-width: none; display: flex; flex-direction: column; }
.cfaq-item { border-bottom: 1px solid var(--c-line); }
.cfaq-item:first-child { border-top: 1px solid var(--c-line); }

.cfaq-item__q {
  width: 100%; display: flex; align-items: center; gap: clamp(16px, 3vw, 32px);
  padding: clamp(20px, 2.8vw, 30px) 2px;
  background: none; border: 0; cursor: pointer; text-align: left;
}
.cfaq-item__num {
  flex: 0 0 auto; min-width: 30px;
  font-family: var(--ff-display); font-style: italic;
  font-size: clamp(14px, 1.6vw, 18px); color: var(--c-tan-2);
  transition: color .3s var(--ease-out);
}
.cfaq-item__question {
  flex: 1 1 auto;
  font-family: var(--ff-display); font-weight: 400;
  font-size: clamp(16.5px, 2vw, 21px); line-height: 1.35;
  color: var(--c-forest);
  transition: color .3s var(--ease-out);
}
.cfaq-item__icon { position: relative; flex: 0 0 auto; width: 26px; height: 26px; }
.cfaq-item__icon-line {
  position: absolute; top: 50%; left: 50%; background: var(--c-forest);
  transition: transform .35s var(--ease-out), opacity .35s var(--ease-out), background .3s var(--ease-out);
}
.cfaq-item__icon-line--h { width: 16px; height: 1px; transform: translate(-50%, -50%); }
.cfaq-item__icon-line--v { width: 1px; height: 16px; transform: translate(-50%, -50%); }
.cfaq-item__q[aria-expanded="true"] .cfaq-item__icon-line--v { transform: translate(-50%, -50%) rotate(90deg); opacity: 0; }
.cfaq-item__q[aria-expanded="true"] .cfaq-item__num,
.cfaq-item__q[aria-expanded="true"] .cfaq-item__question,
.cfaq-item__q[aria-expanded="true"] .cfaq-item__icon-line { color: var(--c-sage); background: var(--c-sage); }
.cfaq-item__q:hover .cfaq-item__question { color: var(--c-sage); }

.cfaq-item__a { max-height: 0; overflow: hidden; transition: max-height .45s var(--ease-out); }
.cfaq-item__a.is-open { max-height: 420px; }
.cfaq-item__a-inner {
  padding: 0 2px clamp(22px, 3vw, 32px) calc(30px + clamp(16px, 3vw, 32px));
  max-width: 62ch; font-size: 16px; line-height: 1.75; color: var(--c-ink-soft);
}
.cfaq-item__a-inner p { margin: 0 0 12px; }
.cfaq-item__a-inner p:last-child { margin-bottom: 0; }

@media (max-width: 640px) {
  .cfaq-item__q { gap: 14px; }
  .cfaq-item__num { min-width: 22px; }
  .cfaq-item__a-inner { padding-left: calc(22px + 14px); }
  .cfaq-item__a.is-open { max-height: 900px; }
}
{% endstylesheet %}

{% javascript %}
document.querySelectorAll('.cfaq-item__q').forEach(function (btn) {
  btn.addEventListener('click', function () {
    var expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    var panel = btn.nextElementSibling;
    if (panel && panel.classList.contains('cfaq-item__a')) {
      panel.classList.toggle('is-open', !expanded);
    }
  });
});
{% endjavascript %}

{% schema %}
{
  "name": "Contact FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "header", "content": "Footer prompt (optional)" },
    { "type": "text", "id": "footer_heading", "label": "Footer heading", "default": "Still have a question?" },
    { "type": "richtext", "id": "footer_body", "label": "Footer body", "default": "<p>We're here to help. Contact us at <a href=\"mailto:support@chemistrieco.com\">support@chemistrieco.com</a> or send us a message using the form above.</p>" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact FAQ"
    }
  ]
}
{% endschema %}
