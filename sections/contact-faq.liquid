<section class="page-section contact-faq" data-screen-label="FAQ">
  <div class="page-section__inner">
    <div class="page-section__head">
      <h2 class="display-h">{{ section.settings.heading }}</h2>
    </div>

    <div class="faq-list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq' -%}
        <div class="faq-item" {{ block.shopify_attributes }}>
          <button class="faq-item__q" type="button" aria-expanded="false">
            <span>{{ block.settings.question }}</span>
            <span class="faq-item__plus" aria-hidden="true">+</span>
          </button>
          <div class="faq-item__a">
            <div class="faq-item__a-inner">{{ block.settings.answer }}</div>
          </div>
        </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.footer_heading != blank or section.settings.footer_body != blank -%}
      <div class="contact-faq__footer">
        {%- if section.settings.footer_heading != blank -%}
          <p class="contact-faq__footer-heading">{{ section.settings.footer_heading }}</p>
        {%- endif -%}
        {%- if section.settings.footer_body != blank -%}
          <p class="contact-faq__footer-body">{{ section.settings.footer_body }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.contact-faq { background: var(--c-cream); }
.contact-faq__footer { text-align: center; margin-top: clamp(32px, 5vw, 52px); }
.contact-faq__footer-heading { margin: 0 0 6px; font-family: var(--ff-display); font-size: clamp(19px, 2vw, 23px); color: var(--c-forest); }
.contact-faq__footer-body { margin: 0; color: var(--c-ink-soft); font-size: 15.5px; }
.contact-faq__footer-body a { color: var(--c-forest); text-decoration: underline; text-underline-offset: 3px; }
@media (max-width: 700px) {
  .page-section.contact-faq { padding-bottom: clamp(28px, 6vw, 44px); }
}
.faq-list { width: 100%; max-width: none; display: flex; flex-direction: column; gap: 12px; }
.faq-item {
  border: 1px solid var(--c-line-soft, rgba(26,58,45,.18));
  border-radius: 14px;
  background: var(--c-cream);
  overflow: hidden;
  transition: background .3s var(--ease-out), border-color .3s var(--ease-out);
}
.faq-item:has(.faq-item__q[aria-expanded="true"]) {
  background: var(--c-paper);
  border-color: var(--c-tan);
}
.faq-item__q {
  width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 20px;
  padding: 20px 24px; background: none; border: 0; cursor: pointer; text-align: left;
  font-family: var(--ff-body); font-size: 15.5px; font-weight: 500;
  color: var(--c-forest);
}
.faq-item__plus {
  flex: 0 0 auto; width: 32px; height: 32px; display: grid; place-items: center;
  border-radius: 999px; background: var(--c-cream);
  font-family: var(--ff-body); font-size: 18px; line-height: 1;
  color: var(--c-tan-2); transition: transform .3s var(--ease-out), background .3s var(--ease-out);
}
.faq-item__q[aria-expanded="true"] .faq-item__plus { transform: rotate(45deg); background: var(--c-cream); }
.faq-item__a {
  max-height: 0; overflow: hidden;
  transition: max-height .45s var(--ease-out);
}
.faq-item__a.is-open { max-height: 400px; }
.faq-item__a-inner { padding: 0 24px 22px; max-width: 68ch; font-size: 16.5px; line-height: 1.7; color: var(--c-ink-soft); }
.faq-item__a-inner p { margin: 0 0 12px; }
.faq-item__a-inner p:last-child { margin-bottom: 0; }
/* Narrow screens wrap longer answers taller — avoid clipping the open panel */
@media (max-width: 640px) {
  .faq-item__q { padding: 16px 18px; }
  .faq-item__a-inner { padding: 0 18px 18px; }
  .faq-item__a.is-open { max-height: 900px; }
}
{% endstylesheet %}

{% javascript %}
document.querySelectorAll('.faq-item__q').forEach(function (btn) {
  btn.addEventListener('click', function () {
    var expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    var panel = btn.nextElementSibling;
    if (panel && panel.classList.contains('faq-item__a')) {
      panel.classList.toggle('is-open', !expanded);
    }
  });
});
{% endjavascript %}

{% schema %}
{
  "name": "Contact FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "header", "content": "Footer prompt (optional)" },
    { "type": "text", "id": "footer_heading", "label": "Footer heading", "default": "Still have a question?" },
    { "type": "richtext", "id": "footer_body", "label": "Footer body", "default": "<p>We're here to help. Contact us at <a href=\"mailto:support@chemistrieco.com\">support@chemistrieco.com</a> or send us a message using the form above.</p>" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact FAQ"
    }
  ]
}
{% endschema %}
