{%- assign cv = product.selected_or_first_available_variant -%}
{%- assign mf = product.metafields.custom -%}

{%- comment -%} Same short Card Copy used on the Homepage/Collection/Ritual product cards, reused here as the hero descriptor so the line matches everywhere it appears instead of the (previously broken) Admin benefit metafield text. {%- endcomment -%}
{%- liquid
  assign _ph0 = product.handle | downcase
  assign _pt0 = product.title | downcase
  if _ph0 contains 'velvet' or _pt0 contains 'velvet'
    assign benefit = 'The step that makes everything after it work harder.'
  elsif _ph0 contains 'veil' or _pt0 contains 'veil'
    assign benefit = 'A featherlight solution that settles into skin like a veil, hydration without a single ounce of weight.'
  elsif _ph0 contains 'cashmere' or _pt0 contains 'cashmere'
    assign benefit = 'Effortless hydration, worn every day without a second thought.'
  elsif _ph0 contains 'aura' or _pt0 contains 'aura'
    assign benefit = 'The signature renewal cream, formulated around a pharmacist-selected peptide complex, for skin that looks and feels quietly renewed.'
  elsif _ph0 contains 'silken' or _pt0 contains 'silken'
    assign benefit = 'A precise, everyday ritual for the areas of skin that deserve focused attention.'
  elsif product.metafields.custom.benefit != blank
    assign benefit = product.metafields.custom.benefit
  else
    assign benefit = product.description | strip_html | split: '. ' | first | append: '.'
  endif
-%}
{%- comment -%} Site-wide rule: no em-dashes in visible copy, even if Admin data has one {%- endcomment -%}
{%- assign benefit = benefit | replace: '—', ',' | replace: ' ,', ',' -%}

{%- comment -%} Routine placement / warnings / feeling / benefits / how-to-use for the buy-box accordion (mirrors product-details.liquid's pd_key match — Shopify sections don't share Liquid scope, so this is intentionally duplicated) {%- endcomment -%}
{%- liquid
  assign _ph = product.handle | downcase
  assign _pt = product.title | downcase
  assign pd_key = ''
  if _ph contains 'velvet' or _pt contains 'velvet'
    assign pd_key = 'velvet'
  elsif _ph contains 'veil' or _pt contains 'veil'
    assign pd_key = 'veil'
  elsif _ph contains 'aura' or _pt contains 'aura'
    assign pd_key = 'aura'
  elsif _ph contains 'cashmere' or _pt contains 'cashmere'
    assign pd_key = 'cashmere'
  elsif _ph contains 'silken' or _pt contains 'silken'
    assign pd_key = 'silken'
  endif
-%}
{%- case pd_key -%}
  {%- when 'velvet' -%}
    {%- assign pd_eyebrow = 'Chemistrie Essentials' -%}
    {%- assign pd_routine_am = 'Velvet (Cleanse) → Veil (Treat) → Cashmere (Moisturize) → Your Own SPF (Protect)' -%}
    {%- assign pd_routine_pm = 'Velvet (Cleanse) → Veil (Treat) → Aura (Renew)' -%}
    {%- capture pd_warnings -%}<ul class="pdet__warnlist">
      <li>For external use only.</li>
      <li>Avoid direct contact with eyes.</li>
      <li>Discontinue use if irritation develops.</li>
      <li>Keep out of reach of children.</li>
    </ul>{%- endcapture -%}
    {%- capture pd_feeling -%}Rich, dense foam that rinses away completely, no film, no residue. Skin feels clean, balanced, and refreshed, never tight or stripped.{%- endcapture -%}
    {%- capture pd_benefits -%}<ul class="pdet__list">
      <li>Lifts away makeup, sunscreen, oil, and daily impurities completely</li>
      <li>Rinses clean with no film or residue left behind</li>
      <li>Prepares skin to receive everything that follows in the ritual</li>
      <li>Suitable for normal, combination, dry, oily, and sensitive skin</li>
    </ul>{%- endcapture -%}
    {%- capture pd_how_to_use -%}<ol class="pdet__list pdet__list--ol">
      <li>Dispense one to two pumps into damp hands.</li>
      <li>Massage gently over a damp face.</li>
      <li>Rinse thoroughly.</li>
      <li>Follow with, in the morning: Veil, Cashmere, Your Own SPF. Follow with, in the evening: Veil, Aura.</li>
    </ol>{%- endcapture -%}
  {%- when 'veil' -%}
    {%- assign pd_eyebrow = 'Chemistrie Essentials' -%}
    {%- assign pd_routine_am = 'Velvet (Cleanse) → Veil (Treat) → Cashmere (Moisturize) → Your Own SPF (Protect)' -%}
    {%- assign pd_routine_pm = 'Velvet (Cleanse) → Veil (Treat) → Aura (Renew)' -%}
    {%- capture pd_warnings -%}<ul class="pdet__warnlist">
      <li>For external use only.</li>
      <li>Avoid direct contact with eyes.</li>
      <li>Discontinue use if irritation develops.</li>
      <li>Keep out of reach of children.</li>
      <li>Patch testing recommended before first use.</li>
      <li>Shake well before use.</li>
      <li>Store away from direct light.</li>
    </ul>{%- endcapture -%}
    {%- capture pd_feeling -%}Fluid. Near-weightless. Almost water-like. Veil absorbs in seconds, with no film, no tack, and no residue, just a soft cushion of hydration beneath everything that follows.{%- endcapture -%}
    {%- capture pd_benefits -%}<ul class="pdet__list">
      <li>Weightless hydration, absorbed in seconds</li>
      <li>Leaves no film, no tack, and no residue behind</li>
      <li>Fragrance-free and suitable for all skin types</li>
      <li>Layers cleanly with the rest of the ritual, morning and evening</li>
    </ul>{%- endcapture -%}
    {%- capture pd_how_to_use -%}<ol class="pdet__list pdet__list--ol">
      <li>After cleansing, dispense one pump into your palm.</li>
      <li>Press gently into face and neck. Do not rub.</li>
      <li>Follow with Cashmere in the morning or Aura in the evening.</li>
    </ol>{%- endcapture -%}
  {%- when 'aura' -%}
    {%- assign pd_eyebrow = 'Chemistrie Signature' -%}
    {%- assign pd_routine_am = blank -%}
    {%- assign pd_routine_pm = 'Velvet (Cleanse) → Veil (Treat) → Aura (Renew)' -%}
    {%- capture pd_warnings -%}<ul class="pdet__warnlist">
      <li>For external use only.</li>
      <li>Avoid direct contact with eyes.</li>
      <li>Discontinue use if irritation develops.</li>
      <li>Keep out of reach of children.</li>
      <li>Patch testing recommended before first use.</li>
    </ul>{%- endcapture -%}
    {%- capture pd_feeling -%}Silky, creamy, fast-absorbing. Naturally blue, straight from the peptide complex itself, not a dye, not a design choice. A soft, velvety finish with no fragrance and no residue.{%- endcapture -%}
    {%- capture pd_benefits -%}<ul class="pdet__list">
      <li>Deep hydration with a visibly smoother finish</li>
      <li>Pharmacist-selected peptide complex</li>
      <li>Fragrance-free and suitable for all skin types</li>
      <li>Silky finish that absorbs completely and never feels heavy</li>
    </ul>{%- endcapture -%}
    {%- capture pd_how_to_use -%}<ol class="pdet__list pdet__list--ol">
      <li>Warm a small amount between your fingertips.</li>
      <li>Press gently into skin (face and neck) until it disappears.</li>
      <li>Follow with sunscreen. Every morning, without exception.</li>
    </ol>{%- endcapture -%}
  {%- when 'cashmere' -%}
    {%- assign pd_eyebrow = 'Chemistrie Essentials' -%}
    {%- assign pd_routine_am = 'Velvet → Veil → Cashmere → Your Own SPF' -%}
    {%- assign pd_routine_pm = 'Velvet → Veil → Aura (Cashmere may also be layered in the evening if additional hydration is desired.)' -%}
    {%- capture pd_warnings -%}<ul class="pdet__warnlist">
      <li>For external use only.</li>
      <li>Avoid direct contact with eyes.</li>
      <li>Discontinue use if irritation develops.</li>
      <li>Keep out of reach of children.</li>
      <li>Patch testing recommended before first use.</li>
    </ul>{%- endcapture -%}
    {%- capture pd_feeling -%}Lightweight lotion. Silky, fast-absorbing, with an elegant slip. Non-greasy and comfortable for all-day wear, soft, hydrated, smooth, never sticky.{%- endcapture -%}
    {%- capture pd_benefits -%}<ul class="pdet__list">
      <li>Provides lightweight daily hydration that absorbs quickly</li>
      <li>Layers beautifully under sunscreen and under makeup</li>
      <li>Leaves skin feeling soft and comfortable, never heavy</li>
      <li>Suitable for all skin types, for everyday use</li>
    </ul>{%- endcapture -%}
    {%- capture pd_how_to_use -%}<ol class="pdet__list pdet__list--ol">
      <li>Apply morning and evening, after serums.</li>
      <li>Massage gently into face and neck until absorbed.</li>
      <li>May be layered before Aura in the evening for extra hydration. This is optional, not a required step.</li>
    </ol>{%- endcapture -%}
  {%- when 'silken' -%}
    {%- assign pd_eyebrow = 'Chemistrie Precision' -%}
    {%- assign pd_routine_am = 'Velvet → Veil → Cashmere → Your Own SPF (apply Silken to targeted areas after Veil and before moisturizer)' -%}
    {%- assign pd_routine_pm = 'Velvet → Veil → Aura (apply Silken to targeted areas after Veil and before moisturizer)' -%}
    {%- capture pd_warnings -%}<ul class="pdet__warnlist">
      <li>For external use only.</li>
      <li>Do not apply to open wounds or broken skin.</li>
      <li>Avoid direct contact with eyes.</li>
      <li>Discontinue use if irritation develops.</li>
      <li>Keep out of reach of children.</li>
    </ul>{%- endcapture -%}
    {%- capture pd_feeling -%}A silky, lightweight gel. Smooth to apply, non-greasy, designed to create a breathable protective layer that stays comfortable through a full day of wear.{%- endcapture -%}
    {%- capture pd_benefits -%}<ul class="pdet__list">
      <li>Helps improve the appearance of scars and uneven skin texture</li>
      <li>Leaves skin feeling smooth, comfortable, and lastingly hydrated</li>
      <li>Creates a breathable protective barrier suitable for daily use</li>
      <li>Suitable for all skin types, on fully healed scars</li>
    </ul>{%- endcapture -%}
    {%- capture pd_how_to_use -%}<ol class="pdet__list pdet__list--ol">
      <li>Apply a thin layer directly to clean, fully healed scars.</li>
      <li>Use morning and evening, as part of a consistent daily rhythm.</li>
      <li>Allow the product to dry completely before applying additional skincare or sunscreen.</li>
    </ol>{%- endcapture -%}
{%- endcase -%}

<section class="page-section mprod">
  <div class="page-section__inner">
    <div class="mprod__layout">

      {%- comment -%} ───── LEFT: gallery ───── {%- endcomment -%}
      <div class="mprod__gallery">
        {%- capture card_asset -%}{%- render 'product-image-asset', product: product -%}{%- endcapture -%}
        {%- assign card_asset = card_asset | strip -%}
        {%- capture gallery_assets -%}{%- render 'product-gallery-images', product: product -%}{%- endcapture -%}
        {%- assign gallery_assets = gallery_assets | strip -%}
        {%- assign gallery_list = blank -%}
        {%- if gallery_assets != blank -%}
          {%- assign gallery_list = gallery_assets | split: ',' -%}
        {%- endif -%}
        {%- comment -%} Liquid's {% if %} has no parentheses for grouping, so this is
          precomputed as a flag rather than written as one compound condition. {%- endcomment -%}
        {%- assign show_main_nav = false -%}
        {%- if gallery_list.size > 1 -%}
          {%- assign show_main_nav = true -%}
        {%- elsif card_asset == blank and product.images.size > 1 -%}
          {%- assign show_main_nav = true -%}
        {%- endif -%}
        <div class="mprod__main">
          {%- if gallery_list.size > 0 -%}
            <img id="mprod-main-image" src="{{ gallery_list.first | asset_url }}" alt="{{ product.title | escape }}">
          {%- elsif card_asset != blank -%}
            <img id="mprod-main-image" src="{{ card_asset | asset_url }}" alt="{{ product.title | escape }}">
          {%- elsif product.featured_image -%}
            <img
              id="mprod-main-image"
              src="{{ product.featured_image | image_url: width: 1800 }}"
              alt="{{ product.featured_image.alt | default: product.title | escape }}"
              width="1000" height="1000">
          {%- else -%}
            <img src="{{ 'stock-product.jpg' | asset_url }}" alt="{{ product.title | escape }}" class="mprod__ph">
            {%- comment -%} Temporary Unsplash stock photo — replace with a real product image in Shopify admin {%- endcomment -%}
          {%- endif -%}
          {%- if show_main_nav -%}
            <button type="button" class="mprod__nav mprod__nav--prev" aria-label="Previous image">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M15 6l-6 6 6 6"/></svg>
            </button>
            <button type="button" class="mprod__nav mprod__nav--next" aria-label="Next image">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 6l6 6-6 6"/></svg>
            </button>
          {%- endif -%}
          {%- comment -%} Hover-zoom lens. Follows the cursor over the image; the
            region it covers is what the panel beside the gallery magnifies. {%- endcomment -%}
          <span class="mprod__lens" id="mprod-lens" aria-hidden="true"></span>
        </div>
        {%- comment -%} Magnified view, shown beside the gallery (over the buy box)
          while hovering the main image. Desktop pointers only. {%- endcomment -%}
        <div class="mprod__zoom" id="mprod-zoom" aria-hidden="true"></div>
        {%- if gallery_list.size > 1 -%}
          <div class="mprod__thumbstrip">
            <button type="button" class="mprod__thumb-nav mprod__thumb-nav--prev" aria-label="Scroll thumbnails left">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M15 6l-6 6 6 6"/></svg>
            </button>
            <div class="mprod__thumbs" id="mprod-thumbs">
              {%- for asset in gallery_list -%}
                <button
                  type="button"
                  class="mprod__thumb {% if forloop.first %}is-active{% endif %}"
                  data-full="{{ asset | asset_url }}"
                  aria-label="View image {{ forloop.index }}">
                  <img src="{{ asset | asset_url }}" alt="" width="160" height="160" loading="lazy">
                </button>
              {%- endfor -%}
            </div>
            <button type="button" class="mprod__thumb-nav mprod__thumb-nav--next" aria-label="Scroll thumbnails right">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 6l6 6-6 6"/></svg>
            </button>
          </div>
        {%- elsif card_asset == blank and product.images.size > 1 -%}
          <div class="mprod__thumbs">
            {%- for image in product.images -%}
              <button
                type="button"
                class="mprod__thumb {% if forloop.first %}is-active{% endif %}"
                data-full="{{ image | image_url: width: 1800 }}"
                aria-label="View image {{ forloop.index }}">
                <img src="{{ image | image_url: width: 160 }}" alt="{{ image.alt | escape }}" width="160" height="160" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ───── RIGHT: buy box ───── {%- endcomment -%}
      <div class="mprod__buy">
        {%- if pd_eyebrow != blank or product.type != blank -%}
          <span class="eyebrow mprod__eyebrow">{{ pd_eyebrow | default: product.type }}</span>
        {%- endif -%}
        <h1 class="display-h mprod__title">{{ product.title | split: '—' | first | strip }}</h1>

        {%- assign pd_subheadline = mf.subheadline | default: product.title | split: '—' | last | strip -%}
        {%- if pd_subheadline != blank -%}
          <p class="mprod__subhead">{{ pd_subheadline }}</p>
        {%- endif -%}

        {%- if benefit != blank -%}
          <p class="mprod__benefit">{{ benefit }}</p>
        {%- endif -%}

        {%- if product.metafields.reviews.rating != blank -%}
        <div class="mprod__rating">
          <span class="mprod__rating-stars" aria-hidden="true">★★★★★</span>
          <span class="mprod__rating-val">{{ product.metafields.reviews.rating.value }}</span>
          {%- if product.metafields.reviews.rating_count != blank -%}
            <span class="mprod__rating-count">({{ product.metafields.reviews.rating_count }} reviews)</span>
          {%- endif -%}
          <a href="#mprod-reviews" class="mprod__rating-link">Read reviews ↓</a>
        </div>
        {%- endif -%}

        <div class="mprod__price">
          <span class="mprod__price-now">{{ cv.price | money }}</span>
          {%- if product.compare_at_price > product.price -%}
            <s class="mprod__price-was">{{ product.compare_at_price | money }}</s>
          {%- endif -%}
        </div>

        <div class="mprod__viewers">
          <span class="mprod__viewers-dot" aria-hidden="true"></span>
          <span><strong>28</strong> people are viewing this right now</span>
        </div>

        {%- form 'product', product, id: 'mprod-form', class: 'mprod__form' -%}
          <div class="mprod__row mprod__row--options">
            {%- if product.variants.size > 1 -%}
              <div class="mprod__variants">
                <span class="mprod__field-label" id="mprod-variant-label">Option</span>
                <div class="mprod__dd" data-variant-dropdown>
                  <select id="mprod-variant" name="id" class="visually-hidden" tabindex="-1" aria-hidden="true">
                    {%- for variant in product.variants -%}
                      <option
                        value="{{ variant.id }}"
                        {% if variant == cv %}selected{% endif %}
                        {% unless variant.available %}disabled{% endunless %}>
                        {{ variant.title }} · {{ variant.price | money }}{% unless variant.available %} (Sold out){% endunless %}
                      </option>
                    {%- endfor -%}
                  </select>
                  <button type="button" class="mprod__dd-toggle" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="mprod-variant-label mprod-variant-toggle-label" id="mprod-variant-toggle">
                    <span class="mprod__dd-toggle-label" id="mprod-variant-toggle-label">{{ cv.title }} · {{ cv.price | money }}</span>
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                  </button>
                  <ul class="mprod__dd-list" role="listbox" hidden>
                    {%- for variant in product.variants -%}
                      <li role="option" class="mprod__dd-option{% if variant == cv %} is-selected{% endif %}{% unless variant.available %} is-disabled{% endunless %}" data-value="{{ variant.id }}" aria-selected="{% if variant == cv %}true{% else %}false{% endif %}">
                        <span>{{ variant.title }} · {{ variant.price | money }}{% unless variant.available %} (Sold out){% endunless %}</span>
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              </div>
            {%- else -%}
              <input type="hidden" name="id" value="{{ cv.id }}">
            {%- endif -%}

            <div class="mprod__qty">
              <label for="mprod-quantity" class="mprod__field-label">Quantity</label>
              <input type="number" id="mprod-quantity" name="quantity" value="1" min="1" class="mprod__qty-input">
            </div>
          </div>

          {%- assign pd_name = product.title | split: '—' | first | strip -%}
          <div class="mprod__row mprod__row--actions">
            {%- if product.available -%}
              <button type="submit" name="add" class="btn btn--primary mprod__add" data-add-to-ritual data-product-name="{{ pd_name | escape }}" aria-label="Add {{ pd_name }} to cart">Add to Ritual</button>
            {%- else -%}
              <button type="submit" name="add" class="btn btn--primary mprod__add" disabled>Sold Out</button>
            {%- endif -%}

            <button class="wish-btn mprod__wish" type="button" data-wishlist-toggle data-handle="{{ product.handle }}" data-title="{{ product.title | escape }}" data-price="{{ cv.price | money }}" data-image="{{ product.featured_image | image_url: width: 200 }}" data-url="{{ product.url }}" aria-label="Save to wishlist">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 20s-7-4.6-7-9.5A3.5 3.5 0 0 1 12 7a3.5 3.5 0 0 1 7 3.5C19 15.4 12 20 12 20Z"/></svg>
              <span>Save to wishlist</span>
            </button>
          </div>
        {%- endform -%}

        {%- unless product.available -%}
          <p class="mprod__soldout-note">{{ pd_name }} is temporarily out of stock. Join the waitlist to hear when it's back.</p>
        {%- endunless -%}

        <ul class="mprod__trust">
          <li>Pharmacist-formulated</li>
          <li>Hand-numbered</li>
          <li>Made in Houston</li>
        </ul>

        {%- comment -%} Routine Placement, Key Benefits, and How to Use now live as always-visible visual sections in product-details.liquid, not hidden in this accordion. Story/Warnings show only if there's content; Feeling always has a fallback. {%- endcomment -%}
          <div class="mprod__info-accordion">
            {%- if product.description != blank -%}
              <div class="mprod__acc-item">
                <button type="button" class="mprod__acc-q" aria-expanded="false" aria-controls="mprod-acc-story">
                  <span class="mprod__acc-label">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M6 4h9l3 3v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z"/><path d="M9 10h6M9 14h6M9 18h3"/></svg>
                    The Full Story
                  </span>
                  <span class="mprod__acc-icon" aria-hidden="true">
                    <span class="mprod__acc-icon-line mprod__acc-icon-line--h"></span>
                    <span class="mprod__acc-icon-line mprod__acc-icon-line--v"></span>
                  </span>
                </button>
                <div class="mprod__acc-a" id="mprod-acc-story">
                  <div class="rte mprod__acc-a-inner">{{ product.description }}</div>
                </div>
              </div>
            {%- endif -%}

            {%- if pd_warnings != blank -%}
              <div class="mprod__acc-item">
                <button type="button" class="mprod__acc-q" aria-expanded="false" aria-controls="mprod-acc-warnings">
                  <span class="mprod__acc-label">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 3 2 21h20L12 3Z"/><path d="M12 10v4"/><circle cx="12" cy="17" r=".6" fill="currentColor" stroke="none"/></svg>
                    Warnings
                  </span>
                  <span class="mprod__acc-icon" aria-hidden="true">
                    <span class="mprod__acc-icon-line mprod__acc-icon-line--h"></span>
                    <span class="mprod__acc-icon-line mprod__acc-icon-line--v"></span>
                  </span>
                </button>
                <div class="mprod__acc-a" id="mprod-acc-warnings">
                  <div class="mprod__acc-a-inner">{{ pd_warnings }}</div>
                </div>
              </div>
            {%- endif -%}

            <div class="mprod__acc-item">
              <button type="button" class="mprod__acc-q" aria-expanded="false" aria-controls="mprod-acc-feeling">
                <span class="mprod__acc-label">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 21s-7-4.35-7-10.5A4.5 4.5 0 0 1 12 6a4.5 4.5 0 0 1 7 4.5C19 16.65 12 21 12 21Z"/></svg>
                  The Feeling
                </span>
                <span class="mprod__acc-icon" aria-hidden="true">
                    <span class="mprod__acc-icon-line mprod__acc-icon-line--h"></span>
                    <span class="mprod__acc-icon-line mprod__acc-icon-line--v"></span>
                  </span>
              </button>
              <div class="mprod__acc-a" id="mprod-acc-feeling">
                <div class="mprod__acc-a-inner">
                  <p>
                    {%- if mf.feeling != blank -%}
                      {{ mf.feeling | replace: '—', ',' }}
                    {%- elsif pd_feeling != blank -%}
                      {{ pd_feeling }}
                    {%- else -%}
                      A quiet ritual of care. {{ product.title }} is compounded by hand in small batches so every application feels deliberate, clean, and calm, never rushed, never generic.
                    {%- endif -%}
                  </p>
                </div>
              </div>
            </div>

          </div>
      </div>

    </div>
  </div>

  <div class="mprod__toast" data-cart-toast role="status" aria-live="polite" hidden></div>
</section>

{% stylesheet %}
/* .page-section's generic padding shorthand (up to 160px top) was winning over this section's
   own intended top spacing due to equal specificity + later file load order — pin it down with
   a compound selector so it always wins regardless of stylesheet order. */
.page-section.mprod { padding-top: clamp(20px, 3vw, 40px); padding-bottom: clamp(20px, 3vw, 40px); }
.mprod__layout { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 80px); align-items: start; }
/* No inset frame: the photos are shot on their own background, so the
   paper-coloured padding that used to sit behind them read as a second,
   mismatched border around the shot. The image fills the box.
   object-fit stays contain — the zoom's paintedRect() assumes it, and it
   keeps a non-square upload letterboxed rather than cropped. */
.mprod__main {
  position: relative; border-radius: 16px; overflow: hidden; aspect-ratio: 1/1;
  border: 1px solid var(--c-line-soft);
}
.mprod__main img, .mprod__ph { width: 100%; height: 100%; object-fit: contain; display: block; }
.mprod__nav {
  position: absolute; top: 50%; transform: translateY(-50%); z-index: 2;
  width: 40px; height: 40px; border-radius: 50%; border: 0;
  background: rgba(249,244,237,.9); color: var(--c-forest);
  display: grid; place-items: center; cursor: pointer;
  opacity: 0; transition: opacity .3s var(--ease-out), background .3s var(--ease-out);
  backdrop-filter: blur(6px);
}
.mprod__main:hover .mprod__nav { opacity: 1; }
.mprod__nav:hover { background: var(--c-cream); }

/* ── Hover zoom: lens over the image + magnified panel beside it ──
   Both are driven from JS (see initProductZoom below), which sizes the
   lens to exactly the region the panel shows, so the two always agree. */
.mprod__lens {
  position: absolute;
  display: none;
  pointer-events: none;
  z-index: 4;
  border: 1px solid rgba(26,58,45,.45);
  background: rgba(249,244,237,.22);
  box-sizing: border-box;
}
.mprod__zoom {
  position: absolute;
  top: 0;
  left: calc(100% + clamp(32px, 5vw, 80px));
  width: 525px;
  height: 525px;
  display: none;
  z-index: 30;
  border-radius: 16px;
  border: 1px solid var(--c-line-soft);
  background-color: var(--c-paper);
  background-repeat: no-repeat;
  box-shadow: 0 30px 70px -30px rgba(26,58,45,.4);
}
.mprod__gallery.is-zooming .mprod__lens,
.mprod__gallery.is-zooming .mprod__zoom { display: block; }
.mprod__gallery.is-zooming .mprod__main { cursor: crosshair; }
/* No hover zoom without a precise pointer, or where the panel has no
   room to sit beside the gallery. */
@media (hover: none), (pointer: coarse), (max-width: 1024px) {
  .mprod__lens, .mprod__zoom { display: none !important; }
}
.mprod__nav--prev { left: 14px; }
.mprod__nav--next { right: 14px; }
@media (hover: none) { .mprod__nav { opacity: 1; } }

.mprod__thumbs { display: flex; justify-content: center; gap: 12px; margin-top: 14px; flex-wrap: wrap; }
.mprod__thumb {
  width: 76px; height: 76px; border-radius: 10px; overflow: hidden;
  border: 1px solid var(--c-line-soft); cursor: pointer; padding: 0; background: none;
  transition: border-color .3s;
}
.mprod__thumb.is-active { border-color: var(--c-forest); }
.mprod__thumb img { width: 100%; height: 100%; object-fit: cover; }

/* Foxtale-style thumbnail strip: side scroll arrows flanking a row of
   thumbnails, instead of the plain wrapping row above (still used by
   the product.images fallback for products without a curated gallery). */
.mprod__thumbstrip { display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 14px; }
.mprod__thumbstrip .mprod__thumbs {
  margin-top: 0; flex-wrap: nowrap; overflow-x: auto; scroll-behavior: smooth;
  /* "safe" so a short row centres under the main image, but a row long
     enough to scroll falls back to start-aligned and the first thumb
     stays reachable instead of overflowing off the left edge. */
  justify-content: safe center;
  scrollbar-width: none;
}
.mprod__thumbstrip .mprod__thumbs::-webkit-scrollbar { display: none; }
.mprod__thumbstrip .mprod__thumb { flex: 0 0 76px; }
.mprod__thumb-nav {
  flex: 0 0 auto; width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--c-line-soft);
  background: var(--c-cream); color: var(--c-forest);
  display: grid; place-items: center; cursor: pointer;
  transition: border-color .3s var(--ease-out), background .3s var(--ease-out);
}
.mprod__thumb-nav:hover { background: var(--c-paper); border-color: var(--c-forest); }
.mprod__thumb-nav[disabled] { opacity: .35; cursor: default; pointer-events: none; }

/* Image stays pinned in the viewport; the buy box is normal flow so it naturally
   scrolls past underneath — the row's height (set by the taller buy-box column,
   now that it holds 6 accordion items) is what gives the sticky image room to stay put. */
/* position:sticky always creates a stacking context, so .mprod__zoom's own
   z-index is scoped inside this element — without raising the gallery
   itself, the buy box (a later sibling) paints over the zoom panel.
   Only lifted while zooming, and kept under the nav's z-index of 40. */
.mprod__gallery { position: sticky; top: 100px; align-self: start; z-index: 1; }
.mprod__gallery.is-zooming { z-index: 20; }
.mprod__buy { align-self: start; }
.mprod__eyebrow { display: inline-block; margin-bottom: 14px; color: var(--c-tan); }
.mprod__title { margin: 0 0 8px; }
.mprod__subhead { font-family: var(--ff-body); font-size: 13px; letter-spacing: .1em; text-transform: uppercase; color: var(--c-tan-2); margin: 0 0 16px; }
.mprod__benefit { font-family: var(--ff-display); font-size: 20px; font-style: italic; color: var(--c-ink-soft); margin: 0 0 22px; max-width: none; }

.mprod__rating { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin: 0 0 18px; font-size: 13px; color: var(--c-ink-mute); }
.mprod__rating-stars { color: var(--c-tan); letter-spacing: .08em; font-size: 13px; }
.mprod__rating-val { font-family: var(--ff-display); font-size: 16px; font-weight: 500; color: var(--c-forest); }
.mprod__rating-sep { color: var(--c-line-soft); }
.mprod__rating-link { color: var(--c-forest); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--c-line-soft); transition: text-decoration-color .3s var(--ease-out); }
.mprod__rating-link:hover { text-decoration-color: var(--c-forest); }

.mprod__price { display: flex; align-items: baseline; gap: 12px; margin-bottom: 20px; }

.mprod__viewers {
  display: flex; align-items: center; gap: 9px; margin: 0 0 26px;
  font-size: 12.5px; color: var(--c-ink-mute);
}
.mprod__viewers strong { color: var(--c-forest); font-weight: 600; }
.mprod__viewers-dot {
  position: relative; width: 8px; height: 8px; border-radius: 50%; background: var(--c-forest); flex: 0 0 auto;
}
.mprod__viewers-dot::after {
  content: ''; position: absolute; inset: -4px; border-radius: 50%; border: 1px solid var(--c-forest);
  animation: mprodPulse 1.8s ease-out infinite;
}
@keyframes mprodPulse {
  0% { transform: scale(.6); opacity: .8; }
  100% { transform: scale(1.8); opacity: 0; }
}
@media (prefers-reduced-motion: reduce) { .mprod__viewers-dot::after { animation: none; } }
.mprod__price-now { font-size: 24px; color: var(--c-forest); font-weight: 500; }
.mprod__price-was { font-size: 17px; color: var(--c-ink-mute); }

.mprod__form { display: flex; flex-direction: column; gap: 18px; }
.mprod__field-label { display: block; font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--c-ink-mute); margin-bottom: 8px; }
.mprod__qty-input {
  padding: 9px 12px; border: 1px solid var(--c-line-soft); border-radius: 8px;
  background: var(--c-cream); font-size: 13.5px; color: var(--c-forest); font-family: var(--ff-body);
  width: 100%;
}

.mprod__dd { position: relative; }
.mprod__dd-toggle {
  width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 10px;
  padding: 12px 14px; border: 1px solid var(--c-line-soft); border-radius: 8px;
  background: var(--c-cream); font-size: 15px; color: var(--c-forest); font-family: var(--ff-body);
  cursor: pointer; transition: border-color .2s;
}
.mprod__dd-toggle:hover { border-color: var(--c-forest); }
.mprod__dd[data-open="true"] .mprod__dd-toggle { border-color: var(--c-forest); }
.mprod__dd[data-open="true"] .mprod__dd-toggle svg { transform: rotate(180deg); }
.mprod__dd-toggle svg { flex: 0 0 auto; color: var(--c-tan-2); transition: transform .2s; }
.mprod__dd-list {
  position: absolute; left: 0; right: 0; top: calc(100% + 6px); z-index: 20;
  background: var(--c-cream); border: 1px solid var(--c-line-soft); border-radius: 8px;
  box-shadow: 0 16px 32px -12px rgba(26,58,45,.28); overflow: hidden; padding: 6px;
  list-style: none; margin: 0;
}
.mprod__dd-option {
  padding: 10px 12px; border-radius: 6px; font-size: 14px; color: var(--c-forest);
  cursor: pointer; transition: background .15s;
}
.mprod__dd-option:hover, .mprod__dd-option.is-active { background: var(--c-cream-2); }
.mprod__dd-option.is-selected { background: var(--c-forest); color: var(--c-cream); font-weight: 500; }
.mprod__dd-option.is-disabled { color: var(--c-ink-mute); cursor: default; text-decoration: line-through; }
.mprod__dd-option.is-disabled:hover { background: none; }

.mprod__row { display: flex; gap: 16px; }
.mprod__row--options { align-items: flex-end; }
.mprod__row--options .mprod__variants { flex: 1 1 auto; min-width: 0; }
.mprod__row--options .mprod__qty { flex: 0 0 108px; }
.mprod__row--options input[type="hidden"] ~ .mprod__qty { flex: 1 1 auto; }

.mprod__row--actions { align-items: stretch; }
.mprod__row--actions .mprod__add { flex: 1 1 auto; width: auto; margin: 0; }
.btn.mprod__add { padding: 13px 22px; font-size: 11px; }
.mprod__add[disabled] { opacity: .5; cursor: default; }
.mprod__soldout-note { margin: 14px 0 0; font-size: 13px; color: var(--c-ink-soft); line-height: 1.6; }

.mprod__toast {
  position: fixed; left: 50%; bottom: 32px; transform: translate(-50%, 12px);
  background: var(--c-forest); color: var(--c-cream); padding: 14px 22px; border-radius: 999px;
  font-size: 14px; box-shadow: 0 20px 40px -16px rgba(26,58,45,.5);
  z-index: 60; opacity: 0; transition: opacity .3s var(--ease-out), transform .3s var(--ease-out);
  pointer-events: none;
}
.mprod__toast.is-visible { opacity: 1; transform: translate(-50%, 0); }
.mprod__toast.is-error { background: #7a2b2b; }
.mprod__row--actions .mprod__wish { margin-top: 0; flex: 0 0 auto; }

@media (max-width: 480px) {
  .mprod__row--options, .mprod__row--actions { flex-direction: column; align-items: stretch; }
  .mprod__row--options .mprod__qty { flex: 1 1 auto; }
  .mprod__row--actions .mprod__wish { justify-content: center; }
}

/* Three static badges rather than a run of faint middot-separated text —
   picks up the pill shape already used by the theme's buttons. Not
   interactive: no hover, cursor or focus treatment, so they never read
   as something you can click. */
.mprod__trust {
  list-style: none; margin: 26px 0 0; padding: 22px 0 0; border-top: 1px solid var(--c-line-soft);
  display: flex; flex-wrap: wrap; gap: 10px;
}
.mprod__trust li {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 9px 16px; border-radius: 999px;
  border: 1px solid var(--c-tan-3); background: var(--c-cream);
  font-size: 10.5px; letter-spacing: .16em; text-transform: uppercase;
  color: var(--c-forest); white-space: nowrap;
}
.mprod__trust li::before {
  content: ''; flex: 0 0 auto;
  width: 5px; height: 5px; border-radius: 50%; background: var(--c-tan);
}

@media (max-width: 860px) {
  .mprod__layout { grid-template-columns: 1fr; }
  .mprod__gallery { position: static; }
}

/* Buy-box accordion (The Full Story / Warnings / The Feeling).
   Editorial hairline rows, matching the FAQ pattern already used on the
   Contact and Ritual pages (.cfaq-item / .rfaq-item), instead of three
   separate boxed cards: serif labels, a plus that morphs into a minus,
   and a sage accent on the open row. */
.mprod__info-accordion { margin-top: clamp(28px, 3vw, 44px); display: flex; flex-direction: column; }
.mprod__acc-item { border-bottom: 1px solid var(--c-line); }
.mprod__acc-item:first-child { border-top: 1px solid var(--c-line); }

.mprod__acc-q {
  width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 16px;
  padding: clamp(16px, 2vw, 22px) 2px;
  background: none; border: 0; text-align: left; cursor: pointer;
}
.mprod__acc-label {
  display: flex; align-items: center; gap: 14px;
  font-family: var(--ff-display); font-weight: 400;
  font-size: clamp(16px, 1.8vw, 19px); line-height: 1.3;
  color: var(--c-forest-2); transition: color .3s var(--ease-out);
}
.mprod__acc-label svg {
  flex: 0 0 auto; width: 17px; height: 17px;
  color: var(--c-tan-2); transition: color .3s var(--ease-out);
}
/* Bronze on hover instead of the washed-out sage. The open row keeps the
   deep heading colour and accents the icon instead — bronze sits at ~2.6:1
   on this cream, fine for a transient hover but too low to leave a label
   sitting in while the panel is read. */
.mprod__acc-q:hover .mprod__acc-label,
.mprod__acc-q:hover .mprod__acc-label svg { color: var(--c-tan-2); }

.mprod__acc-icon { position: relative; flex: 0 0 auto; width: 24px; height: 24px; }
.mprod__acc-icon-line {
  position: absolute; top: 50%; left: 50%; background: var(--c-forest);
  transition: transform .35s var(--ease-out), opacity .35s var(--ease-out), background .3s var(--ease-out);
}
.mprod__acc-icon-line--h { width: 15px; height: 1px; transform: translate(-50%, -50%); }
.mprod__acc-icon-line--v { width: 1px; height: 15px; transform: translate(-50%, -50%); }
.mprod__acc-q[aria-expanded="true"] .mprod__acc-icon-line--v { transform: translate(-50%, -50%) rotate(90deg); opacity: 0; }
.mprod__acc-q[aria-expanded="true"] .mprod__acc-label { color: var(--c-forest-2); }
.mprod__acc-q[aria-expanded="true"] .mprod__acc-label svg { color: var(--c-tan-2); }
.mprod__acc-q[aria-expanded="true"] .mprod__acc-icon-line { background: var(--c-tan-2); }

.mprod__acc-a { max-height: 0; overflow: hidden; transition: max-height .4s var(--ease-out); }
/* Longer entries (The Full Story on most products) run past the panel's
   height and used to be silently cut off with no way to reach the rest —
   scroll the overflow instead of clipping it. */
.mprod__acc-a.is-open { max-height: 460px; overflow-y: auto; overscroll-behavior: contain; }
.mprod__acc-a.is-open::-webkit-scrollbar { width: 6px; }
.mprod__acc-a.is-open::-webkit-scrollbar-thumb { background: var(--c-line); border-radius: 999px; }
.mprod__acc-a.is-open::-webkit-scrollbar-track { background: transparent; }

/* Indent the body to sit under the label text, not the icon. */
.mprod__acc-a-inner {
  padding: 0 2px clamp(18px, 2.2vw, 26px) 31px;
  font-size: 15.5px; line-height: 1.75; color: var(--c-ink-soft);
}
.mprod__acc-a-inner p { margin: 0 0 12px; }
.mprod__acc-a-inner p:last-child { margin-bottom: 0; }
.mprod__acc-a-inner strong { color: var(--c-forest); font-weight: 500; }
.mprod__acc-a-inner em { color: var(--c-ink-mute); }
/* Product descriptions carry their own headings, lists and FAQ blocks — give
   them a consistent rhythm instead of leaving them at browser defaults. */
.mprod__acc-a-inner h2,
.mprod__acc-a-inner h3,
.mprod__acc-a-inner h4 {
  font-family: var(--ff-display); font-weight: 400;
  font-size: clamp(15px, 1.5vw, 17px); line-height: 1.35;
  color: var(--c-forest); margin: 22px 0 8px;
}
.mprod__acc-a-inner > :first-child { margin-top: 0; }
.mprod__acc-a-inner ul,
.mprod__acc-a-inner ol { margin: 0 0 12px; padding-left: 18px; }
.mprod__acc-a-inner li { margin: 0 0 8px; }
.mprod__acc-a-inner li:last-child { margin-bottom: 0; }
.mprod__acc-a-inner ul { list-style: none; padding-left: 0; }
.mprod__acc-a-inner ul li { position: relative; padding-left: 16px; }
.mprod__acc-a-inner ul li::before {
  content: ''; position: absolute; left: 0; top: .72em;
  width: 5px; height: 1px; background: var(--c-tan);
}
{% endstylesheet %}

{% javascript %}
(function () {
  var main = document.getElementById('mprod-main-image');
  var thumbs = document.querySelectorAll('.mprod__thumb');

  function activate(index) {
    var t = thumbs[index];
    if (!t) return;
    var full = t.getAttribute('data-full');
    if (main && full) main.src = full;
    thumbs.forEach(function (x) { x.classList.remove('is-active'); });
    t.classList.add('is-active');
  }

  thumbs.forEach(function (t, i) {
    t.addEventListener('click', function () { activate(i); });
  });

  // Thumbnail strip side arrows — scroll the row, separate from the
  // main-image prev/next below (those swap the displayed image).
  var thumbTrack = document.getElementById('mprod-thumbs');
  var thumbPrev = document.querySelector('.mprod__thumb-nav--prev');
  var thumbNext = document.querySelector('.mprod__thumb-nav--next');
  if (thumbTrack && thumbPrev && thumbNext) {
    var scrollThumbs = function (dir) {
      var step = (thumbTrack.querySelector('.mprod__thumb') || {}).offsetWidth || 76;
      thumbTrack.scrollBy({ left: dir * (step + 12) * 2, behavior: 'smooth' });
    };
    var updateThumbNavState = function () {
      var max = thumbTrack.scrollWidth - thumbTrack.clientWidth - 1;
      thumbPrev.disabled = thumbTrack.scrollLeft <= 0;
      thumbNext.disabled = thumbTrack.scrollLeft >= max;
    };
    thumbPrev.addEventListener('click', function () { scrollThumbs(-1); });
    thumbNext.addEventListener('click', function () { scrollThumbs(1); });
    thumbTrack.addEventListener('scroll', updateThumbNavState, { passive: true });
    updateThumbNavState();
  }

  // Hover zoom — a lens follows the cursor over the main image and the panel
  // beside the gallery shows exactly that region, magnified.
  (function initProductZoom() {
    var gallery = document.querySelector('.mprod__gallery');
    var box = document.querySelector('.mprod__main');
    var lens = document.getElementById('mprod-lens');
    var panel = document.getElementById('mprod-zoom');
    if (!gallery || !box || !lens || !panel || !main) return;

    var ZOOM = 2.6;
    var fine = window.matchMedia('(hover: hover) and (pointer: fine)');
    function enabled() { return fine.matches && window.innerWidth > 1024; }

    // The image is object-fit:contain, so the picture rarely fills its box —
    // work out where it actually sits, otherwise the lens and the magnified
    // view drift apart on any image that isn't square.
    function paintedRect() {
      var r = main.getBoundingClientRect();
      var nw = main.naturalWidth, nh = main.naturalHeight;
      if (!nw || !nh || !r.width || !r.height) return null;
      var scale = Math.min(r.width / nw, r.height / nh);
      var w = nw * scale, h = nh * scale;
      return { left: r.left + (r.width - w) / 2, top: r.top + (r.height - h) / 2, width: w, height: h };
    }

    function hide() { gallery.classList.remove('is-zooming'); }

    function track(e) {
      if (!enabled()) { hide(); return; }
      var img = paintedRect();
      if (!img) { hide(); return; }

      var x = e.clientX - img.left, y = e.clientY - img.top;
      if (x < 0 || y < 0 || x > img.width || y > img.height) { hide(); return; }

      // Reveal before measuring: the panel is display:none until this class
      // lands, and a display:none element reports clientWidth/Height of 0 —
      // measuring first would bail out here every time and never show it.
      gallery.classList.add('is-zooming');

      var pw = panel.clientWidth, ph = panel.clientHeight;
      if (!pw || !ph) { hide(); return; }

      // Never magnify past the source's own pixels. Above 1:1 native the
      // browser is just interpolating and the zoom goes soft — this is what
      // made it look blurry at a flat 2.6x on a 1536px-wide photo shown ~630px
      // wide. Cap the factor at the image's real resolution instead.
      var native = main.naturalWidth / img.width;
      var factor = Math.max(1.2, Math.min(ZOOM, native));

      // Lens covers exactly what the panel can show at this magnification.
      var lw = Math.min(pw / factor, img.width);
      var lh = Math.min(ph / factor, img.height);

      var lx = Math.max(0, Math.min(x - lw / 2, img.width - lw));
      var ly = Math.max(0, Math.min(y - lh / 2, img.height - lh));

      var boxRect = box.getBoundingClientRect();
      lens.style.width = lw + 'px';
      lens.style.height = lh + 'px';
      lens.style.left = (img.left - boxRect.left + lx) + 'px';
      lens.style.top = (img.top - boxRect.top + ly) + 'px';

      // Scale the backdrop so the lens region fills the panel exactly.
      var fx = pw / lw, fy = ph / lh;
      panel.style.backgroundImage = 'url("' + (main.currentSrc || main.src) + '")';
      panel.style.backgroundSize = (img.width * fx) + 'px ' + (img.height * fy) + 'px';
      panel.style.backgroundPosition = (-lx * fx) + 'px ' + (-ly * fy) + 'px';
    }

    box.addEventListener('mouseenter', track);
    box.addEventListener('mousemove', track);
    box.addEventListener('mouseleave', hide);
    window.addEventListener('resize', hide, { passive: true });
  })();

  // Prev/next arrows on the main image, shown on hover — cycle through the same thumbnail list
  var prevBtn = document.querySelector('.mprod__nav--prev');
  var nextBtn = document.querySelector('.mprod__nav--next');
  function currentIndex() {
    var found = 0;
    thumbs.forEach(function (t, i) { if (t.classList.contains('is-active')) found = i; });
    return found;
  }
  if (prevBtn) prevBtn.addEventListener('click', function () {
    activate((currentIndex() - 1 + thumbs.length) % thumbs.length);
  });
  if (nextBtn) nextBtn.addEventListener('click', function () {
    activate((currentIndex() + 1) % thumbs.length);
  });

  // Keep hidden/select variant id in sync with price display (single-select variant case)
  var select = document.getElementById('mprod-variant');
  if (select) {
    select.addEventListener('change', function () {
      var opt = select.options[select.selectedIndex];
      var priceEl = document.querySelector('.mprod__price-now');
      var match = opt.textContent.trim().match(/·\s*(.+?)(?:\s*\(|$)/);
      if (priceEl && match) priceEl.textContent = match[1].trim();
    });
  }

  // Custom themed variant dropdown, drives the hidden <select> above
  var dd = document.querySelector('[data-variant-dropdown]');
  if (dd && select) {
    var toggle = dd.querySelector('.mprod__dd-toggle');
    var toggleLabel = dd.querySelector('.mprod__dd-toggle-label');
    var list = dd.querySelector('.mprod__dd-list');
    var options = Array.prototype.slice.call(dd.querySelectorAll('.mprod__dd-option'));

    function closeDd() {
      dd.removeAttribute('data-open');
      toggle.setAttribute('aria-expanded', 'false');
      list.hidden = true;
    }
    function openDd() {
      dd.setAttribute('data-open', 'true');
      toggle.setAttribute('aria-expanded', 'true');
      list.hidden = false;
    }

    toggle.addEventListener('click', function () {
      if (list.hidden) openDd(); else closeDd();
    });

    options.forEach(function (opt) {
      opt.addEventListener('click', function () {
        if (opt.classList.contains('is-disabled')) return;
        options.forEach(function (o) {
          o.classList.remove('is-selected');
          o.setAttribute('aria-selected', 'false');
        });
        opt.classList.add('is-selected');
        opt.setAttribute('aria-selected', 'true');
        toggleLabel.textContent = opt.textContent.trim();
        select.value = opt.getAttribute('data-value');
        select.dispatchEvent(new Event('change', { bubbles: true }));
        closeDd();
      });
    });

    document.addEventListener('click', function (e) {
      if (!dd.contains(e.target)) closeDd();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeDd();
    });
  }

  // Left-column accordion (Routine Placement / The Full Story / Warnings)
  document.querySelectorAll('.mprod__acc-q').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      var panel = document.getElementById(btn.getAttribute('aria-controls'));
      if (panel) panel.classList.toggle('is-open', !open);
    });
  });

  // Add to Ritual — AJAX add-to-cart with per-product "[Name] is in your ritual." / out-of-stock microcopy
  var form = document.getElementById('mprod-form');
  var addBtn = document.querySelector('[data-add-to-ritual]');
  var toastEl = document.querySelector('[data-cart-toast]');
  var toastTimer;

  function showToast(message, isError) {
    if (!toastEl) return;
    toastEl.textContent = message;
    toastEl.classList.toggle('is-error', !!isError);
    toastEl.hidden = false;
    requestAnimationFrame(function () { toastEl.classList.add('is-visible'); });
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function () {
      toastEl.classList.remove('is-visible');
      setTimeout(function () { toastEl.hidden = true; }, 300);
    }, 3200);
  }

  if (form && addBtn) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var name = addBtn.getAttribute('data-product-name') || 'Item';
      addBtn.disabled = true;
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({
          id: new FormData(form).get('id'),
          quantity: new FormData(form).get('quantity') || 1
        })
      })
        .then(function (res) { return res.json().then(function (data) { return { ok: res.ok, data: data }; }); })
        .then(function (result) {
          if (!result.ok) {
            showToast(name + ' is temporarily out of stock. Join the waitlist to hear when it\'s back.', true);
            return;
          }
          showToast(name + ' is in your ritual.');
          return fetch('/cart.js').then(function (r) { return r.json(); }).then(function (cart) {
            var countEl = document.querySelector('.nav__bag-count');
            if (countEl) countEl.textContent = cart.item_count;
          });
        })
        .catch(function () {
          showToast(name + ' is temporarily out of stock. Join the waitlist to hear when it\'s back.', true);
        })
        .finally(function () {
          addBtn.disabled = false;
        });
    });
  }
})();
{% endjavascript %}

