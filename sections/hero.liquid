<!-- ───── Hero — Modern split ───── -->
<section class="hero" data-screen-label="01 Hero">
  <div class="hero__bg">
    <div class="hero__blob hero__blob--sage"></div>
    <div class="hero__blob hero__blob--tan"></div>
    <div class="hero__noise"></div>
  </div>

  <!-- Main split -->
  <div class="hero__inner">
    <!-- Left: copy -->
    <div class="hero__copy">
      <h1 class="hero__title" aria-label="{{ section.settings.title_aria }}">
        {%- comment -%}
          Stripped before testing, not just `!= blank`. Liquid treats only an
          empty string or nil as blank, so a field holding a space or a stray
          newline passes the test and renders an empty row - which at this type
          size with line-height 1 is a ~66px hole under the headline. That is
          exactly what was sitting between the headline and the deck.
        {%- endcomment -%}
        {%- liquid
          assign t_word_1 = section.settings.title_word_1 | strip
          assign t_em_1 = section.settings.title_em_1 | strip
          assign t_row_2 = section.settings.title_row_2 | strip
          assign t_accent = section.settings.title_em_accent | strip
        -%}
        {%- if t_word_1 != blank or t_em_1 != blank -%}
          <span class="hero__title-row">
            {%- if t_word_1 != blank -%}<span class="hero__title-word">{{ t_word_1 }}</span>{%- endif -%}
            {%- if t_em_1 != blank -%}{%- if t_word_1 != blank -%}{{ ' ' }}{%- endif -%}<em class="hero__title-em">{{ t_em_1 }}</em>{%- endif -%}
          </span>
        {%- endif -%}
        {%- if t_row_2 != blank -%}
          <span class="hero__title-row">
            <span class="hero__title-word">{{ t_row_2 }}</span>
          </span>
        {%- endif -%}
        {%- if t_accent != blank -%}
          <span class="hero__title-row">
            <em class="hero__title-em hero__title-em--accent">{{ t_accent }}</em>
          </span>
        {%- endif -%}
      </h1>

      <p class="hero__deck">
        {{ section.settings.deck }}
      </p>

      <div class="hero__cta-row">
        <a class="hero__cta-primary" href="{{ section.settings.cta_primary_link }}">
          <span>{{ section.settings.cta_primary_label }}</span>
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>

      <!-- Trust strip -->
      <div class="hero__trust">
        <div class="hero__trust-item">
          <span class="hero__trust-num">{{ section.settings.trust1_num }}</span>
          <span class="hero__trust-label">{{ section.settings.trust1_label }}</span>
        </div>
        <div class="hero__trust-divider"></div>
        <div class="hero__trust-item">
          <span class="hero__trust-num">{{ section.settings.trust2_num }}</span>
          <span class="hero__trust-label">{{ section.settings.trust2_label }}</span>
        </div>
        <div class="hero__trust-divider"></div>
        <div class="hero__trust-item">
          <span class="hero__trust-num">{{ section.settings.trust3_num }}</span>
          <span class="hero__trust-label">{{ section.settings.trust3_label }}</span>
        </div>
      </div>
    </div>

    <!-- Right: visual stage -->
    <div class="hero__stage">
      <div class="hero__visual-frame">
        {%- if section.settings.hero_image != blank -%}
          {{ section.settings.hero_image | image_url: width: 1200 | image_tag: class: 'hero__visual-img', loading: 'eager', fetchpriority: 'high', decoding: 'async', widths: '400,600,800,1024,1200', alt: section.settings.title_aria | escape }}
        {%- elsif section.settings.hero_fallback_asset != blank -%}
          <img class="hero__visual-img" src="{{ section.settings.hero_fallback_asset | asset_url }}" alt="{{ section.settings.title_aria | escape }}" loading="eager" fetchpriority="high" decoding="async" width="1024" height="493">
        {%- else -%}
          <img class="hero__visual-img" src="{{ 'hero-home.jpg' | asset_url }}" alt="{{ section.settings.title_aria | escape }}" loading="eager" fetchpriority="high" decoding="async" width="1024" height="493">
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "title_aria",
      "label": "Title (accessibility label)",
      "default": "Skincare formulated by pharmacists. Five essentials."
    },
    {
      "type": "text",
      "id": "title_word_1",
      "label": "Title row 1 word",
      "default": "Skincare formulated"
    },
    {
      "type": "text",
      "id": "title_em_1",
      "label": "Title row 1 emphasis",
      "default": "by pharmacists."
    },
    {
      "type": "html",
      "id": "title_row_2",
      "label": "Title row 2 (inline HTML)",
      "default": "Five essentials."
    },
    {
      "type": "text",
      "id": "title_em_accent",
      "label": "Title row 3 accent"
    },
    {
      "type": "textarea",
      "id": "deck",
      "label": "Deck paragraph",
      "default": "A simple daily routine of cleanser, serum, lotion and creams, made by licensed pharmacists."
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary CTA label",
      "default": "Find your ritual"
    },
    {
      "type": "text",
      "id": "cta_primary_link",
      "label": "Primary CTA link",
      "default": "/pages/the-ritual"
    },
    {
      "type": "text",
      "id": "trust1_num",
      "label": "Trust stat 1 number",
      "default": "2,400+"
    },
    {
      "type": "text",
      "id": "trust1_label",
      "label": "Trust stat 1 label",
      "default": "Women on the list"
    },
    {
      "type": "text",
      "id": "trust2_num",
      "label": "Trust stat 2 number",
      "default": "28"
    },
    {
      "type": "text",
      "id": "trust2_label",
      "label": "Trust stat 2 label",
      "default": "Pharmacist-grade actives"
    },
    {
      "type": "text",
      "id": "trust3_num",
      "label": "Trust stat 3 number",
      "default": "★ 4.96"
    },
    {
      "type": "text",
      "id": "trust3_label",
      "label": "Trust stat 3 label",
      "default": "Verified buyer rating"
    },
    {
      "type": "header",
      "content": "Visual stage"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image",
      "info": "Custom hero image for the home page"
    },
    {
      "type": "text",
      "id": "hero_fallback_asset",
      "label": "Hero fallback asset filename",
      "default": "hero-home.jpg"
    },
    {
      "type": "image_picker",
      "id": "bottle_image",
      "label": "Bottle image (optional cutout)"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
