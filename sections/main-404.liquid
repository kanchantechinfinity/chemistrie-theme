{%- comment -%}
  Sends any 404 straight to the homepage. The page below still renders for
  anyone who arrives with JavaScript off, and stays the full fallback if the
  redirect is ever switched off in the editor.

  replace(), not assign/href: a redirect that leaves a history entry means the
  visitor's back button returns them to the dead URL, which bounces them
  forward again — they get stuck and cannot leave by going back.

  Server-side is not available here. A Shopify theme cannot set a status code,
  so this is a client-side hop and search engines still receive a 404 for the
  dead URL. That is the honest outcome; for URLs that should permanently move
  somewhere, use Admin > Navigation > URL Redirects instead, which issues a
  real 301.
{%- endcomment -%}
{%- if section.settings.redirect_home -%}
  <script>
    (function () {
      var home = {{ routes.root_url | json }};
      // Never redirect if we are somehow already there — that is a reload loop.
      if (window.location.pathname !== home) window.location.replace(home);
    }());
  </script>
{%- endif -%}
<section class="page-hero e404" data-screen-label="404">
  <div class="page-hero__inner e404__inner">
    <span class="eyebrow eyebrow--light">— Error 404 —</span>
    <h1 class="display-h display-h--light e404__title">This page didn't make it<br/><em>into the Collection.</em></h1>
    <p class="e404__body">The link you followed doesn't lead anywhere anymore. Everything else on the site still does.</p>
    <div class="e404__btns">
      <a href="{{ routes.root_url }}" class="btn btn--primary btn--light">Return to Homepage</a>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--ghost btn--dark e404__ghost">Explore the Collection</a>
    </div>
    <form action="{{ routes.search_url }}" method="get" role="search" class="e404__form">
      <label class="visually-hidden" for="e404-q">Search</label>
      <input class="e404__input" id="e404-q" type="search" name="q" placeholder="Search the site…" autocomplete="off">
      <button type="submit" class="e404__go">Search &rarr;</button>
    </form>
  </div>
</section>

{% stylesheet %}
.e404 { text-align: center; }
.page-hero__inner.e404__inner { text-align: center; display: flex; flex-direction: column; align-items: center; }
.e404__inner .eyebrow { max-width: 100%; margin-left: auto; margin-right: auto; text-align: center; }
.e404__title { margin: 16px auto 0; max-width: 18ch; text-align: center; }
.e404__body { margin: 26px auto 0; max-width: 48ch; color: rgba(240,232,219,.72); line-height: 1.7; }
.e404__btns { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; margin-top: 36px; }
.e404__ghost { background: rgba(240,232,219,.14); color: var(--c-cream); border-color: rgba(240,232,219,.4); }
.e404__ghost:hover { background: var(--c-cream); color: var(--c-forest); border-color: var(--c-cream); }
.e404__form { display: flex; gap: 10px; justify-content: center; margin-top: 40px; max-width: 460px; margin-left: auto; margin-right: auto; }
.e404__input { flex: 1; padding: 14px 18px; border-radius: 999px; border: 1px solid rgba(240,232,219,.28); background: rgba(240,232,219,.06); color: var(--c-cream); font-size: 14px; }
.e404__input::placeholder { color: rgba(240,232,219,.5); }
.e404__go { font-size: 12.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--c-tan); white-space: nowrap; }
.e404__go:hover { color: var(--c-cream); }
.visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
@media (max-width: 480px) { .e404__form { flex-direction: column; } }
{% endstylesheet %}

{% schema %}
{
  "name": "404",
  "settings": [
    { "type": "checkbox", "id": "redirect_home", "label": "Send 404s to the homepage", "default": true, "info": "Off: visitors see the 404 page below, with links home, to the collection, and a search box. On: they are moved to the homepage immediately. The 404 page is still what non-JavaScript visitors and search engines see either way." }
  ],
  "presets": [{ "name": "404" }]
}
{% endschema %}
