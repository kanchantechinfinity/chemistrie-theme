<!-- ───── Proof strip ───── -->
<section class="proof" data-screen-label="07 Proof">
  <div class="proof__head">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 class="display-h">{{ section.settings.heading }}</h2>
  </div>

  <div class="proof__grid">
    <div class="proof__cell">
      <span class="proof__num" data-count="{{ section.settings.stat1_count }}" data-suffix="{{ section.settings.stat1_suffix }}">0{{ section.settings.stat1_suffix }}</span>
      <span class="proof__label">{{ section.settings.stat1_label }}</span>
    </div>
    <div class="proof__cell">
      <span class="proof__num" data-count="{{ section.settings.stat2_count }}" data-suffix="{{ section.settings.stat2_suffix }}">0{{ section.settings.stat2_suffix }}</span>
      <span class="proof__label">{{ section.settings.stat2_label }}</span>
    </div>
    <div class="proof__cell">
      <span class="proof__num" data-count="{{ section.settings.stat3_count }}" data-suffix="{{ section.settings.stat3_suffix }}">0{{ section.settings.stat3_suffix }}</span>
      <span class="proof__label">{{ section.settings.stat3_label }}</span>
    </div>
    <div class="proof__cell">
      <span class="proof__num" data-count="{{ section.settings.stat4_count }}" data-suffix=""><span class="proof__num-n">0</span><span class="proof__num-u">{{ section.settings.stat4_unit }}</span></span>
      <span class="proof__label">{{ section.settings.stat4_label }}</span>
    </div>
  </div>
</section>

{% stylesheet %}
/* Scaled-down revamp. The base rules in chemistrie.css sized this for a
   full-bleed statement moment (up to 160px section padding, 140px
   numerals, 80px head gap), which left the stats stranded in a very tall
   band with dead space beside each numeral. Selectors are .proof-prefixed
   so they beat those base rules on specificity regardless of load order.
   Type, colour and copy are unchanged — this is purely scale + alignment. */
.proof.proof { padding: clamp(56px, 7vw, 92px) var(--pad-x); }

.proof .proof__head { margin-bottom: clamp(32px, 4vw, 52px); }

.proof .proof__grid {
  max-width: 1200px;
  margin-inline: auto;
}

.proof .proof__cell {
  padding: clamp(18px, 2vw, 26px) clamp(16px, 2vw, 28px);
  align-items: center;
  text-align: center;
}

/* Centred cells remove the void that sat to the right of every numeral
   when they were left-aligned inside wide columns. */
.proof .proof__num {
  font-size: clamp(42px, 4.8vw, 68px);
  margin-bottom: 10px;
  gap: 8px;
  justify-content: center;
}

.proof .proof__label {
  font-size: 15.5px;
  line-height: 1.5;
  max-width: 24ch;
  margin-inline: auto;
}

@media (max-width: 900px) {
  .proof .proof__num { font-size: clamp(38px, 8vw, 56px); }
  .proof .proof__label { font-size: 14.5px; }
}
{% endstylesheet %}

