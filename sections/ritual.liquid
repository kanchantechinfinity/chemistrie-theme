<!-- ───── The Ritual Finder — dark forest treatment ───── -->
<section class="ritual-finder" id="ritual-finder" data-screen-label="04 Ritual Finder">
  <div class="ritual-finder__ambient" aria-hidden="true"></div>
  
  <div class="ritual-finder__inner">
    <div class="ritual-finder__content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow eyebrow--light ritual-finder__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="display-h display-h--light ritual-finder__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <p class="ritual-finder__body">{{ section.settings.body }}</p>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <div class="ritual-finder__action">
          <a class="btn btn--primary btn--light ritual-finder__cta" href="{{ section.settings.cta_link | default: '/pages/the-ritual' }}">
            <span>{{ section.settings.cta_label }}</span>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6"/>
            </svg>
          </a>
        </div>
      {%- endif -%}
    </div>

    <div class="ritual-finder__visual">
      <div class="ritual-finder__media">
        <span class="ritual-finder__corner ritual-finder__corner--tl" aria-hidden="true"></span>
        <span class="ritual-finder__corner ritual-finder__corner--tr" aria-hidden="true"></span>
        <span class="ritual-finder__corner ritual-finder__corner--bl" aria-hidden="true"></span>
        <span class="ritual-finder__corner ritual-finder__corner--br" aria-hidden="true"></span>

        {%- if section.settings.image != blank -%}
          <img 
            class="ritual-finder__img" 
            src="{{ section.settings.image | image_url: width: 1400 }}" 
            alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}" 
            loading="lazy"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
          >
        {%- elsif section.settings.image_asset != blank -%}
          <img 
            class="ritual-finder__img" 
            src="{{ section.settings.image_asset | asset_url }}" 
            alt="Chemistrie Ritual Routine" 
            loading="lazy"
          >
        {%- else -%}
          <img 
            class="ritual-finder__img" 
            src="{{ 'hero-ritual.jpg' | asset_url }}" 
            alt="Chemistrie Ritual Routine" 
            loading="lazy"
          >
        {%- endif -%}

        <div class="ritual-finder__overlay" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "The Ritual Finder",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE RITUAL FINDER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Your skin. Your ritual."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body copy",
      "default": "A considered routine starts with knowing what belongs in it. Answer a few questions and we'll help you build a Chemistrie ritual around your skin and your priorities."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "FIND YOUR RITUAL"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Image asset fallback filename",
      "default": "hero-ritual.jpg",
      "info": "Asset filename in assets/ folder, used if no image is uploaded above."
    }
  ],
  "presets": [
    {
      "name": "The Ritual Finder"
    }
  ]
}
{% endschema %}
