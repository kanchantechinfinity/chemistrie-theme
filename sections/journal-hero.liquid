{%- assign feat = blog.articles.first -%}
<section class="jhero">
  <div class="jhero__inner">
    {%- if blog.articles.size > 0 -%}
      {%- comment -%}
        Eyebrow, title, excerpt — the same three blocks a .page-hero carries,
        so this band computes to the same height. The category chip and the
        "Read the article" link were the two extras that pushed it taller; the
        category still shows on every card below, and both the title and the
        photo already link through to the article.
      {%- endcomment -%}
      <div class="jhero__copy">
        <span class="eyebrow eyebrow--light">— The Journal —</span>
        <h1 class="display-h display-h--light jhero__title">
          <a href="{{ feat.url }}">{{ feat.title }}</a>
        </h1>
        {%- if feat.excerpt_or_content != blank -%}
          <p class="jhero__excerpt">{{ feat.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
        {%- endif -%}
      </div>
      <a class="jhero__media" href="{{ feat.url }}" aria-label="{{ feat.title | escape }}">
        {%- if feat.image -%}
          {{ feat.image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '600,900,1200,1600', alt: feat.image.alt | default: feat.title, class: 'jhero__img' }}
        {%- else -%}
          <img src="{{ 'hero-journal.jpg' | asset_url }}" alt="{{ feat.title | escape }}" loading="eager" class="jhero__img jhero__ph">
        {%- endif -%}
      </a>
    {%- else -%}
      <div class="jhero__copy jhero__empty">
        <span class="eyebrow eyebrow--light">— The Journal —</span>
        <h1 class="display-h display-h--light jhero__title">Letters from <em>the bench.</em></h1>
        <p class="jhero__excerpt">Our first entries are being compounded. Ingredient education, ritual notes, and perspectives from the founders are on their way.</p>
      </div>
      <div class="jhero__media jhero__media--static" aria-hidden="true">
        <img src="{{ 'hero-journal.jpg' | asset_url }}" alt="" loading="eager" class="jhero__img">
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
/* Band padding matched to .page-hero in assets/pages.css. */
.jhero { background: var(--grad-deep); color: var(--c-cream); padding: clamp(24px, 3.5vw, 52px) var(--pad-x) clamp(60px, 8vw, 110px); overflow: clip; }
/* Same column split and copy-then-visual order as .page-hero__inner, so the
   journal hero reads like every other page hero: text left, image right. */
.jhero__inner { max-width: var(--maxw); margin: 0 auto; display: grid; grid-template-columns: 1fr 1.15fr; gap: clamp(32px, 5vw, 80px); align-items: stretch; }
/* Same 1349/650 frame as .page-hero__visual — the old 4/3 box side-cropped the
   ~2.07 ratio journal art and left dead space beside the copy. */
.jhero__media { display: block; border-radius: 16px; overflow: hidden; background: var(--c-forest-2); aspect-ratio: 1349 / 650; height: auto; align-self: center; }
.jhero__img { width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease-out); }
.jhero__media:hover .jhero__img { transform: scale(1.04); }
/* Same size as .display-h.page-hero__title rather than the base .display-h
   (38-78px) this was inheriting, which ran larger than every other hero.
   Compound selector for specificity over the shared rule, matching the
   pattern used in sections/page-hero.liquid. */
.display-h.jhero__title { font-size: clamp(36px, 4.6vw, 66px); }
.jhero__title { margin: 18px 0 0; max-width: 15ch; }
.jhero__title a { transition: color .3s; }
.jhero__title a:hover { color: var(--c-tan); }
.jhero__excerpt { margin: 28px 0 0; max-width: 56ch; color: rgba(240,232,219,.72); font-size: clamp(15px, 1.3vw, 18px); line-height: 1.7; }
.jhero__media--static { cursor: default; }
.jhero__empty { max-width: 720px; }
.jhero__empty .jhero__title { margin-top: 18px; }
/* collapses at 760px, the width .page-hero__inner does. */
@media (max-width: 760px) {
  .jhero__inner { grid-template-columns: 1fr; }
  .jhero__media { height: auto; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Journal Hero",
  "settings": [],
  "presets": [{ "name": "Journal Hero" }]
}
{% endschema %}
