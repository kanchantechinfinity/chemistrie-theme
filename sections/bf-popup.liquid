{%- comment -%}
  Black Friday popup. Rendered once, site-wide, from layout/theme.liquid.

  Shows ONCE per browser (the first visit): after the visitor has been on the site for
  `delay_seconds`, counted across pages for the visit, and never again once it has opened. It announces the two Black Friday Rituals
  (15% off each) and links to their product pages. No email signup and no prices:
  the real discount is set up in Shopify, this is only the announcement.

  Wording comes from the Black Friday campaign brief. The one phrase that is not in
  the brief is the small "Our first" line (from "first Black Friday").
  Own bfp- prefix: section CSS is compiled into one global stylesheet.
{%- endcomment -%}
{%- liquid
  assign bfp_show = section.settings.enabled
  if section.settings.hide_after != blank
    assign bfp_today = 'now' | date: '%Y%m%d' | plus: 0
    assign bfp_end = section.settings.hide_after | replace: '-', '' | plus: 0
    if bfp_end > 0 and bfp_today > bfp_end
      assign bfp_show = false
    endif
  endif
  if section.settings.image != blank
    assign bfp_img = section.settings.image | image_url: width: 900
  else
    assign bfp_img = 'ritual-set-velvet-cashmere.jpg' | asset_img_url: '900x'
    if bfp_img == blank
      assign bfp_img = 'ritual-set-velvet-cashmere.jpg' | asset_url
    endif
  endif
  assign bfp_url_1 = section.settings.essential_url | default: '/products/essential-core'
  assign bfp_url_2 = section.settings.master_url | default: '/products/master-ritual'
-%}
{%- if bfp_show -%}
<div class="bfp" id="bfp" role="dialog" aria-modal="true" aria-labelledby="bfp-title" hidden
     data-delay="{{ section.settings.delay_seconds }}" {{ section.shopify_attributes }}>
  <div class="bfp__backdrop" data-bfp-close></div>
  <div class="bfp__card" tabindex="-1">
    <button type="button" class="bfp__close" data-bfp-close aria-label="Close">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>

    <div class="bfp__media">
      <img class="bfp__img" data-src="{{ bfp_img }}" alt="" width="900" height="900" decoding="async">
      {%- if section.settings.tagline != blank -%}<p class="bfp__tag">{{ section.settings.tagline | newline_to_br }}</p>{%- endif -%}
    </div>

    <div class="bfp__body">
      {%- if section.settings.eyebrow != blank -%}<p class="bfp__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="bfp__title" id="bfp-title">{{ section.settings.headline }}</h2>

      <div class="bfp__tile bfp__tile--main">
        <p class="bfp__pct"><span class="bfp__pct-n">{{ section.settings.discount }}</span><small>{{ section.settings.off_label }}</small></p>
        <p class="bfp__name">{{ section.settings.essential_name }}</p>
        <p class="bfp__line">{{ section.settings.essential_line }}</p>
        {%- if section.settings.essential_contains != blank -%}<p class="bfp__incl">{{ section.settings.essential_contains }}</p>{%- endif -%}
        <a class="bfp__cta" href="{{ bfp_url_1 }}">{{ section.settings.essential_button }}</a>
      </div>

      <div class="bfp__tile bfp__tile--alt">
        <p class="bfp__pct"><span class="bfp__pct-n">{{ section.settings.discount }}</span><small>{{ section.settings.off_label }}</small></p>
        <p class="bfp__name">{{ section.settings.master_name }}</p>
        <p class="bfp__line">{{ section.settings.master_line }}</p>
        {%- if section.settings.master_contains != blank -%}<p class="bfp__incl">{{ section.settings.master_contains }}</p>{%- endif -%}
        <a class="bfp__link" href="{{ bfp_url_2 }}">{{ section.settings.master_button }} <span aria-hidden="true">&rarr;</span></a>
      </div>
      {%- if section.settings.tagline != blank -%}<p class="bfp__foot">{{ section.settings.tagline | newline_to_br }}</p>{%- endif -%}
    </div>
  </div>
</div>

<script>
(function () {
  var root = document.getElementById('bfp');
  if (!root) return;

  var K_START = 'bfp_start', K_DISMISS = 'bfp_dismissed', K_SEEN = 'bfp_seen';
  function sget(s, k) { try { return window[s].getItem(k); } catch (e) { return null; } }
  function sset(s, k, v) { try { window[s].setItem(k, v); } catch (e) {} }

  var delay = (parseInt(root.getAttribute('data-delay'), 10) || 3) * 1000;
  var card = root.querySelector('.bfp__card');
  var img = root.querySelector('.bfp__img');
  var lastFocus = null;
  var shown = false;

  var force = /[?&]bf_popup=1/.test(location.search) || (window.Shopify && window.Shopify.designMode);
  var skipPage = /^\/(cart|checkout|account|challenge)/.test(location.pathname);

  // One time only: once it has been shown (or was dismissed before this rule existed)
  // it never opens again in this browser. Never on cart / checkout / account pages.
  if (!force) {
    if (skipPage) return;
    if (sget('localStorage', K_SEEN) || sget('localStorage', K_DISMISS)) return;
  }

  function loadImage() {
    if (img && !img.getAttribute('src')) img.setAttribute('src', img.getAttribute('data-src'));
  }

  function focusables() {
    return card.querySelectorAll('a[href], button:not([disabled])');
  }

  function onKey(e) {
    if (e.key === 'Escape') { close(); return; }
    if (e.key !== 'Tab') return;
    var f = focusables();
    if (!f.length) return;
    var first = f[0], last = f[f.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  }

  function open() {
    if (shown) return;
    shown = true;
    sset('localStorage', K_SEEN, '1'); // counted as seen the moment it opens, so a page change cannot bring it back
    loadImage();
    lastFocus = document.activeElement;
    root.hidden = false;
    document.body.classList.add('bfp-locked');
    requestAnimationFrame(function () {
      requestAnimationFrame(function () { root.classList.add('is-open'); card.focus(); });
    });
    document.addEventListener('keydown', onKey);
  }

  function close() {
    if (!shown) return;
    shown = false;
    root.classList.remove('is-open');
    document.body.classList.remove('bfp-locked');
    document.removeEventListener('keydown', onKey);
    sset('localStorage', K_DISMISS, String(Date.now()));
    setTimeout(function () { root.hidden = true; }, 350);
    if (lastFocus && lastFocus.focus) { try { lastFocus.focus(); } catch (e) {} }
  }

  root.addEventListener('click', function (e) {
    if (e.target.closest('[data-bfp-close]')) close();
  });

  // Timing: counted from the first page of the visit, so moving between pages does not restart it.
  var start = parseInt(sget('sessionStorage', K_START), 10);
  if (!start) { start = Date.now(); sset('sessionStorage', K_START, String(start)); }
  var wait = force ? 0 : Math.max(0, delay - (Date.now() - start));

  if (wait > 4000) setTimeout(loadImage, wait - 4000); // have the photo ready when it opens
  else loadImage();

  function drawerOpen() {
    return document.body.classList.contains('drawer-locked') || document.body.classList.contains('nav-locked');
  }
  function attempt() {
    if (shown) return;
    if (document.hidden) { document.addEventListener('visibilitychange', function once() { if (!document.hidden) { document.removeEventListener('visibilitychange', once); attempt(); } }); return; }
    if (drawerOpen()) { setTimeout(attempt, 3000); return; }
    open();
  }
  setTimeout(attempt, wait);
})();
</script>
{%- endif -%}

{% stylesheet %}
body.bfp-locked { overflow: hidden; }
.bfp { position: fixed; inset: 0; z-index: 900; display: grid; place-items: center; padding: 16px; }
.bfp[hidden] { display: none; }
.bfp__backdrop { position: absolute; inset: 0; background: rgba(14, 33, 24, .64); opacity: 0; transition: opacity .4s var(--ease-out); }
.bfp.is-open .bfp__backdrop { opacity: 1; }

.bfp__card {
  position: relative; width: min(980px, 100%); max-height: calc(100vh - 32px); max-height: calc(100dvh - 32px);
  overflow: auto; display: grid; grid-template-columns: minmax(0, .72fr) minmax(0, 1.28fr);
  background: var(--c-cream); color: var(--c-forest); font-family: var(--ff-body);
  border-radius: 24px; box-shadow: 0 44px 90px -30px rgba(0, 0, 0, .65);
  opacity: 0; transform: translateY(20px) scale(.985);
  transition: opacity .45s var(--ease-out), transform .45s var(--ease-out);
  outline: none;
}
.bfp.is-open .bfp__card { opacity: 1; transform: none; }
.bfp__card p { margin: 0; }

.bfp__close {
  position: absolute; top: 14px; right: 14px; z-index: 3; width: 36px; height: 36px;
  display: grid; place-items: center; border-radius: 50%; cursor: pointer;
  background: rgba(245, 237, 217, .95); color: var(--c-forest); border: 1px solid var(--c-line);
  transition: background .25s var(--ease-out);
}
.bfp__close:hover { background: var(--c-paper); }

.bfp__media { position: relative; background: var(--c-cream-2); min-height: 100%; }
.bfp__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
.bfp__media::after { content: ""; position: absolute; inset: auto 0 0 0; height: 42%; background: linear-gradient(0deg, rgba(15, 42, 32, .82), transparent); pointer-events: none; }
.bfp__tag { position: absolute; z-index: 2; left: 22px; right: 22px; bottom: 22px; color: var(--c-cream); font-family: var(--ff-display); font-style: italic; font-size: 24px; line-height: 1.15; }

.bfp__body { display: flex; flex-direction: column; gap: 14px; padding: 30px 34px; min-width: 0; justify-content: center; }
.bfp__eyebrow { display: flex; align-items: center; gap: 12px; font-size: 12px; font-weight: 600; letter-spacing: .32em; text-transform: uppercase; }
.bfp__eyebrow::after { content: ""; flex: 1; height: 1px; background: var(--c-line); margin-right: 48px; }
.bfp__title { margin: -4px 0 4px; font-family: var(--ff-display); font-style: italic; font-weight: 600; font-size: clamp(52px, 6vw, 76px); line-height: .92; letter-spacing: -.01em; color: var(--c-forest); }

.bfp__tile { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 4px 26px; align-items: center; border-radius: 18px; }
.bfp__tile--main {
  padding: 26px 28px; color: var(--c-cream);
  background: radial-gradient(120% 140% at 0% 0%, var(--c-forest-2) 0%, var(--c-forest) 55%, #0f2a20 100%);
  box-shadow: 0 18px 40px -22px rgba(15, 42, 32, .9);
  outline: 1px solid var(--c-tan); outline-offset: -7px;
}
.bfp__tile--alt { padding: 18px 24px; background: var(--c-cream-2); border: 1px solid var(--c-line); }

.bfp__pct { grid-row: 1 / 5; text-align: center; font-family: var(--ff-display); font-style: italic; font-weight: 700; line-height: .8; }
.bfp__pct small { display: block; font-family: var(--ff-body); font-style: normal; font-size: 14px; font-weight: 600; letter-spacing: .42em; padding-left: .42em; }
.bfp__tile--main .bfp__pct-n { font-size: 116px; color: var(--c-tan); }
.bfp__tile--main .bfp__pct small { margin-top: 30px; color: var(--c-tan); }
.bfp__tile--alt .bfp__pct-n { font-size: 64px; color: var(--c-forest); }
.bfp__tile--alt .bfp__pct small { margin-top: 22px; color: var(--c-forest); }

.bfp__name { font-size: 12px; font-weight: 600; letter-spacing: .26em; text-transform: uppercase; opacity: .9; }
.bfp__line { font-family: var(--ff-display); font-style: italic; font-weight: 500; font-size: 32px; line-height: 1.05; }
.bfp__tile--alt .bfp__line { font-size: 24px; }
.bfp__incl { font-size: 13px; line-height: 1.45; opacity: .82; }

.bfp__cta { justify-self: start; margin-top: 10px; padding: 15px 28px; border-radius: 999px; background: var(--c-cream); color: var(--c-forest); font-size: 12px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; text-decoration: none; transition: background .25s var(--ease-out), transform .25s var(--ease-out); }
.bfp__cta:hover { background: var(--c-paper); transform: translateY(-1px); }
.bfp__cta:focus-visible, .bfp__link:focus-visible { outline: 2px solid var(--c-tan); outline-offset: 3px; }
.bfp__link { justify-self: start; margin-top: 8px; padding-bottom: 3px; border-bottom: 1.5px solid var(--c-forest); color: var(--c-forest); font-size: 12px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; text-decoration: none; }
.bfp__link:hover { opacity: .75; }
.bfp__foot { display: none; }

@media (max-width: 760px) {
  .bfp { padding: 12px; align-items: end; }
  .bfp__card { grid-template-columns: minmax(0, 1fr); max-height: calc(100vh - 24px); max-height: calc(100dvh - 24px); border-radius: 20px; }
  .bfp__media { min-height: 0; aspect-ratio: 16 / 6; }
  .bfp__tag, .bfp__media::after { display: none; }
  .bfp__foot { display: block; text-align: center; font-family: var(--ff-display); font-style: italic; font-size: 19px; line-height: 1.25; opacity: .85; margin-top: 2px; }
  .bfp__body { padding: 20px 18px 22px; gap: 12px; justify-content: flex-start; }
  .bfp__eyebrow::after { margin-right: 0; }
  .bfp__title { font-size: 52px; }
  .bfp__tile { grid-template-columns: minmax(0, 1fr); gap: 4px; }
  .bfp__tile--main { padding: 18px 20px 20px; }
  .bfp__tile--alt { padding: 16px 20px; }
  .bfp__pct { grid-row: auto; display: flex; align-items: baseline; justify-content: flex-start; gap: 12px; text-align: left; line-height: 1; margin-bottom: 20px; }
  .bfp__pct small { margin-top: 0 !important; padding-left: 0; }
  .bfp__tile--main .bfp__pct-n { font-size: 76px; }
  .bfp__tile--alt .bfp__pct-n { font-size: 50px; }
  .bfp__line { font-size: 28px; }
  .bfp__tile--alt .bfp__line { font-size: 22px; }
  .bfp__cta { justify-self: stretch; text-align: center; padding: 13px 18px; margin-top: 6px; }
}
@media (prefers-reduced-motion: reduce) {
  .bfp__backdrop, .bfp__card, .bfp__cta { transition: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Black Friday popup",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show the popup",
      "default": true
    },
    {
      "type": "range",
      "id": "delay_seconds",
      "label": "Show after (seconds on the site)",
      "min": 1,
      "max": 60,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "hide_after",
      "label": "Stop showing after (YYYY-MM-DD)",
      "info": "So it does not linger past the sale. Clear the field to show it with no end date.",
      "default": "2026-12-01"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo",
      "info": "Optional. Shows the Velvet + Cashmere lineup photo when empty."
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline on the photo",
      "default": "Made by Pharmacists.\nMade with Love."
    },
    {
      "type": "header",
      "content": "Top"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small line above the headline",
      "default": "Our first"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Black Friday"
    },
    {
      "type": "text",
      "id": "discount",
      "label": "Discount figure",
      "default": "15%"
    },
    {
      "type": "text",
      "id": "off_label",
      "label": "Word under the figure",
      "default": "OFF"
    },
    {
      "type": "header",
      "content": "Main offer (green block)"
    },
    {
      "type": "text",
      "id": "essential_name",
      "label": "Name",
      "default": "The Essential Ritual"
    },
    {
      "type": "text",
      "id": "essential_line",
      "label": "Headline",
      "default": "Your Ritual Begins Here."
    },
    {
      "type": "text",
      "id": "essential_contains",
      "label": "What it contains",
      "info": "Product names only, no sizes. Blank = not shown.",
      "default": "Velvet · Cashmere"
    },
    {
      "type": "text",
      "id": "essential_button",
      "label": "Button text",
      "default": "Discover the Essential Ritual"
    },
    {
      "type": "url",
      "id": "essential_url",
      "label": "Button link",
      "info": "Blank = the Essential Core product page."
    },
    {
      "type": "header",
      "content": "Premium offer (sand block)"
    },
    {
      "type": "text",
      "id": "master_name",
      "label": "Name",
      "default": "The Master Ritual"
    },
    {
      "type": "text",
      "id": "master_line",
      "label": "Headline",
      "default": "The Complete Chemistrie Experience."
    },
    {
      "type": "text",
      "id": "master_contains",
      "label": "What it contains",
      "info": "Product names only, no sizes. Blank = not shown.",
      "default": "Velvet · Cashmere · Aura · Silken · Veil"
    },
    {
      "type": "text",
      "id": "master_button",
      "label": "Link text",
      "default": "Explore the Master Ritual"
    },
    {
      "type": "url",
      "id": "master_url",
      "label": "Link",
      "info": "Blank = the Master Ritual product page."
    }
  ],
  "presets": [
    {
      "name": "Black Friday popup"
    }
  ]
}
{% endschema %}
