{%- comment -%}
  Black Friday popup. Rendered once, site-wide, from layout/theme.liquid.

  Layout follows the approved Black Friday creative (a portrait poster card): brand
  mark at the top, a headline and a line of text, the product photo, and one pill
  button sitting on the photo. Colours are the site's own (cream card, forest text).
  No prices or discounts are shown: the only message is to subscribe.

  Behaviour: opens after `delay_seconds` on the site (counted across pages for the
  whole visit). Only the Subscribe button shows at first; clicking it reveals the
  email box. The signup is Shopify's own `customer` form (customer tagged
  "newsletter, black-friday") and the shared data-form-copy handler in
  assets/shop-ux.js also emails a copy to support.
  Own bfp- prefix: section CSS is compiled into one global stylesheet.
{%- endcomment -%}
{%- liquid
  assign bfp_show = section.settings.enabled
  if section.settings.hide_after != blank
    assign bfp_today = 'now' | date: '%Y%m%d' | plus: 0
    assign bfp_end = section.settings.hide_after | replace: '-', '' | plus: 0
    if bfp_end > 0 and bfp_today > bfp_end
      assign bfp_show = false
    endif
  endif
  if section.settings.image != blank
    assign bfp_img = section.settings.image | image_url: width: 900
  else
    assign bfp_img = 'ritual-set-velvet-cashmere.jpg' | asset_img_url: '900x'
    if bfp_img == blank
      assign bfp_img = 'ritual-set-velvet-cashmere.jpg' | asset_url
    endif
  endif
  assign bfp_privacy = shop.privacy_policy.url
-%}
{%- if bfp_show -%}
<div class="bfp" id="bfp" role="dialog" aria-modal="true" aria-labelledby="bfp-title" hidden
     data-delay="{{ section.settings.delay_seconds }}" data-snooze="{{ section.settings.snooze_days }}" {{ section.shopify_attributes }}>
  <div class="bfp__backdrop" data-bfp-close></div>
  <div class="bfp__card" tabindex="-1">
    <button type="button" class="bfp__close" data-bfp-close aria-label="Close">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>

    <div class="bfp__top">
      <img class="bfp__logo" src="{{ 'footer-monogram.png' | asset_url }}" alt="" width="44" height="46" loading="lazy">
      <span class="bfp__brand">Chemistrie</span>
      <h2 class="bfp__title" id="bfp-title">{{ section.settings.headline }}</h2>
      <p class="bfp__sub">{{ section.settings.sub }}</p>
    </div>

    <div class="bfp__stage">
      <img class="bfp__img" data-src="{{ bfp_img }}" alt="" width="900" height="720" decoding="async" fetchpriority="low">
      <div class="bfp__cta">
        {%- form 'customer', id: 'bfp-form', class: 'bfp__form', data-form-copy: 'Black Friday sale updates' -%}
          {%- if form.posted_successfully? -%}<span data-bfp-posted hidden></span>{%- endif -%}
          {%- if form.errors -%}<span data-bfp-error hidden></span>{%- endif -%}
          <input type="hidden" name="contact[tags]" value="newsletter, black-friday">
          <div class="bfp__row">
            <div class="bfp__field">
              <label class="visually-hidden" for="bfp-email">Email address</label>
              <input class="bfp__input" id="bfp-email" type="email" name="contact[email]" placeholder="{{ section.settings.placeholder | escape }}" required maxlength="100" autocomplete="email">
            </div>
            <button type="button" class="bfp__btn" data-bfp-reveal>{{ section.settings.button_label }}</button>
          </div>
          <p class="bfp__msg" data-bfp-msg hidden role="alert"></p>
        {%- endform -%}
        <p class="bfp__thanks" data-bfp-thanks hidden>{{ section.settings.success_message }}</p>
      </div>
    </div>

    {%- if section.settings.consent_text != blank -%}
      <p class="bfp__consent">{{ section.settings.consent_text }}{%- if bfp_privacy != blank %} <a href="{{ bfp_privacy }}">Privacy Policy</a>.{%- endif -%}</p>
    {%- endif -%}
  </div>
</div>

<script>
(function () {
  var root = document.getElementById('bfp');
  if (!root) return;

  var K_START = 'bfp_start', K_DISMISS = 'bfp_dismissed', K_SUB = 'bfp_subscribed';
  function sget(s, k) { try { return window[s].getItem(k); } catch (e) { return null; } }
  function sset(s, k, v) { try { window[s].setItem(k, v); } catch (e) {} }

  var delay = (parseInt(root.getAttribute('data-delay'), 10) || 3) * 1000;
  var snooze = (parseInt(root.getAttribute('data-snooze'), 10) || 3) * 864e5;
  var card = root.querySelector('.bfp__card');
  var form = root.querySelector('#bfp-form');
  var msg = root.querySelector('[data-bfp-msg]');
  var thanks = root.querySelector('[data-bfp-thanks]');
  var img = root.querySelector('.bfp__img');
  var emailInput = root.querySelector('#bfp-email');
  var subBtn = root.querySelector('[data-bfp-reveal]');
  var lastFocus = null;
  var shown = false;

  var force = /[?&]bf_popup=1/.test(location.search) || (window.Shopify && window.Shopify.designMode);
  var postedBack = !!root.querySelector('[data-bfp-posted]');
  var path = location.pathname;
  var skipPage = /^\/(cart|checkout|account|challenge)/.test(path);

  if (postedBack) sset('localStorage', K_SUB, '1');

  // Never again once subscribed; stay quiet for a few days after a dismissal.
  if (!force && !postedBack) {
    if (skipPage || sget('localStorage', K_SUB)) return;
    var d = parseInt(sget('localStorage', K_DISMISS), 10);
    if (d && Date.now() - d < snooze) return;
  }

  // Only the Subscribe button is visible at first; clicking it reveals the email box.
  root.classList.add('is-collapsed');
  form.classList.add('is-collapsed');
  subBtn.addEventListener('click', function (e) {
    if (!form.classList.contains('is-collapsed')) return;
    e.preventDefault();
    root.classList.remove('is-collapsed');
    form.classList.remove('is-collapsed');
    subBtn.type = 'submit';
    emailInput.focus();
  });

  function loadImage() {
    if (img && !img.getAttribute('src')) img.setAttribute('src', img.getAttribute('data-src'));
  }

  function focusables() {
    return card.querySelectorAll('a[href], button:not([disabled]), input:not([type=hidden]):not([disabled])');
  }

  function onKey(e) {
    if (e.key === 'Escape') { close(); return; }
    if (e.key !== 'Tab') return;
    var f = focusables();
    if (!f.length) return;
    var first = f[0], last = f[f.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  }

  function open() {
    if (shown) return;
    shown = true;
    loadImage();
    lastFocus = document.activeElement;
    root.hidden = false;
    document.body.classList.add('bfp-locked');
    requestAnimationFrame(function () {
      requestAnimationFrame(function () { root.classList.add('is-open'); card.focus(); });
    });
    document.addEventListener('keydown', onKey);
    if (postedBack) showThanks();
  }

  function close() {
    if (!shown) return;
    shown = false;
    root.classList.remove('is-open');
    document.body.classList.remove('bfp-locked');
    document.removeEventListener('keydown', onKey);
    sset('localStorage', K_DISMISS, String(Date.now()));
    setTimeout(function () { root.hidden = true; }, 350);
    if (lastFocus && lastFocus.focus) { try { lastFocus.focus(); } catch (e) {} }
  }

  function showThanks() {
    form.hidden = true;
    thanks.hidden = false;
    root.classList.remove('is-collapsed');
    sset('localStorage', K_SUB, '1');
  }

  root.addEventListener('click', function (e) {
    if (e.target.closest('[data-bfp-close]')) close();
  });

  // Submit without leaving the page. Falls back to a normal submit if the request fails.
  form.addEventListener('submit', function (e) {
    var email = (form.elements['contact[email]'].value || '').trim();
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
      e.preventDefault();
      e.stopPropagation(); // do not let the site-wide form-copy handler email an invalid entry
      msg.textContent = 'Please enter a valid email address.';
      msg.hidden = false;
      return;
    }
    e.preventDefault();
    msg.hidden = true;
    var btn = form.querySelector('.bfp__btn');
    btn.disabled = true;
    fetch(form.getAttribute('action') || '/contact', { method: 'POST', body: new FormData(form), credentials: 'same-origin' })
      .then(function (res) { return res.text().then(function (t) { return { ok: res.ok, text: t }; }); })
      .then(function (r) {
        if (r.ok && r.text.indexOf('data-bfp-error') === -1) { showThanks(); }
        else if (r.ok) { msg.textContent = 'Please check the email address and try again.'; msg.hidden = false; btn.disabled = false; }
        else { throw new Error('bad status'); }
      })
      .catch(function () { form.submit(); });
  });

  // Timing: counted from the first page of the visit, so moving between pages does not restart it.
  var start = parseInt(sget('sessionStorage', K_START), 10);
  if (!start) { start = Date.now(); sset('sessionStorage', K_START, String(start)); }
  var wait = force ? 0 : Math.max(0, delay - (Date.now() - start));
  if (postedBack) wait = 0;

  if (wait > 4000) setTimeout(loadImage, wait - 4000); // have the photo ready when it opens
  else loadImage();

  function drawerOpen() {
    return document.body.classList.contains('drawer-locked') || document.body.classList.contains('nav-locked');
  }
  function attempt() {
    if (shown) return;
    if (document.hidden) { document.addEventListener('visibilitychange', function once() { if (!document.hidden) { document.removeEventListener('visibilitychange', once); attempt(); } }); return; }
    if (drawerOpen()) { setTimeout(attempt, 3000); return; }
    open();
  }
  setTimeout(attempt, wait);
})();
</script>
{%- endif -%}

{% stylesheet %}
body.bfp-locked { overflow: hidden; }
.bfp { position: fixed; inset: 0; z-index: 900; display: grid; place-items: center; padding: 16px; }
.bfp[hidden] { display: none; }
.bfp__backdrop { position: absolute; inset: 0; background: rgba(14, 33, 24, .6); opacity: 0; transition: opacity .4s var(--ease-out); }
.bfp.is-open .bfp__backdrop { opacity: 1; }

/* One portrait card, like the approved creative: brand, headline, text, photo with the button on it. */
.bfp__card {
  position: relative; width: min(500px, 100%); max-height: calc(100vh - 32px); max-height: calc(100dvh - 32px);
  overflow: auto; text-align: center;
  background: var(--c-cream); color: var(--c-forest);
  border-radius: 24px; box-shadow: 0 44px 90px -30px rgba(0, 0, 0, .55);
  opacity: 0; transform: translateY(20px) scale(.985);
  transition: opacity .45s var(--ease-out), transform .45s var(--ease-out);
  outline: none;
}
.bfp.is-open .bfp__card { opacity: 1; transform: none; }

.bfp__close {
  position: absolute; top: 12px; right: 12px; z-index: 3; width: 38px; height: 38px;
  display: grid; place-items: center; border-radius: 50%; cursor: pointer;
  background: rgba(245, 237, 217, .92); color: var(--c-forest); border: 1px solid var(--c-line);
  transition: background .25s var(--ease-out);
}
.bfp__close:hover { background: var(--c-paper); }

.bfp__top { display: flex; flex-direction: column; align-items: center; padding: 30px 32px 0; }
.bfp__logo { height: 46px; width: auto; }
.bfp__brand { margin: 6px 0 18px; font-family: var(--ff-display); font-size: 13px; font-weight: 500; letter-spacing: .38em; text-indent: .38em; text-transform: uppercase; color: var(--c-forest); }
.bfp__title { margin: 0 0 12px; font-family: var(--ff-display); font-style: italic; font-weight: 500; font-size: clamp(32px, 6.4vw, 42px); line-height: 1.08; color: var(--c-forest); text-wrap: balance; }
.bfp__sub { margin: 0; font-size: 16.5px; font-weight: 600; line-height: 1.5; color: var(--c-forest); max-width: 34ch; text-wrap: balance; }

.bfp__stage { position: relative; margin: 22px 16px 0; border-radius: 18px; overflow: hidden; background: var(--c-cream-2); aspect-ratio: 5 / 4; }
.bfp__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }

/* The Subscribe pill sits on the photo; after the first click it becomes the email bar. */
.bfp__cta { position: absolute; left: 14px; right: 14px; bottom: 14px; display: flex; justify-content: center; }
.bfp__form { width: 100%; display: flex; flex-direction: column; align-items: center; margin: 0; }
.bfp__row { display: flex; align-items: stretch; justify-content: center; gap: 6px; max-width: 100%; }
.bfp__field { flex: 1 1 auto; min-width: 0; }
.bfp__input { width: 100%; height: 100%; min-height: 48px; padding: 12px 18px; border: 0; border-radius: 999px; background: transparent; color: var(--c-forest); font: inherit; font-size: 15px; }
.bfp__input::placeholder { color: var(--c-ink-mute); }
.bfp__input:focus-visible { outline: 2px solid var(--c-forest); outline-offset: -2px; }
.bfp__btn { flex: 0 0 auto; padding: 16px 38px; border: 0; border-radius: 999px; cursor: pointer; background: var(--c-forest); color: var(--c-cream); font: inherit; font-size: 12.5px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; box-shadow: 0 10px 26px -8px rgba(14, 33, 24, .6); transition: background .25s var(--ease-out), transform .25s var(--ease-out); }
.bfp__btn:hover { background: var(--c-forest-2); transform: translateY(-1px); }
.bfp__btn:focus-visible { outline: 2px solid var(--c-tan); outline-offset: 3px; }
.bfp__btn:disabled { opacity: .6; cursor: default; transform: none; }
.bfp__form:not(.is-collapsed) .bfp__row { width: 100%; padding: 6px; border-radius: 999px; background: var(--c-paper); box-shadow: 0 14px 30px -12px rgba(14, 33, 24, .55); animation: bfpReveal .35s var(--ease-out); }
.bfp__form:not(.is-collapsed) .bfp__btn { padding: 14px 26px; box-shadow: none; }
.bfp__form.is-collapsed .bfp__field { display: none; }
.bfp__msg { margin: 8px 0 0; padding: 6px 12px; border-radius: 10px; background: var(--c-paper); font-size: 13px; color: #9a3b1f; }
.bfp__thanks { margin: 0; padding: 14px 26px; border-radius: 999px; background: var(--c-paper); font-family: var(--ff-display); font-style: italic; font-size: 22px; line-height: 1.25; color: var(--c-forest); box-shadow: 0 14px 30px -12px rgba(14, 33, 24, .55); }
@keyframes bfpReveal { from { opacity: 0; transform: translateY(8px) scale(.97); } to { opacity: 1; transform: none; } }

.bfp__consent { margin: 0; padding: 14px 28px 20px; font-size: 11.5px; line-height: 1.5; color: var(--c-ink-mute); }
.bfp__consent a { color: var(--c-ink-soft); text-decoration: underline; }
.bfp.is-collapsed .bfp__consent { display: none; }
.bfp.is-collapsed .bfp__stage { margin-bottom: 16px; }

@media (max-width: 520px) {
  .bfp { padding: 12px; align-items: end; }
  .bfp__card { max-height: calc(100vh - 24px); max-height: calc(100dvh - 24px); border-radius: 22px; }
  .bfp__top { padding: 24px 22px 0; }
  .bfp__logo { height: 40px; }
  .bfp__brand { margin-bottom: 14px; }
  .bfp__stage { margin: 18px 12px 0; }
  .bfp__cta { left: 10px; right: 10px; bottom: 10px; }
  .bfp__btn { padding: 15px 34px; }
  .bfp__form:not(.is-collapsed) .bfp__btn { padding: 13px 18px; }
  .bfp__consent { padding: 12px 22px 18px; }
}
@media (prefers-reduced-motion: reduce) {
  .bfp__backdrop, .bfp__card { transition: none; }
  .bfp__form:not(.is-collapsed) .bfp__row { animation: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Black Friday popup",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show the popup", "default": true },
    { "type": "range", "id": "delay_seconds", "label": "Show after (seconds on the site)", "min": 1, "max": 60, "step": 1, "default": 3 },
    { "type": "range", "id": "snooze_days", "label": "After it is closed, stay hidden for (days)", "min": 1, "max": 30, "step": 1, "default": 3 },
    { "type": "text", "id": "hide_after", "label": "Stop showing after (YYYY-MM-DD)", "info": "So it does not linger past the sale. Clear the field to show it with no end date.", "default": "2026-12-01" },
    { "type": "header", "content": "Message" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Black Friday is almost here." },
    { "type": "textarea", "id": "sub", "label": "Supporting text", "default": "Subscribe to know about the upcoming discounts for our Black Friday sale." },
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Optional. Shows the Velvet + Cashmere lineup photo when empty." },
    { "type": "header", "content": "Subscribe" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "Enter your email" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thank you — you're on the list." },
    { "type": "textarea", "id": "consent_text", "label": "Consent / privacy line", "info": "The Privacy Policy link is added automatically when one is set in Settings > Policies.", "default": "By subscribing, you agree to receive marketing emails from Chemistrie. Unsubscribe anytime. See our" }
  ],
  "presets": [
    { "name": "Black Friday popup" }
  ]
}
{% endschema %}
