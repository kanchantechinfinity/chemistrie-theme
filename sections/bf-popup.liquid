{%- comment -%}
  Black Friday popup. Rendered once, site-wide, from layout/theme.liquid.

  Shows after the visitor has been on the site for `delay_seconds` (15 by default),
  counted across pages for the whole visit, not per page. It holds the sale details
  and an email signup. The signup is Shopify's own `customer` form (creates a
  customer tagged "newsletter, black-friday", the same mechanism as the other
  signups) and the shared data-form-copy handler in assets/shop-ux.js also emails
  a copy to support.

  Default texts are the wording from the approved Black Friday creative. Prices
  here are TEXT: the real sale price still has to be set in Shopify.
  Own bfp- prefix: section CSS is compiled into one global stylesheet.
{%- endcomment -%}
{%- liquid
  assign bfp_show = section.settings.enabled
  if section.settings.hide_after != blank
    assign bfp_today = 'now' | date: '%Y%m%d' | plus: 0
    assign bfp_end = section.settings.hide_after | replace: '-', '' | plus: 0
    if bfp_end > 0 and bfp_today > bfp_end
      assign bfp_show = false
    endif
  endif
  if section.settings.image != blank
    assign bfp_img = section.settings.image | image_url: width: 900
  else
    assign bfp_img = 'ritual-set-velvet-cashmere.jpg' | asset_img_url: '900x'
    if bfp_img == blank
      assign bfp_img = 'ritual-set-velvet-cashmere.jpg' | asset_url
    endif
  endif
  assign bfp_explore = section.settings.explore_url | default: routes.all_products_collection_url
  assign bfp_privacy = shop.privacy_policy.url
-%}
{%- if bfp_show -%}
<div class="bfp" id="bfp" role="dialog" aria-modal="true" aria-labelledby="bfp-title" hidden
     data-delay="{{ section.settings.delay_seconds }}" data-snooze="{{ section.settings.snooze_days }}" {{ section.shopify_attributes }}>
  <div class="bfp__backdrop" data-bfp-close></div>
  <div class="bfp__card" tabindex="-1">
    <button type="button" class="bfp__close" data-bfp-close aria-label="Close">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>

    <div class="bfp__media">
      <img class="bfp__img" data-src="{{ bfp_img }}" alt="" width="900" height="900" decoding="async" fetchpriority="low">
    </div>

    <div class="bfp__body">
      <img class="bfp__logo" src="{{ 'footer-monogram.png' | asset_url }}" alt="" width="40" height="42" loading="lazy">
      {%- if section.settings.eyebrow != blank -%}<span class="bfp__tag">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="bfp__title" id="bfp-title">{{ section.settings.headline }}</h2>
      <p class="bfp__sub">{{ section.settings.sub }}</p>

      {%- comment -%} Price / discount lines only show when filled in (blank for now). {%- endcomment -%}
      {%- if section.settings.regular_label != blank or section.settings.sale_label != blank -%}
        <div class="bfp__price">
          {%- if section.settings.regular_label != blank -%}<span class="bfp__was">{{ section.settings.regular_label }}</span>{%- endif -%}
          {%- if section.settings.sale_label != blank -%}<span class="bfp__now">{{ section.settings.sale_label }}</span>{%- endif -%}
        </div>
      {%- endif -%}
      {%- if section.settings.save_label != blank -%}<p class="bfp__save">{{ section.settings.save_label }}</p>{%- endif -%}

      <div class="bfp__signup">
        {%- form 'customer', id: 'bfp-form', class: 'bfp__form', data-form-copy: 'Black Friday sale updates' -%}
          {%- if form.posted_successfully? -%}<span data-bfp-posted hidden></span>{%- endif -%}
          {%- if form.errors -%}<span data-bfp-error hidden></span>{%- endif -%}
          <input type="hidden" name="contact[tags]" value="newsletter, black-friday">
          {%- if section.settings.lead != blank -%}<p class="bfp__lead">{{ section.settings.lead }}</p>{%- endif -%}
          <div class="bfp__row">
            <div class="bfp__field">
              <label class="visually-hidden" for="bfp-email">Email address</label>
              <input class="bfp__input" id="bfp-email" type="email" name="contact[email]" placeholder="{{ section.settings.placeholder | escape }}" required maxlength="100" autocomplete="email">
            </div>
            {%- comment -%} Starts as a plain button; the first click reveals the email box and the button then becomes the submit. {%- endcomment -%}
            <span class="bfp__gift" data-bfp-gift>
              <button type="button" class="bfp__btn" data-bfp-reveal>{{ section.settings.button_label }}</button>
              <span class="bfp__ribbon" aria-hidden="true">
                <span class="bfp__rib bfp__rib--top"></span>
                <span class="bfp__rib bfp__rib--bot"></span>
                <svg class="bfp__bow" viewBox="0 0 64 42" focusable="false">
                  <defs><linearGradient id="bfpGold" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#e8d9bf"/><stop offset="1" stop-color="#a78a5e"/></linearGradient></defs>
                  <path d="M32 27C18 38 4 31 6 17C8 4 24 8 32 24Z" fill="url(#bfpGold)" stroke="#a78a5e" stroke-width=".8"/>
                  <path d="M32 27C46 38 60 31 58 17C56 4 40 8 32 24Z" fill="url(#bfpGold)" stroke="#a78a5e" stroke-width=".8"/>
                  <path d="M29.5 28L19 41L28 38.5L32 30Z" fill="#c8aa7a" stroke="#a78a5e" stroke-width=".8"/>
                  <path d="M34.5 28L45 41L36 38.5L32 30Z" fill="#c8aa7a" stroke="#a78a5e" stroke-width=".8"/>
                  <ellipse cx="32" cy="26" rx="6" ry="5" fill="url(#bfpGold)" stroke="#a78a5e" stroke-width=".8"/>
                </svg>
                <svg class="bfp__scissors" viewBox="0 0 44 44" focusable="false">
                  <g class="bfp__bl bfp__bl--a" fill="none" stroke="#1a3a2d" stroke-width="2" stroke-linecap="round"><path d="M4 12L30 22"/><circle cx="35" cy="30" r="5"/></g>
                  <g class="bfp__bl bfp__bl--b" fill="none" stroke="#1a3a2d" stroke-width="2" stroke-linecap="round"><path d="M4 32L30 22"/><circle cx="35" cy="14" r="5"/></g>
                </svg>
              </span>
            </span>
          </div>
          <p class="bfp__msg bfp__msg--error" data-bfp-msg hidden role="alert"></p>
          {%- if section.settings.consent_text != blank -%}
            <p class="bfp__consent bfp__reveal">{{ section.settings.consent_text }}{%- if bfp_privacy != blank %} <a href="{{ bfp_privacy }}">Privacy Policy</a>.{%- endif -%}</p>
          {%- endif -%}
        {%- endform -%}
        <p class="bfp__thanks" data-bfp-thanks hidden>{{ section.settings.success_message }}</p>
      </div>

      {%- if section.settings.explore_label != blank -%}
        <a class="bfp__explore" href="{{ bfp_explore }}">{{ section.settings.explore_label }} <span aria-hidden="true">&rarr;</span></a>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
(function () {
  var root = document.getElementById('bfp');
  if (!root) return;

  var K_START = 'bfp_start', K_DISMISS = 'bfp_dismissed', K_SUB = 'bfp_subscribed';
  function sget(s, k) { try { return window[s].getItem(k); } catch (e) { return null; } }
  function sset(s, k, v) { try { window[s].setItem(k, v); } catch (e) {} }

  var delay = (parseInt(root.getAttribute('data-delay'), 10) || 3) * 1000;
  var snooze = (parseInt(root.getAttribute('data-snooze'), 10) || 3) * 864e5;
  var card = root.querySelector('.bfp__card');
  var form = root.querySelector('#bfp-form');
  var msg = root.querySelector('[data-bfp-msg]');
  var thanks = root.querySelector('[data-bfp-thanks]');
  var img = root.querySelector('.bfp__img');
  var emailInput = root.querySelector('#bfp-email');
  var subBtn = root.querySelector('[data-bfp-reveal]');
  var lastFocus = null;
  var shown = false;

  // Only the Subscribe button is visible at first; clicking it reveals the email box.
  form.classList.add('is-collapsed');
  var gift = root.querySelector('[data-bfp-gift]');
  var cutting = false;
  function revealField() {
    if (gift) gift.classList.add('is-cut');
    form.classList.remove('is-collapsed');
    subBtn.type = 'submit';
    emailInput.focus();
  }
  subBtn.addEventListener('click', function (e) {
    if (!form.classList.contains('is-collapsed')) return;
    e.preventDefault();
    if (cutting) return;
    var calm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!gift || calm) { revealField(); return; }
    // The scissors snip the ribbon, the pieces fall away, then the email box appears.
    cutting = true;
    gift.classList.add('is-cutting');
    setTimeout(revealField, 720);
  });

  var force = /[?&]bf_popup=1/.test(location.search) || (window.Shopify && window.Shopify.designMode);
  var postedBack = !!root.querySelector('[data-bfp-posted]');
  var path = location.pathname;
  var skipPage = /^\/(cart|checkout|account|challenge)/.test(path);

  if (postedBack) sset('localStorage', K_SUB, '1');

  // Never again once subscribed; stay quiet for a few days after a dismissal.
  if (!force && !postedBack) {
    if (skipPage || sget('localStorage', K_SUB)) return;
    var d = parseInt(sget('localStorage', K_DISMISS), 10);
    if (d && Date.now() - d < snooze) return;
  }

  function loadImage() {
    if (img && !img.getAttribute('src')) img.setAttribute('src', img.getAttribute('data-src'));
  }

  function focusables() {
    return card.querySelectorAll('a[href], button:not([disabled]), input:not([type=hidden]):not([disabled])');
  }

  function onKey(e) {
    if (e.key === 'Escape') { close(); return; }
    if (e.key !== 'Tab') return;
    var f = focusables();
    if (!f.length) return;
    var first = f[0], last = f[f.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  }

  function open() {
    if (shown) return;
    shown = true;
    loadImage();
    lastFocus = document.activeElement;
    root.hidden = false;
    document.body.classList.add('bfp-locked');
    requestAnimationFrame(function () {
      requestAnimationFrame(function () { root.classList.add('is-open'); card.focus(); });
    });
    document.addEventListener('keydown', onKey);
    if (postedBack) showThanks();
  }

  function close() {
    if (!shown) return;
    shown = false;
    root.classList.remove('is-open');
    document.body.classList.remove('bfp-locked');
    document.removeEventListener('keydown', onKey);
    sset('localStorage', K_DISMISS, String(Date.now()));
    setTimeout(function () { root.hidden = true; }, 350);
    if (lastFocus && lastFocus.focus) { try { lastFocus.focus(); } catch (e) {} }
  }

  function showThanks() {
    form.hidden = true;
    thanks.hidden = false;
    sset('localStorage', K_SUB, '1');
  }

  root.addEventListener('click', function (e) {
    if (e.target.closest('[data-bfp-close]')) close();
  });

  // Submit without leaving the page. Falls back to a normal submit if the request fails.
  form.addEventListener('submit', function (e) {
    var email = (form.elements['contact[email]'].value || '').trim();
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
      e.preventDefault();
      e.stopPropagation(); // do not let the site-wide form-copy handler email an invalid entry
      msg.textContent = 'Please enter a valid email address.';
      msg.hidden = false;
      return;
    }
    e.preventDefault();
    msg.hidden = true;
    var btn = form.querySelector('.bfp__btn');
    btn.disabled = true;
    fetch(form.getAttribute('action') || '/contact', { method: 'POST', body: new FormData(form), credentials: 'same-origin' })
      .then(function (res) { return res.text().then(function (t) { return { ok: res.ok, text: t }; }); })
      .then(function (r) {
        if (r.ok && r.text.indexOf('data-bfp-error') === -1) { showThanks(); }
        else if (r.ok) { msg.textContent = 'Please check the email address and try again.'; msg.hidden = false; btn.disabled = false; }
        else { throw new Error('bad status'); }
      })
      .catch(function () { form.submit(); });
  });

  // Timing: counted from the first page of the visit, so moving between pages does not restart it.
  var start = parseInt(sget('sessionStorage', K_START), 10);
  if (!start) { start = Date.now(); sset('sessionStorage', K_START, String(start)); }
  var wait = force ? 0 : Math.max(0, delay - (Date.now() - start));
  if (postedBack) wait = 0;

  if (wait > 4000) setTimeout(loadImage, wait - 4000); // have the photo ready when it opens
  else loadImage();

  function drawerOpen() {
    return document.body.classList.contains('drawer-locked') || document.body.classList.contains('nav-locked');
  }
  function attempt() {
    if (shown) return;
    if (document.hidden) { document.addEventListener('visibilitychange', function once() { if (!document.hidden) { document.removeEventListener('visibilitychange', once); attempt(); } }); return; }
    if (drawerOpen()) { setTimeout(attempt, 3000); return; }
    open();
  }
  setTimeout(attempt, wait);
})();
</script>
{%- endif -%}

{% stylesheet %}
body.bfp-locked { overflow: hidden; }
.bfp { position: fixed; inset: 0; z-index: 900; display: grid; place-items: center; padding: 16px; }
.bfp[hidden] { display: none; }
.bfp__backdrop { position: absolute; inset: 0; background: rgba(14, 33, 24, .6); opacity: 0; transition: opacity .4s var(--ease-out); }
.bfp.is-open .bfp__backdrop { opacity: 1; }

.bfp__card {
  position: relative; width: min(920px, 100%); max-height: calc(100vh - 32px); max-height: calc(100dvh - 32px);
  overflow: auto; display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr);
  background: var(--c-cream); color: var(--c-forest);
  border-radius: 22px; box-shadow: 0 44px 90px -30px rgba(0, 0, 0, .55);
  opacity: 0; transform: translateY(20px) scale(.985);
  transition: opacity .45s var(--ease-out), transform .45s var(--ease-out);
  outline: none;
}
.bfp.is-open .bfp__card { opacity: 1; transform: none; }

.bfp__close {
  position: absolute; top: 12px; right: 12px; z-index: 2; width: 38px; height: 38px;
  display: grid; place-items: center; border-radius: 50%; cursor: pointer;
  background: rgba(245, 237, 217, .9); color: var(--c-forest); border: 1px solid var(--c-line);
  transition: background .25s var(--ease-out);
}
.bfp__close:hover { background: var(--c-paper); }

.bfp__media { position: relative; background: var(--c-cream-2); min-height: 100%; }
.bfp__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }

.bfp__body { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; padding: clamp(28px, 3.6vw, 48px); gap: 0; }
.bfp__logo { height: 44px; width: auto; margin: 0 0 20px; }
.bfp__tag { display: inline-block; margin: 0 0 14px; padding: 8px 18px; border-radius: 999px; background: linear-gradient(135deg, var(--c-tan-3), var(--c-tan)); color: var(--c-forest); font-size: 12px; font-weight: 600; letter-spacing: .24em; text-transform: uppercase; }
.bfp__title { margin: 0 0 14px; font-family: var(--ff-display); font-style: italic; font-weight: 500; font-size: clamp(30px, 3.6vw, 46px); line-height: 1.1; color: var(--c-forest); text-wrap: balance; }
.bfp__sub { margin: 0 0 22px; font-size: 18px; font-weight: 600; line-height: 1.5; color: var(--c-forest); max-width: 34ch; }

/* Price lines are blank for now; styled so they can come back from the theme editor. */
.bfp__price { display: inline-flex; align-items: stretch; max-width: 100%; margin-bottom: 8px; border: 1px solid var(--c-line); border-radius: 999px; overflow: hidden; }
.bfp__was { display: flex; align-items: center; padding: 10px 18px; font-size: 14px; text-decoration: line-through; color: var(--c-ink-soft); white-space: nowrap; }
.bfp__now { display: flex; align-items: center; padding: 10px 20px; font-family: var(--ff-display); font-style: italic; font-weight: 600; font-size: 19px; color: var(--c-forest); background: linear-gradient(135deg, var(--c-tan-3), var(--c-tan)); white-space: nowrap; }
.bfp__save { margin: 0 0 18px; font-size: 14px; letter-spacing: .04em; color: var(--c-tan-2); }

.bfp__signup { width: 100%; }
.bfp__lead { margin: 0 0 12px; font-size: 14.5px; line-height: 1.5; color: var(--c-forest); }
.bfp__row { display: flex; align-items: stretch; gap: 8px; }
.bfp__field { flex: 1 1 auto; min-width: 0; }
.bfp__input { width: 100%; height: 100%; min-height: 50px; padding: 14px 18px; border: 1px solid var(--c-line); border-radius: 999px; background: var(--c-paper); color: var(--c-forest); font: inherit; font-size: 15px; }
.bfp__input::placeholder { color: var(--c-ink-mute); }
.bfp__input:focus-visible { outline: 2px solid var(--c-forest); outline-offset: 2px; }
.bfp__btn { flex: 0 0 auto; padding: 15px 30px; border: 0; border-radius: 999px; cursor: pointer; background: var(--c-forest); color: var(--c-cream); font: inherit; font-size: 12.5px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; transition: background .25s var(--ease-out), transform .25s var(--ease-out); }
.bfp__btn:hover { background: var(--c-forest-2); }
.bfp__btn:focus-visible { outline: 2px solid var(--c-tan-2); outline-offset: 3px; }
.bfp__btn:disabled { opacity: .6; cursor: default; }
.bfp__msg { margin: 8px 0 0; font-size: 13px; color: #9a3b1f; }
.bfp__consent { margin: 12px 0 0; font-size: 11.5px; line-height: 1.5; color: var(--c-ink-mute); }
.bfp__consent a { color: var(--c-ink-soft); text-decoration: underline; }
.bfp__thanks { margin: 0; font-family: var(--ff-display); font-style: italic; font-size: 24px; line-height: 1.3; color: var(--c-forest); }

/* Collapsed: just the Subscribe button. The email box and consent line appear after the first click. */
.bfp__form.is-collapsed .bfp__field,
.bfp__form.is-collapsed .bfp__reveal { display: none; }
.bfp__form:not(.is-collapsed) .bfp__field,
.bfp__form:not(.is-collapsed) .bfp__reveal { animation: bfpReveal .35s var(--ease-out); }
@keyframes bfpReveal { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

.bfp__explore { margin-top: 20px; font-size: 12.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--c-ink-soft); border-bottom: 1px solid var(--c-line); padding-bottom: 3px; }
.bfp__explore:hover { color: var(--c-forest); border-color: var(--c-forest); }

/* ---- Gift ribbon on the Subscribe button. Clicking it: scissors snip, ribbon falls away, email box appears. ---- */
.bfp__gift { position: relative; display: flex; margin-top: 30px; }
.bfp__gift.is-cut { margin-top: 0; }
.bfp__gift .bfp__btn { height: 100%; transition: padding .35s var(--ease-out), background .25s var(--ease-out); }
.bfp__gift:not(.is-cut) .bfp__btn { padding-left: 84px; padding-right: 34px; }
.bfp__ribbon { position: absolute; inset: 0; pointer-events: none; }
.bfp__gift.is-cut .bfp__ribbon { display: none; }
.bfp__rib {
  position: absolute; left: 26px; width: 26px;
  background: linear-gradient(90deg, var(--c-tan-2), var(--c-tan-3) 42%, var(--c-tan) 68%, var(--c-tan-2));
  box-shadow: 0 1px 3px rgba(14, 33, 24, .35);
}
.bfp__rib--top { top: -8px; height: calc(50% + 8px); border-radius: 3px 3px 0 0; transform-origin: 50% 100%; }
.bfp__rib--bot { bottom: -8px; height: calc(50% + 8px); border-radius: 0 0 3px 3px; transform-origin: 50% 0; }
.bfp__bow { position: absolute; left: 11px; top: -34px; width: 56px; height: auto; overflow: visible; transform-origin: 50% 90%; filter: drop-shadow(0 2px 2px rgba(14, 33, 24, .3)); }
.bfp__scissors { position: absolute; left: 36px; top: 50%; width: 46px; height: 46px; margin-top: -23px; opacity: 0; overflow: visible; }
.bfp__bl { transform-box: view-box; transform-origin: 30px 22px; }

.bfp__gift.is-cutting .bfp__scissors { animation: bfpScIn .26s var(--ease-out) forwards, bfpScOut .2s ease-in .5s forwards; }
.bfp__gift.is-cutting .bfp__bl--a { animation: bfpBladeA .22s ease-in .26s forwards; }
.bfp__gift.is-cutting .bfp__bl--b { animation: bfpBladeB .22s ease-in .26s forwards; }
.bfp__gift.is-cutting .bfp__rib--top { animation: bfpRibTop .45s ease-in .46s forwards; }
.bfp__gift.is-cutting .bfp__rib--bot { animation: bfpRibBot .45s ease-in .46s forwards; }
.bfp__gift.is-cutting .bfp__bow { animation: bfpBow .5s ease-in .46s forwards; }
.bfp__gift:not(.is-cutting) .bfp__bow { animation: bfpWiggle 2.8s ease-in-out 1.2s infinite; }
@keyframes bfpScIn { from { opacity: 0; transform: translateX(64px) rotate(10deg); } to { opacity: 1; transform: none; } }
@keyframes bfpScOut { to { opacity: 0; transform: translateX(34px); } }
@keyframes bfpBladeA { from { transform: rotate(-26deg); } to { transform: rotate(0); } }
@keyframes bfpBladeB { from { transform: rotate(26deg); } to { transform: rotate(0); } }
@keyframes bfpRibTop { to { opacity: 0; transform: translate(-10px, -26px) rotate(-16deg); } }
@keyframes bfpRibBot { to { opacity: 0; transform: translate(12px, 30px) rotate(14deg); } }
@keyframes bfpBow { to { opacity: 0; transform: translateY(-34px) rotate(26deg); } }
@keyframes bfpWiggle { 0%, 88%, 100% { transform: none; } 92% { transform: rotate(-4deg); } 96% { transform: rotate(4deg); } }

@media (max-width: 760px) {
  .bfp { padding: 12px; align-items: end; }
  .bfp__card { grid-template-columns: minmax(0, 1fr); max-height: calc(100vh - 24px); max-height: calc(100dvh - 24px); border-radius: 20px; }
  .bfp__media { min-height: 0; aspect-ratio: 16 / 9; }
  .bfp__body { padding: 22px 20px 26px; justify-content: flex-start; }
  .bfp__logo { height: 36px; margin-bottom: 12px; }
  .bfp__row { flex-direction: column; }
  .bfp__gift { width: 100%; }
  .bfp__btn { width: 100%; }
}
@media (prefers-reduced-motion: reduce) {
  .bfp__backdrop, .bfp__card { transition: none; }
  .bfp__bow { animation: none !important; }
  .bfp__form:not(.is-collapsed) .bfp__field, .bfp__form:not(.is-collapsed) .bfp__reveal { animation: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Black Friday popup",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show the popup",
      "default": true
    },
    {
      "type": "range",
      "id": "delay_seconds",
      "label": "Show after (seconds on the site)",
      "min": 1,
      "max": 60,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "snooze_days",
      "label": "After it is closed, stay hidden for (days)",
      "min": 1,
      "max": 30,
