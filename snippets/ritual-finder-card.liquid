{%- comment -%}
  Guided-shopping CTA card inserted into a product grid. Not a product —
  deliberately dark/evergreen so it cannot be mistaken for a sixth product.
  Occupies the same grid cell as a .pcard, so it stretches to match card
  height automatically (CSS Grid's default align-items: stretch).
  Params: section (for the ritual_finder_* settings)
{%- endcomment -%}
<a class="rfcard" href="{{ section.settings.ritual_finder_url | default: '/pages/the-ritual' }}">
  <span class="rfcard__eyebrow">{{ section.settings.ritual_finder_eyebrow }}</span>
  <h3 class="rfcard__title">{{ section.settings.ritual_finder_heading }}</h3>
  {%- if section.settings.ritual_finder_body != blank -%}
    <p class="rfcard__body">{{ section.settings.ritual_finder_body }}</p>
  {%- endif -%}
  <span class="rfcard__cta">{{ section.settings.ritual_finder_cta }} <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
</a>

{% stylesheet %}
.rfcard {
  display: flex; flex-direction: column; justify-content: center;
  background: var(--c-forest);
  border-radius: 14px;
  padding: clamp(28px, 3vw, 40px);
  text-decoration: none;
  position: relative;
  overflow: hidden;
  min-height: 320px;
  transition: transform .5s var(--ease-out), box-shadow .5s var(--ease-out);
}
.rfcard:hover { transform: translateY(-4px); box-shadow: 0 24px 60px -30px rgba(26,58,45,.5); }
.rfcard__eyebrow { color: var(--c-tan); font-size: 10px; letter-spacing: .18em; text-transform: uppercase; display: block; margin-bottom: 16px; }
.rfcard__title { font-family: var(--ff-display); font-size: clamp(24px, 2.4vw, 30px); font-weight: 500; margin: 0 0 14px; color: var(--c-cream); }
.rfcard__body { font-size: 14px; line-height: 1.6; color: rgba(249,244,237,.75); margin: 0 0 26px; }
.rfcard__cta { display: inline-flex; align-items: center; gap: 8px; font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--c-tan); }
{% endstylesheet %}
