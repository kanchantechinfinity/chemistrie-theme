<!-- ───── Welcome / discount popup — site-wide, shows once per session ───── -->
<div class="promo-popup" id="promoPopup" aria-hidden="true">
  <div class="promo-popup__backdrop" id="promoPopupBackdrop"></div>
  <div class="promo-popup__panel" role="dialog" aria-modal="true" aria-label="Welcome offer">
    <button type="button" class="promo-popup__close" id="promoPopupClose" aria-label="Close">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>

    <div class="promo-popup__media">
      <img src="{{ 'howto-cleanse.jpg' | asset_url }}" alt="" loading="lazy">
    </div>

    <div class="promo-popup__body">
      <span class="eyebrow">— A welcome gift —</span>
      <h2 class="promo-popup__h">Take 15% off<br/><em>your first order.</em></h2>
      <p class="promo-popup__sub">Join the list for pharmacist notes and new formulas first — and take your code with you.</p>

      <div class="promo-popup__code">
        <span class="promo-popup__code-label">Your code</span>
        <span class="promo-popup__code-value" id="promoCodeValue">WELCOME15</span>
        <button type="button" class="promo-popup__code-copy" id="promoCodeCopy">Copy</button>
      </div>

      {% form 'customer', id: 'promo-popup-form', class: 'promo-popup__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {% if form.errors and form.errors.size > 0 %}
          <p class="promo-popup__error">{{ form.errors.messages['email'] | default: 'Please enter a valid email address.' }}</p>
        {% endif %}
        <label class="promo-popup__field">
          <span class="visually-hidden">Email</span>
          <input type="email" name="contact[email]" placeholder="you@elsewhere.com" required>
        </label>
        <button class="btn btn--primary" type="submit">
          <span>Get my code</span>
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
        <p class="promo-popup__sent"{% if form.posted_successfully? %} style="opacity:1;"{% endif %}>You're on the list — enjoy WELCOME15 at checkout.</p>
      {% endform %}

      <div class="promo-popup__social">
        <span>Follow along</span>
        <div class="promo-popup__social-links">
          <a href="{{ settings.social_instagram | default: '#' }}" aria-label="Instagram">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".5" fill="currentColor"/></svg>
          </a>
          <a href="{{ settings.social_pinterest | default: '#' }}" aria-label="Pinterest">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="12" r="9"/><path d="M11 22 13 13M9 9c0-2 1.5-4 4-4s4 2 4 4-1 5-4 5c-1.2 0-2-1-2-2"/></svg>
          </a>
          <a href="{{ settings.social_tiktok | default: '#' }}" aria-label="TikTok">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M14 4v10a4 4 0 1 1-4-4M14 4c0 3 2 5 5 5"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
