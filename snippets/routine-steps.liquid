{%- comment -%}
  One Routine Placement row: the steps as individual elevated cards, one per
  step, with a faint numeral watermark behind the content — the editorial
  card-grid treatment (see build log entry for the reference this replaced
  the connected-rail version with).
  Accepts: steps — array of "Name (role or note)" strings, already split on the
  arrow separator by the calling section.

  Every class here is namespaced under rplace__ rather than the shorter rstep__.
  sections/ritual-steps.liquid already owns .rstep / .rstep__num, and Shopify
  bundles every section's {% stylesheet %} into one theme-wide sheet, so that
  section's dark-card styling applied here too and hid the step names.

  A short parenthetical (<= 3 words, e.g. "Cleanse") renders as the step's role
  label. A longer one — the Cashmere and Silken layering notes — would squeeze a
  full sentence into a card built for a two-word label, so it drops to a
  footnote under the grid, keyed to the step number, same as before.
{%- endcomment -%}
<div class="rplace__cards">
  {%- for step in steps -%}
    {%- assign bits = step | strip | split: '(' -%}
    {%- assign step_name = bits[0] | strip -%}
    {%- assign step_role = '' -%}
    {%- if bits.size > 1 -%}
      {%- assign step_note = bits[1] | replace: ')', '' | strip -%}
      {%- assign note_words = step_note | split: ' ' -%}
      {%- if note_words.size <= 3 -%}
        {%- assign step_role = step_note -%}
      {%- endif -%}
    {%- endif -%}
    <article class="rplace__card">
      <span class="rplace__ghost" aria-hidden="true">{{ forloop.index }}</span>
      <div class="rplace__card-top">
        <span class="rplace__num" aria-hidden="true">{{ forloop.index }}</span>
        {%- if step_role != blank -%}
          <span class="rplace__role">{{ step_role }}</span>
        {%- endif -%}
      </div>
      <h3 class="rplace__name">{{ step_name }}</h3>
    </article>
  {%- endfor -%}
</div>

{%- assign has_notes = false -%}
{%- for step in steps -%}
  {%- assign bits = step | strip | split: '(' -%}
  {%- if bits.size > 1 -%}
    {%- assign step_note = bits[1] | replace: ')', '' | strip -%}
    {%- assign note_words = step_note | split: ' ' -%}
    {%- if note_words.size > 3 -%}
      {%- if has_notes == false -%}
        <ul class="rplace__notes">
        {%- assign has_notes = true -%}
      {%- endif -%}
      <li><span class="rplace__notes-key">{{ forloop.index }}</span>{{ step_note }}</li>
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- if has_notes -%}</ul>{%- endif -%}
