{%- comment -%}
  One Routine Placement period's steps, as plain numbered rows inside an
  accordion panel (see sections/product-details.liquid for the .racc__item
  wrapper this renders into).
  Accepts: steps — array of "Name (role or note)" strings, already split on the
  arrow separator by the calling section.

  Namespaced racc__ (not rstep__ or rplace__ — both already used and retired
  by earlier versions of this section; see the git history on this file).

  A short parenthetical (<= 3 words, e.g. "Cleanse") renders as the step's role
  label. A longer one — the Cashmere and Silken layering notes — would run on
  past a single row, so it drops to a footnote below the rows, keyed to the
  step number.
{%- endcomment -%}
<div class="racc__rows">
  {%- for step in steps -%}
    {%- assign bits = step | strip | split: '(' -%}
    {%- assign step_name = bits[0] | strip -%}
    {%- assign step_role = '' -%}
    {%- if bits.size > 1 -%}
      {%- assign step_note = bits[1] | replace: ')', '' | strip -%}
      {%- assign note_words = step_note | split: ' ' -%}
      {%- if note_words.size <= 3 -%}
        {%- assign step_role = step_note -%}
      {%- endif -%}
    {%- endif -%}
    <div class="racc__row">
      <span class="racc__num" aria-hidden="true">{{ forloop.index }}</span>
      <span class="racc__name">{{ step_name }}</span>
      {%- if step_role != blank -%}
        <span class="racc__role">{{ step_role }}</span>
      {%- endif -%}
    </div>
  {%- endfor -%}
</div>

{%- assign has_notes = false -%}
{%- for step in steps -%}
  {%- assign bits = step | strip | split: '(' -%}
  {%- if bits.size > 1 -%}
    {%- assign step_note = bits[1] | replace: ')', '' | strip -%}
    {%- assign note_words = step_note | split: ' ' -%}
    {%- if note_words.size > 3 -%}
      {%- if has_notes == false -%}
        <ul class="racc__notes">
        {%- assign has_notes = true -%}
      {%- endif -%}
      <li><span class="racc__notes-key">{{ forloop.index }}</span>{{ step_note }}</li>
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- if has_notes -%}</ul>{%- endif -%}
