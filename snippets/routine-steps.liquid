{%- comment -%}
  One Routine Placement period's steps, as a row of bento-stairs boxes (see
  sections/product-details.liquid for the .rbento-wrap this renders into).
  Accepts: steps — array of "Name (role or note)" strings, already split on the
  arrow separator by the calling section.

  Namespaced rbento__ — the fourth class-naming generation for this section
  (rstep__ collided with sections/ritual-steps.liquid; rplace__ named a
  card-grid concept; racc__ named an accordion concept). Each replaced the
  last as the design changed; see git history for the earlier two.

  A short parenthetical (<= 3 words, e.g. "Cleanse") renders as the step's
  role label. A longer one — the Cashmere and Silken layering notes — has
  nowhere to go inside a bento box sized for a name and a two-word role, so
  it drops to a footnote below the row, keyed to the step number.
{%- endcomment -%}
<div class="rbento">
  {%- for step in steps -%}
    {%- assign bits = step | strip | split: '(' -%}
    {%- assign step_name = bits[0] | strip -%}
    {%- assign step_role = '' -%}
    {%- if bits.size > 1 -%}
      {%- assign step_note = bits[1] | replace: ')', '' | strip -%}
      {%- assign note_words = step_note | split: ' ' -%}
      {%- if note_words.size <= 3 -%}
        {%- assign step_role = step_note -%}
      {%- endif -%}
    {%- endif -%}
    <div class="rbento__box">
      <span class="rbento__ghost" aria-hidden="true">{{ forloop.index }}</span>
      <span class="rbento__num" aria-hidden="true">{{ forloop.index }}</span>
      <span class="rbento__name">{{ step_name }}</span>
      {%- if step_role != blank -%}
        <span class="rbento__role">{{ step_role }}</span>
      {%- endif -%}
    </div>
  {%- endfor -%}
</div>

{%- assign has_notes = false -%}
{%- for step in steps -%}
  {%- assign bits = step | strip | split: '(' -%}
  {%- if bits.size > 1 -%}
    {%- assign step_note = bits[1] | replace: ')', '' | strip -%}
    {%- assign note_words = step_note | split: ' ' -%}
    {%- if note_words.size > 3 -%}
      {%- if has_notes == false -%}
        <ul class="rbento__notes">
        {%- assign has_notes = true -%}
      {%- endif -%}
      <li><span class="rbento__notes-key">{{ forloop.index }}</span>{{ step_note }}</li>
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- if has_notes -%}</ul>{%- endif -%}
