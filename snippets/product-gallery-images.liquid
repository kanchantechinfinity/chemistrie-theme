{%- comment -%}
  Outputs a comma-separated list of theme-asset filenames for a product's
  full marketing gallery (main image + thumbnail strip), or nothing for
  products that don't have one yet. Mirrors product-image-asset.liquid's
  handle/title matching pattern; the first filename in the list is the
  clean product shot already used elsewhere on the site (collection grid,
  homepage), followed by the lifestyle/texture photos, so the gallery
  opens on the familiar bottle shot before showing it in use.

  Falls back cleanly: main-product.liquid only uses this for products
  listed here, everything else keeps the existing single-image display.
{%- endcomment -%}
{%- liquid
  assign _ph = product.handle | downcase
  assign _pt = product.title | downcase
  if _ph contains 'velvet' or _pt contains 'velvet'
    echo 'product-velvet.jpg,gallery-velvet-1.jpg,gallery-velvet-2.jpg,gallery-velvet-3.jpg,gallery-velvet-4.jpg'
  elsif _ph contains 'veil' or _pt contains 'veil'
    echo 'product-veil.jpg,gallery-veil-1.jpg,gallery-veil-2.jpg,gallery-veil-3.jpg,gallery-veil-4.jpg'
  elsif _ph contains 'cashmere' or _pt contains 'cashmere'
    echo 'product-cashmere.jpg,gallery-cashmere-1.jpg,gallery-cashmere-2.jpg,gallery-cashmere-3.jpg,gallery-cashmere-4.jpg'
  elsif _ph contains 'aura' or _pt contains 'aura'
    echo 'product-aura.jpg,gallery-aura-1.jpg,gallery-aura-2.jpg,gallery-aura-3.jpg,gallery-aura-4.jpg'
  elsif _ph contains 'silken' or _pt contains 'silken'
    echo 'product-silken.jpg,gallery-silken-1.jpg,gallery-silken-2.jpg,gallery-silken-3.jpg,gallery-silken-4.jpg'
  endif
-%}
